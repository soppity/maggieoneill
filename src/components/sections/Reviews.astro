---
// Three Google reviews for the page's sector. First name and organisation only.
import { reviews as reviewFacts } from '../../data/facts';

interface Review {
  quote: string;
  name: string;
  org?: string;
}
interface Props {
  reviews: Review[];
  heading?: string;
}
const { reviews, heading = 'What do people say about Maggie’s?' } = Astro.props;
---
<section class="section" aria-labelledby="reviews-heading">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Reviews</span>
      <h2 id="reviews-heading">{heading}</h2>
      <p>Most of our {reviewFacts.count} Google reviews mention the welcome.</p>
    </div>
    <div class="grid reviews">
      {reviews.map((r) => (
        <figure class="card reviews__card">
          <svg class="reviews__g" aria-hidden="true" width="24" height="24" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.5 5.5 0 0 1-2.4 3.6v3h3.8c2.3-2.1 3.6-5.2 3.6-8.7z" /><path fill="#34A853" d="M12 24c3.2 0 6-1.1 7.9-2.9l-3.8-3c-1.1.7-2.4 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.4v3.1A12 12 0 0 0 12 24z" /><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.4a12 12 0 0 0 0 10.8z" /><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.4 6.6l3.9 3.1c.9-2.9 3.6-4.9 6.7-4.9z" /></svg>
          <blockquote>“{r.quote}”</blockquote>
          <figcaption>{r.name}{r.org && <span>, {r.org}</span>}</figcaption>
        </figure>
      ))}
    </div>
    <p class="reviews__more"><a href="/reviews/">Read all {reviewFacts.count} Google reviews</a></p>
  </div>
</section>

<style>
  .reviews { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .reviews__card { margin: 0; padding: 28px; display: flex; flex-direction: column; gap: 16px; }
  .reviews__card blockquote { margin: 0; font: 600 19px/1.45 var(--font-display); color: var(--moc-purple-900); letter-spacing: -0.01em; }
  .reviews__card figcaption { margin-top: auto; font-weight: 700; font-size: var(--text-small-size); }
  .reviews__card figcaption span { font-weight: 500; color: var(--moc-slate-text); }
  .reviews__more { margin-top: 24px; font-weight: 700; }
  @media (max-width: 900px) { .reviews { grid-template-columns: 1fr; } }
</style>
