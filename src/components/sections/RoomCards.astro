---
// Every bookable room with its published rates. Genesis is never listed. No capacity grid:
// room names and prices only.
import Photo from '../Photo.astro';
import { booking, formatPrice, rooms, type Room } from '../../data/facts';

interface Props {
  heading?: string;
  intro?: string;
  order?: string[];
  // Names and photos only, no prices. Room descriptions are never shown, so bookers aren't steered to one room.
  simple?: boolean;
  // Owner, Oct 2026: big, complex bookings (NHS, Oliver McGowan, events, conferences) get "Get in touch", not the calendar.
  enquire?: boolean;
}
const {
  heading = 'Which training rooms can you hire?',
  intro = 'Every room is hosted and set to your layout. Meeting and training rooms have a screen with Mac and PC wireless casting and HDMI. The Auditorium has a stage, a sound system, and screens and sound run by a technician. Prices include everything on the Hosted Day list.',
  order = ['summit', 'forum', 'community-room', 'foundry', 'hub', 'grove', 'auditorium', 'pod'],
  simple = false,
  enquire = false,
} = Astro.props;

const list = order.map((slug) => rooms.find((r) => r.slug === slug)).filter(Boolean) as Room[];
const priceLine = (r: Room) =>
  r.prices?.day
    ? `${formatPrice(r.prices.hour!)} an hour or ${formatPrice(r.prices.day)} a day`
    : r.prices?.hourFrom
      ? `From ${formatPrice(r.prices.hourFrom)} an hour`
      : 'Price on request';
---
<section class="section section--cream" id="rooms" aria-labelledby="rooms-heading">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{simple ? 'Rooms' : 'Rooms and prices'}</span>
      <h2 id="rooms-heading">{heading}</h2>
      <p>{intro}</p>
    </div>
    <ul class="grid room-cards">
      {list.map((r) => (
        <li class="card room-card">
          <Photo n={r.image} width={640} height={400} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 380px" />
          <div class="room-card__body">
            <h3>The {r.name}</h3>
            <p class="room-card__floor">{r.floor === 'ground' ? 'Ground floor' : 'First floor, stairs only'}</p>
            {!simple && (
              <>
                <p class="room-card__price">{priceLine(r)}</p>
              </>
            )}
            {r.note && <p class="room-card__note">{r.note}</p>}
          </div>
        </li>
      ))}
    </ul>
    <div class="room-cards__foot">
      <p>Not sure which room? Tell us your numbers and we'll pick one for you. <a href="/whats-included/">See everything that's included</a></p>
      {enquire ? (
        <a class="btn btn--primary" href="#enquire" data-track="contact_click">Get in touch</a>
      ) : (
        <a class="btn btn--primary" href={booking.url} target="_blank" rel="noopener" data-track="booking_click">Check availability</a>
      )}
    </div>
  </div>
</section>

<style>
  .room-card__note { margin: 8px 0 0; font-size: var(--text-caption-size); line-height: 1.45; color: var(--moc-slate-text); }
  .room-card__floor { font-size: var(--text-caption-size); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--moc-slate-text); margin: 2px 0 0; }
  .room-cards { list-style: none; margin: 0; padding: 0; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .room-card { display: flex; flex-direction: column; overflow: hidden; }
  .room-card :global(img) { aspect-ratio: 8 / 5; height: auto; }
  .room-card__body { padding: 18px 20px 22px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
  .room-card h3 { font-size: 20px; }
  .room-card__price { font-weight: 700; color: var(--moc-purple-900); }
  .room-cards__foot { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  @media (max-width: 1100px) { .room-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .room-cards { grid-template-columns: 1fr; } }
</style>
