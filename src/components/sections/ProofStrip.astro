---
import { parking, reviews } from '../../data/facts';

const items = [
  { icon: 'star', text: `${reviews.count} Google reviews`, href: '/reviews/' },
  { icon: 'car', text: 'Free parking' },
  { icon: 'cup', text: 'Tea in the room' },
  { icon: 'road', text: parking.motorway.charAt(0).toUpperCase() + parking.motorway.slice(1) },
];
---
<ul class="proof-strip">
  {items.map((i) => (
    <li>
      {i.icon === 'star' && <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="#F0A81C" d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" /></svg>}
      {i.icon === 'car' && <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M5 16h14M6.5 16l1.6-5.2A2 2 0 0 1 10 9.4h4a2 2 0 0 1 1.9 1.4L17.5 16M5 16v3h2.5v-3M16.5 16v3H19v-3" /></svg>}
      {i.icon === 'cup' && <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5zM16 10h1.5a2.5 2.5 0 0 1 0 5H16M8 3v3M12 3v3" /></svg>}
      {i.icon === 'road' && <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M8 3 5 21M16 3l3 18M12 4v3M12 11v3M12 18v2" /></svg>}
      {i.href ? <a href={i.href}>{i.text}</a> : <span>{i.text}</span>}
    </li>
  ))}
</ul>

<style>
  .proof-strip {
    list-style: none; margin: 28px 0 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: 10px 22px;
    font-size: var(--text-small-size); font-weight: 600; color: var(--moc-purple-900);
  }
  .proof-strip li { display: inline-flex; align-items: center; gap: 8px; }
  .proof-strip svg { color: var(--moc-coral-500); flex: none; }
  .proof-strip a { color: inherit; }
</style>
