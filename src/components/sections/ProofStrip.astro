---
// The value stack under the hero on room hire pages (owner, Oct 2026: "we've sold lots of rooms by value stacking").
// Not used on the events and conference pages. Every item must stay true for every room.
import { parking, reviews } from '../../data/facts';

const items = [
  { icon: 'star', text: `${reviews.count} Google reviews`, href: '/reviews/' },
  { icon: 'cup', text: 'Unlimited tea and coffee with every booking' },
  { icon: 'screen', text: 'LED flatscreens in every room' },
  { icon: 'car', text: `Free on-site parking (${parking.spaces} spaces)` },
  { icon: 'pen', text: 'Flipcharts, paper and pens in every room' },
  { icon: 'host', text: 'Hosts on site all day' },
  { icon: 'bus', text: 'On a main bus route' },
  { icon: 'road', text: parking.motorway.charAt(0).toUpperCase() + parking.motorway.slice(1) },
];
const paths: Record<string, string> = {
  cup: 'M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5zM16 10h1.5a2.5 2.5 0 0 1 0 5H16M8 3v3M12 3v3',
  screen: 'M3 5h18v11H3zM8 20h8M12 16v4',
  car: 'M5 16h14M6.5 16l1.6-5.2A2 2 0 0 1 10 9.4h4a2 2 0 0 1 1.9 1.4L17.5 16M5 16v3h2.5v-3M16.5 16v3H19v-3',
  pen: 'M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4',
  host: 'M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4 21a8 8 0 0 1 16 0',
  bus: 'M6 17V6a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v11zM6 12h12M8 17v3M16 17v3M9 14.5h.01M15 14.5h.01',
  road: 'M8 3 5 21M16 3l3 18M12 4v3M12 11v3M12 18v2',
};
---
<ul class="proof-strip">
  {items.map((i) => (
    <li>
      <span class="proof-strip__icon" aria-hidden="true">
        {i.icon === 'star' ? (
          <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#F0A81C" d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" /></svg>
        ) : (
          <svg width="18" height="18" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d={paths[i.icon]} /></svg>
        )}
      </span>
      {i.href ? <a href={i.href}>{i.text}</a> : <span>{i.text}</span>}
    </li>
  ))}
</ul>

<style>
  .proof-strip {
    list-style: none; margin: 28px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 18px;
    font-size: var(--text-small-size); font-weight: 600; line-height: 1.3; color: var(--moc-purple-900);
  }
  .proof-strip li { display: flex; align-items: center; gap: 10px; }
  .proof-strip__icon { flex: none; width: 34px; height: 34px; display: grid; place-items: center; border-radius: 50%; background: var(--moc-coral-tint); color: var(--moc-coral-text); }
  .proof-strip a { color: inherit; }
  @media (max-width: 480px) { .proof-strip { grid-template-columns: 1fr; gap: 8px; } }
</style>
