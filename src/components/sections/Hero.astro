---
// The H1 is the page's SEO title, in display type (owner, Oct 2026: H1s carry the keyword, never the brand line).
// The brand message sits under it as a tagline, outside the heading.
import Photo from '../Photo.astro';
import { booking } from '../../data/facts';

interface Props {
  title: string;
  tagline?: string;
  lede: string;
  image: number;
  imageAlt?: string;
  // Defaults to "Check availability" (the OfficeRnD calendar).
  primary?: { label: string; href: string; track?: string };
  secondary?: { label: string; href: string };
}
const { title, tagline, lede, image, imageAlt, primary, secondary } = Astro.props;
---
<section class="hero">
  <div class="container hero__inner">
    <div class="hero__copy">
      <h1>{title}</h1>
      {tagline && <p class="hero__tagline">{tagline}</p>}
      <p class="hero__lede">{lede}</p>
      <div class="hero__ctas">
        {primary ? (
          <a class="btn btn--primary" href={primary.href} data-track={primary.track}>{primary.label}</a>
        ) : (
          <a class="btn btn--primary" href={booking.url} target="_blank" rel="noopener" data-track="booking_click">Check availability</a>
        )}
        {secondary && <a class="btn btn--secondary" href={secondary.href}>{secondary.label}</a>}
      </div>
      <slot />
    </div>
    <div class="hero__media">
      <Photo n={image} alt={imageAlt} width={1200} height={1000} priority sizes="(max-width: 900px) 100vw, 560px" />
      <svg class="hero__line" aria-hidden="true" viewBox="0 0 400 40" preserveAspectRatio="none"><path d="M4 30C110 6 290 6 396 30" fill="none" stroke="#F0603A" stroke-width="8" stroke-linecap="round" /></svg>
    </div>
  </div>
</section>

<style>
  .hero { background: var(--moc-hero-wash); padding: clamp(40px, 7vw, 88px) 0 clamp(40px, 6vw, 72px); }
  .hero__inner { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
  .hero h1 {
    font-size: clamp(38px, 5.4vw, 64px); font-weight: var(--text-hero-weight);
    line-height: 1.05; color: var(--moc-purple-900);
  }
  .hero__tagline { margin-top: 16px; font: 700 clamp(21px, 2.3vw, 28px)/1.25 var(--font-display); color: var(--moc-coral-text); letter-spacing: -0.01em; }
  .hero__lede { margin-top: 22px; font-size: clamp(18px, 1.8vw, var(--text-lead-size)); line-height: 1.55; max-width: 560px; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
  .hero__media { position: relative; }
  .hero__media :global(img) { aspect-ratio: 6 / 5; border-radius: var(--radius-card); box-shadow: var(--moc-shadow-card-hover); }
  .hero__line { position: absolute; left: 10%; right: 10%; bottom: -26px; width: 80%; height: 30px; }
  @media (max-width: 900px) {
    .hero__inner { grid-template-columns: 1fr; }
    .hero__media { order: -1; }
    .hero__media :global(img) { aspect-ratio: 16 / 10; }
    .hero__line { display: none; }
  }
</style>
