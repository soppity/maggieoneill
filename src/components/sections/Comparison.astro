---
// Community hall vs Maggie's vs hotel, 9 rows (Brand Strategy 03). Competitors are never named.
import { parking } from '../../data/facts';

const rows = [
  ['Who looks after you', 'A key in a lockbox, or a caretaker', 'On-site hosts, all day', 'Reception, busy with check-ins'],
  ['Room set-up', 'You move the tables', 'Set to your layout before you arrive', 'Set up, often by agency staff'],
  ['Tech', 'Bring your own projector', 'Screens with Mac and PC wireless casting, HDMI cables and 1Gb fibre WiFi, all tested', 'Available, often charged extra'],
  ['Tea and coffee', 'Bring your own', 'In the room, all day, included', 'Timed breaks, charged per delegate'],
  ['Parking', 'Street parking, if you are lucky', `Free ${parking.spaces}-space car park outside, M57 30 seconds away`, 'Paid, or limited'],
  ['Feel', 'Tired, sometimes damp', 'Calm, spotless and beautifully designed, with oil diffusers filling the air with a lovely scent', 'Corporate and anonymous'],
  ['Built for', 'Everything at once', 'Training and meetings. It is the whole job.', 'Bedrooms. Room hire is a sideline.'],
  ['Price', 'Cheap, you do the work', 'Honest day rates, everything included', 'Premium, to cover the hotel'],
  ['Where the money goes', 'Building upkeep', "Maggie's Meals and Knowsley community support", 'Shareholders'],
];
const cols = ['Community hall', "Maggie's", 'Hotel'];
---
<section class="section section--cream" aria-labelledby="compare-heading">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Hall vs Maggie's vs hotel</span>
      <h2 id="compare-heading">How does Maggie's compare with a hall or a hotel?</h2>
      <p>A community hall leaves the work to you. A hotel fits room hire around its bedrooms. Maggie's is a hosted venue: rooms are the whole job.</p>
    </div>
    <table class="compare">
      <caption class="visually-hidden">How a community hall, the Maggie O'Neill Centre and a hotel compare for training and meeting room hire</caption>
      <thead>
        <tr>
          <td></td>
          {cols.map((c, i) => <th scope="col" class:list={{ 'is-us': i === 1 }}>{c}</th>)}
        </tr>
      </thead>
      <tbody>
        {rows.map(([label, ...cells]) => (
          <tr>
            <th scope="row">{label}</th>
            {cells.map((c, i) => <td class:list={{ 'is-us': i === 1 }} data-label={cols[i]}>{c}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="compare__more"><a href="/whats-included/">See everything that's included</a></p>
  </div>
</section>

<style>
  .compare { width: 100%; border-collapse: separate; border-spacing: 0; background: var(--moc-white); border-radius: var(--radius-card); box-shadow: var(--moc-shadow-card); overflow: hidden; font-size: var(--text-small-size); }
  .compare th, .compare td { padding: 16px 20px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--moc-border); }
  .compare tbody tr:last-child > * { border-bottom: 0; }
  .compare thead th { font: 700 18px/1.2 var(--font-display); color: var(--moc-purple-900); }
  .compare tbody th { font-weight: 700; color: var(--moc-purple-900); width: 20%; }
  .compare td { color: var(--moc-slate-text); width: 26.6%; }
  .compare .is-us { background: var(--moc-purple-tint); color: var(--moc-ink); font-weight: 600; }
  .compare thead .is-us { background: var(--moc-purple-700); color: var(--moc-white); }
  .compare__more { margin-top: 24px; font-weight: 700; }
  @media (max-width: 760px) {
    .compare, .compare tbody, .compare tr, .compare th, .compare td { display: block; width: 100%; }
    .compare thead { display: none; }
    .compare tbody tr { border-bottom: 1px solid var(--moc-border); padding: 8px 0; }
    .compare tbody tr:last-child { border-bottom: 0; }
    .compare th, .compare td { border-bottom: 0; padding: 6px 20px; }
    .compare tbody th { padding-top: 14px; font-size: 16px; }
    .compare td::before { content: attr(data-label) ': '; font-weight: 700; color: var(--moc-purple-900); }
    .compare .is-us { margin: 4px 0; }
  }
</style>
