---
// Numbered steps (sign-up, what happens to a call). The heading should be a question (SEO spec 3.2).
interface Props {
  id: string;
  eyebrow: string;
  heading: string;
  intro: string;
  steps: { title: string; text: string }[];
  tone?: 'white' | 'page' | 'cream';
}
const { id, eyebrow, heading, intro, steps, tone = 'page' } = Astro.props;
---
<section class:list={['section', { 'section--white': tone === 'white', 'section--cream': tone === 'cream' }]} aria-labelledby={id}>
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">{eyebrow}</span>
      <h2 id={id}>{heading}</h2>
      <p>{intro}</p>
    </div>
    <ol class="steps" style={`--cols:${Math.min(steps.length, 5)}`}>
      {steps.map((s, i) => (
        <li>
          <span class="steps__n" aria-hidden="true">{i + 1}</span>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
    <slot />
  </div>
</section>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); gap: var(--grid-gap); counter-reset: none; }
  .steps li { position: relative; display: flex; flex-direction: column; gap: 8px; padding-top: 4px; }
  .steps__n {
    width: 44px; height: 44px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
    background: var(--moc-purple-700); color: var(--moc-white); font: 800 20px/1 var(--font-display); margin-bottom: 8px;
  }
  .steps h3 { font-size: 19px; }
  .steps p { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  @media (max-width: 900px) { .steps { grid-template-columns: 1fr; gap: 20px; } .steps li { display: grid; grid-template-columns: 44px 1fr; column-gap: 16px; } .steps__n { grid-row: span 2; margin: 0; } }
</style>
