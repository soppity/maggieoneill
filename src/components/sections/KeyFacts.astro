---
// Answer-first opening paragraph, then the key facts in their own section below it (SEO spec 3.2, points 2 and 3).
// Owner, Oct 2026: the facts grid gets its own section, as bright, easy-to-scan cards with an icon each.
interface Props {
  heading: string;
  intro: string;
  // Extra paragraphs under the answer-first intro (homepage: virtual offices get their own).
  more?: string[];
  facts: { term: string; detail: string; href?: string; linkText?: string }[];
  // Heading over the facts cards.
  factsHeading?: string;
}
const { heading, intro, more = [], facts, factsHeading = 'The quick facts' } = Astro.props;

// One simple line icon per fact, picked from the label. Paths are 24x24, stroke only.
const ICONS: [RegExp, string][] = [
  [/park|getting here|arriv/i, '<rect x="4" y="3" width="16" height="18" rx="3"/><path d="M10 17V8h3a3 3 0 0 1 0 6h-3"/>'],
  [/access|toilet|quiet/i, '<circle cx="12" cy="4.5" r="1.8"/><path d="M8 9h8M12 9v5l-3 6M12 14l3 6"/>'],
  [/price|cost|fee|paid|rate|£/i, '<path d="M16 7.5A4 4 0 0 0 9 10v8M7 13h6M7 18h10"/>'],
  [/hour|time|evening|weekend|availab|how often|every month|since|term|months|notice|contract|rolling|flexible|repeat|cancel/i, '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>'],
  [/where|address|boroughs/i, '<path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>'],
  [/tech|av|light|stage/i, '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>'],
  [/tea|refresh|cater/i, '<path d="M4 8h12v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8zM16 10h1.5a2.5 2.5 0 0 1 0 5H16M8 3v2M12 3v2"/>'],
  [/host|who|team|answers|with us|delegates|group|capacity|sizes|operators/i, '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M15.5 14.5A5 5 0 0 1 21 19"/>'],
  [/post|mail|deliver|email|virtual office|director/i, '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>'],
  [/phone|call/i, '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/>'],
  [/invoic|funding|social value|record|planning|exit|lease/i, '<path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5M10 13h6M10 17h6"/>'],
  [/room|layout|set-up|setup|breakout|auditorium|furnish|space|meeting/i, '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18M12 3v18"/>'],
];
const DEFAULT_ICON = '<path d="M20 6 9 17l-5-5"/>';
const iconFor = (term: string) => ICONS.find(([re]) => re.test(term))?.[1] ?? DEFAULT_ICON;
const id = `kf-${heading.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---
<section class="section section--white key-facts" aria-labelledby={id}>
  <div class="container key-facts__intro">
    <h2 id={id}>{heading}</h2>
    <p>{intro}</p>
    {more.map((m) => <p>{m}</p>)}
  </div>
</section>

<section class="section key-facts-grid" aria-labelledby={`${id}-facts`}>
  <div class="container">
    <div class="section-head section-head--center">
      <span class="eyebrow">At a glance</span>
      <h2 id={`${id}-facts`}>{factsHeading}</h2>
    </div>
    <dl class="kf-cards">
      {facts.map((f, i) => (
        <div class={`kf-card kf-card--t${i % 3}`}>
          <span class="kf-card__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={iconFor(f.term)} />
          </span>
          <dt>{f.term}</dt>
          <dd>
            {f.detail}
            {f.href && <a class="kf-card__link" href={f.href}>{f.linkText} <span aria-hidden="true">→</span></a>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .key-facts__intro { max-width: 820px; display: flex; flex-direction: column; gap: 18px; }
  .key-facts__intro p { font-size: clamp(19px, 1.8vw, 22px); line-height: 1.6; }

  .key-facts-grid { background: var(--moc-band-gradient); }
  .key-facts-grid .section-head h2 { color: var(--moc-white); }
  .key-facts-grid .eyebrow { color: var(--moc-coral-400); }

  .kf-cards { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: clamp(14px, 2vw, 22px); }
  .kf-card {
    --kf-tint: var(--moc-purple-tint); --kf-ink: var(--moc-purple-700);
    display: flex; flex-direction: column; gap: 10px; padding: clamp(22px, 2.6vw, 28px);
    background: var(--moc-white); border-radius: var(--radius-card); box-shadow: 0 10px 30px rgba(20, 0, 50, 0.25);
    transition: transform var(--duration-base, 200ms) var(--ease-out);
  }
  .kf-card:hover { transform: translateY(-4px); }
  .kf-card--t1 { --kf-tint: var(--moc-coral-tint); --kf-ink: var(--moc-coral-text); }
  .kf-card--t2 { --kf-tint: var(--moc-beige); --kf-ink: var(--moc-purple-900); }
  .kf-card__icon { width: 52px; height: 52px; display: grid; place-items: center; border-radius: 16px; background: var(--kf-tint); color: var(--kf-ink); }
  .kf-card dt { font: 800 22px/1.15 var(--font-display); color: var(--moc-purple-900); }
  .kf-card dd { margin: 0; font-size: 18px; line-height: 1.55; color: var(--moc-ink); }
  .kf-card__link { display: inline-block; margin-top: 8px; font-weight: 700; }
  @media (max-width: 560px) {
    .kf-cards { grid-template-columns: 1fr; }
    .kf-card { flex-direction: row; flex-wrap: wrap; align-items: center; column-gap: 14px; }
    .kf-card__icon { width: 44px; height: 44px; border-radius: 14px; }
    .kf-card dd { flex-basis: 100%; }
  }
  @media (prefers-reduced-motion: reduce) { .kf-card:hover { transform: none; } }
</style>
