---
// The closer: just before the final call to action, never the headline.
import Photo from '../Photo.astro';
import { lastYear, maggiesMeals, site } from '../../data/facts';

const stats = [
  { value: lastYear.roomsHired, label: 'rooms hired' },
  { value: lastYear.businessesServed, label: 'businesses served' },
  { value: lastYear.mealsAccessed, label: "people accessed Maggie's Meals" },
];
---
<section class="meals" aria-labelledby="meals-heading">
  <div class="container meals__inner">
    <div class="meals__copy">
      <h2 id="meals-heading">{site.closer}</h2>
      <p>Maggie O'Neill Centre is a registered charity (no. {site.charityNumber}). What you pay for your room funds Maggie's Meals and community support in Knowsley. Maggie's Meals runs here {maggiesMeals.schedule.charAt(0).toLowerCase() + maggiesMeals.schedule.slice(1)}.</p>
      <p class="meals__label">In the last year</p>
      <dl class="meals__stats">
        {stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
      <a class="meals__link" href="/community/">About Maggie's Meals and our community work</a>
    </div>
    <div class="meals__media">
      <Photo n={110} width={720} height={540} sizes="(max-width: 900px) 100vw, 480px" />
    </div>
  </div>
</section>

<style>
  .meals { background: var(--moc-purple-700); color: var(--moc-white); padding: clamp(56px, 8vw, 88px) 0; }
  .meals__inner { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(32px, 5vw, 64px); align-items: center; }
  .meals h2 { color: var(--moc-white); }
  .meals__copy > p { margin-top: 16px; color: rgba(255, 255, 255, 0.9); max-width: 600px; }
  .meals__label { margin-top: 32px !important; font-size: var(--text-eyebrow-size); font-weight: 600; letter-spacing: var(--text-eyebrow-tracking); text-transform: uppercase; color: var(--moc-purple-tint-2) !important; }
  .meals__stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 12px 0 0; }
  .meals__stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 6px; }
  .meals__stats dd { margin: 0; font: 800 clamp(40px, 6vw, var(--text-stat-size))/1 var(--font-display); color: var(--moc-white); letter-spacing: -0.02em; }
  .meals__stats dt { font-size: var(--text-small-size); color: rgba(255, 255, 255, 0.9); }
  .meals__link { display: inline-block; margin-top: 28px; color: var(--moc-white); font-weight: 700; }
  .meals__link:hover { color: var(--moc-purple-tint-2); }
  .meals__media :global(img) { aspect-ratio: 4 / 3; border-radius: var(--radius-card); }
  @media (max-width: 900px) { .meals__inner { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .meals__stats { grid-template-columns: 1fr; } }
</style>
