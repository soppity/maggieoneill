---
import Photo from '../Photo.astro';

const cards = [
  {
    sector: 'Care providers',
    line: 'Mandatory training, in rooms built for it.',
    detail: 'TMVA, safety intervention, hoist training, medication and first aid for your support workers.',
    href: '/services/training-rooms/care-training-venue/',
    linkText: 'Care training venue',
    image: 43,
  },
  {
    sector: 'NHS and primary care',
    line: 'Your clinical and admin teams, trained close to home.',
    detail: 'Training days and monthly team meetings for trusts and primary care networks.',
    href: '/services/training-rooms/nhs-training-venue/',
    linkText: 'NHS training venue',
    image: 67,
  },
  {
    sector: 'Councils, schools and public sector',
    line: 'Train in the borough, and the spend stays local.',
    detail: "Training, CPD and INSET days in Knowsley. Every booking funds Maggie's Meals.",
    href: '/services/training-rooms/council-training-venue/',
    linkText: 'Council training in Knowsley',
    image: 114,
  },
  {
    sector: 'Everyone else',
    line: 'Your trainer teaches. We handle the rest.',
    detail: 'Training companies, charities and local businesses, from a meeting for 4 to a conference.',
    href: '/services/training-rooms/',
    linkText: 'Training room hire',
    image: 85,
  },
];
---
<section class="section" aria-labelledby="who-books-heading">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Who books with us</span>
      <h2 id="who-books-heading">Who books training rooms at Maggie's?</h2>
      <p>Care providers, NHS teams, Knowsley Council, schools, and fostering and adoption teams all train here.</p>
    </div>
    <div class="grid who-books">
      {cards.map((c) => (
        <a class="card who-books__card" href={c.href}>
          <Photo n={c.image} width={600} height={360} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 290px" />
          <div class="who-books__body">
            <span class="who-books__sector">{c.sector}</span>
            <h3>{c.line}</h3>
            <p>{c.detail}</p>
            <span class="who-books__link">{c.linkText} <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
    <p class="who-books__more">
      We also host: <a href="/services/training-rooms/oliver-mcgowan-training-venue/">Oliver McGowan training venue</a>{' and '}<a href="/services/training-rooms/fostering-adoption-training-venue/">fostering and adoption training venue</a>.
    </p>
  </div>
</section>

<style>
  .who-books { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .who-books__card { display: flex; flex-direction: column; overflow: hidden; }
  .who-books__card :global(img) { aspect-ratio: 5 / 3; height: auto; }
  .who-books__body { display: flex; flex-direction: column; gap: 10px; padding: 22px 24px 26px; flex: 1; }
  .who-books__sector { font-size: var(--text-caption-size); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--moc-coral-text); }
  .who-books__body p { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  .who-books__link { margin-top: auto; padding-top: 6px; font-weight: 700; color: var(--moc-purple-700); }
  .who-books__more { margin-top: 28px; font-size: var(--text-small-size); }
  @media (max-width: 1100px) { .who-books { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .who-books { grid-template-columns: 1fr; } }
</style>
