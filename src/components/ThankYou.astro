---
// Thank-you page body (owner, Oct 2026: a thank-you page for every form, for conversion tracking).
// Each page is noindex and out of the sitemap. On load it pushes `form_thank_you` with the form name to the dataLayer,
// so GA4 (through GTM) can count conversions by thank-you page view or by event.
import { contact } from '../data/facts';

interface Props {
  form: string;
  eyebrow?: string;
  heading: string;
  text: string;
  next?: { title: string; text: string }[];
  links?: { label: string; href: string }[];
  showWhatsApp?: boolean;
}
const { form, eyebrow = 'Thank you', heading, text, next = [], links = [], showWhatsApp = true } = Astro.props;
---
<section class="section ty" data-thank-you={form}>
  <div class="container ty__inner">
    <span class="ty__tick" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
    </span>
    <span class="eyebrow">{eyebrow}</span>
    <h1>{heading}</h1>
    <p class="ty__lede">{text}</p>
    {next.length > 0 && (
      <ol class="ty__next">
        {next.map((n) => <li><strong>{n.title}</strong><span>{n.text}</span></li>)}
      </ol>
    )}
    <p class="ty__talk">
      Need us sooner? Call <a href={contact.phoneHref} data-track="phone_click">{contact.phone}</a>
      {showWhatsApp && <> or WhatsApp <a href={contact.whatsappHref} rel="noopener" data-track="whatsapp_click">{contact.text}</a></>}.
    </p>
    {links.length > 0 && (
      <p class="ty__links">{links.map((l, i) => <><a class={i === 0 ? 'btn btn--primary' : 'btn btn--secondary'} href={l.href}>{l.label}</a>{' '}</>)}</p>
    )}
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('[data-thank-you]');
  const w = window as unknown as { dataLayer?: Record<string, unknown>[] };
  if (el) (w.dataLayer = w.dataLayer || []).push({ event: 'form_thank_you', form_name: el.dataset.thankYou });
</script>

<style>
  .ty { background: var(--moc-hero-wash); min-height: 60vh; }
  .ty__inner { max-width: 760px; display: flex; flex-direction: column; gap: 16px; }
  .ty__tick { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--moc-coral-500); color: var(--moc-purple-900); }
  .ty h1 { font-size: clamp(34px, 4.6vw, 52px); line-height: 1.08; }
  .ty__lede { font-size: var(--text-lead-size); }
  .ty__next { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 12px; counter-reset: ty; }
  .ty__next li { counter-increment: ty; display: grid; grid-template-columns: 36px 1fr; column-gap: 14px; row-gap: 2px; padding: 16px 18px; background: var(--moc-white); border-radius: var(--radius-card); box-shadow: var(--moc-shadow-card); }
  .ty__next li::before { content: counter(ty); grid-row: span 2; display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; background: var(--moc-purple-tint); color: var(--moc-purple-700); font: 800 16px/1 var(--font-display); }
  .ty__next strong { color: var(--moc-purple-900); }
  .ty__talk { font-weight: 600; }
  .ty__links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
</style>
