---
import { address, contact, hours, reviews, site } from '../data/facts';
import { footerColumns } from '../data/nav';

const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <img src="/logo/mobtc-logo-horizontal-reversed.svg" alt="Maggie O'Neill Centre logo" width="1430" height="304" loading="lazy" />
        <p class="site-footer__signoff">{site.brandLine}</p>
        <address class="site-footer__nap">
          <strong>{site.name}</strong><br />
          {address.street}, {address.locality}, {address.city}, {address.postcode}<br />
          Phone <a href={contact.phoneHref} data-track="phone_click">{contact.phone}</a><br />
          Text or WhatsApp <a href={contact.whatsappHref} data-track="whatsapp_click" rel="noopener">{contact.text}</a>
          {contact.email && <><br /><a href={`mailto:${contact.email}`} data-track="email_click">{contact.email}</a></>}
        </address>
        <p class="site-footer__hours">Open {hours.summary}. {hours.extra}</p>
        <a class="site-footer__reviews" href="/reviews/">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24"><path fill="#F0A81C" d="m12 2.5 2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" /></svg>
          <span>{reviews.count} Google reviews</span>
        </a>
      </div>
      {footerColumns.map((col) => (
        <nav class="site-footer__col" aria-label={col.title}>
          <h2>{col.title}</h2>
          <ul>
            {col.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <div class="site-footer__bottom">
      <p>Registered charity no. {site.charityNumber}. {site.closer}</p>
      <ul>
        <li><a href="/booking-terms/">Booking terms</a></li>
        <li><a href="/privacy/">Privacy</a></li>
        <li><a href="/cookies/">Cookies</a></li>
        <li><a href="/cookies/" data-cookie-settings>Cookie settings</a></li>
        <li><a href="/terms/">Terms</a></li>
      </ul>
      <p>© {year} {site.name}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--moc-purple-900); color: rgba(255, 255, 255, 0.86); padding: 72px 0 32px; font-size: 15px; }
  .site-footer a { color: var(--moc-white); text-decoration: none; }
  .site-footer a:hover { text-decoration: underline; color: var(--moc-white); }
  .site-footer__top { display: grid; grid-template-columns: 1.6fr repeat(4, 1fr); gap: 40px; }
  .site-footer__brand img { width: 220px; height: auto; }
  .site-footer__signoff { margin: 18px 0 20px; font: 700 20px/1.3 var(--font-display); color: var(--moc-white); }
  .site-footer__nap { font-style: normal; line-height: 1.7; }
  .site-footer__nap a { text-decoration: underline; text-decoration-color: rgba(255, 255, 255, 0.4); }
  .site-footer__hours { margin-top: 12px; }
  .site-footer__reviews {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 18px; padding: 8px 14px;
    background: rgba(255, 255, 255, 0.1); border-radius: var(--radius-pill); font-weight: 600;
  }
  .site-footer__col h2 { font: 700 15px/1.2 var(--font-body); letter-spacing: 0.06em; text-transform: uppercase; color: var(--moc-white); margin-bottom: 14px; }
  .site-footer__col ul, .site-footer__bottom ul { list-style: none; margin: 0; padding: 0; }
  .site-footer__col li { margin-bottom: 4px; }
  .site-footer__col a { display: inline-block; padding: 6px 0; color: rgba(255, 255, 255, 0.86); }
  .site-footer__bottom {
    margin-top: 56px; padding-top: 24px; border-top: 1px solid rgba(255, 255, 255, 0.16);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px 24px; font-size: 14px;
  }
  .site-footer__bottom ul { display: flex; gap: 20px; }
  @media (max-width: 1000px) {
    .site-footer__top { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 960px) { .site-footer { padding-bottom: 104px; } }
  @media (max-width: 520px) { .site-footer__top { grid-template-columns: 1fr; } }
</style>
