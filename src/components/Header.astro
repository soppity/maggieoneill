---
import { booking, contact } from '../data/facts';
import { mainNav } from '../data/nav';

const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__logo" aria-label="Maggie O'Neill Centre home">
      <img class="logo-full" src="/logo/mobtc-logo-horizontal.svg" alt="Maggie O'Neill Centre logo" width="1430" height="304" />
      <img class="logo-icon" src="/logo/mobtc-logo-icon.svg" alt="Maggie O'Neill Centre logo" width="482" height="342" />
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Main">
      <ul class="site-nav__list">
        {mainNav.map((item) => (
          <li class={`site-nav__item${item.children ? ' has-children' : ''}`}>
            {item.children ? (
              <>
                <button class="site-nav__toggle" type="button" aria-expanded="false">
                  {item.label}
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </button>
                <ul class="site-nav__sub">
                  {item.children.map((c) => (
                    <li><a href={c.href} aria-current={current === c.href ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </>
            ) : (
              <a class="site-nav__link" href={item.href} aria-current={current === item.href ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
      <a class="site-nav__phone-mobile" href={contact.phoneHref} data-track="phone_click">Call {contact.phone}</a>
    </nav>

    <div class="site-header__actions">
      <a class="site-header__phone" href={contact.phoneHref} data-track="phone_click">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z" fill="currentColor" /></svg>
        <span class="site-header__phone-text">{contact.phone}</span>
      </a>
      <a class="btn btn--primary site-header__cta" href={booking.url} target="_blank" rel="noopener" data-track="booking_click">Check availability</a>
      <button class="site-header__menu" type="button" aria-controls="site-nav" aria-expanded="false">
        <span class="visually-hidden">Menu</span>
        <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: rgba(252, 250, 247, 0.96);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--moc-border);
  }
  .site-header__inner { display: flex; align-items: center; gap: 16px; min-height: 76px; }
  .site-header__logo { flex: none; display: block; }
  .logo-full { height: 38px; width: auto; }
  .logo-icon { display: none; height: 36px; width: auto; }

  .site-nav { flex: 1; display: flex; justify-content: center; }
  .site-nav__list { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; }
  .site-nav__item { position: relative; }
  .site-nav__link, .site-nav__toggle {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px; padding: 8px 10px;
    font: 600 15px/1.2 var(--font-body); color: var(--moc-purple-900); text-decoration: none;
    background: none; border: 0; border-radius: 10px; cursor: pointer; white-space: nowrap;
  }
  .site-nav__link:hover, .site-nav__toggle:hover, .site-nav__link[aria-current='page'] { color: var(--moc-purple-700); background: var(--moc-purple-tint); }
  .site-nav__sub {
    list-style: none; margin: 0; padding: 10px; position: absolute; top: calc(100% + 6px); left: 0; min-width: 280px;
    background: var(--moc-white); border-radius: var(--radius-tile); box-shadow: var(--moc-shadow-card-hover);
    display: none;
  }
  .site-nav__sub a {
    display: block; padding: 10px 12px; border-radius: 10px; color: var(--moc-purple-900); text-decoration: none; font-weight: 500; font-size: 15px;
  }
  .site-nav__sub a:hover { background: var(--moc-purple-tint); color: var(--moc-purple-700); }
  .site-nav__item.is-open > .site-nav__sub { display: block; }
  @media (hover: hover) and (min-width: 1200px) {
    .site-nav__item.has-children:hover > .site-nav__sub,
    .site-nav__item.has-children:focus-within > .site-nav__sub { display: block; }
    .site-nav__sub::before { content: ''; position: absolute; left: 0; right: 0; top: -10px; height: 10px; }
  }
  .site-nav__phone-mobile { display: none; }

  .site-header__actions { display: flex; align-items: center; gap: 12px; flex: none; }
  .site-header__phone {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 6px;
    color: var(--moc-purple-800); font-weight: 700; text-decoration: none; white-space: nowrap;
  }
  .site-header__menu {
    display: none; width: 44px; height: 44px; border: 0; border-radius: 12px; background: var(--moc-purple-tint);
    color: var(--moc-purple-800); cursor: pointer; align-items: center; justify-content: center;
  }

  @media (max-width: 1520px) { .site-header__phone-text { display: none; } }

  @media (max-width: 1199px) {
    /* backdrop-filter would make the header the containing block for the fixed drawer */
    .site-header { backdrop-filter: none; background: var(--moc-bg); }
    .logo-full { display: none; }
    .logo-icon { display: block; }
    .site-header__inner { min-height: 64px; }
    .site-header__menu { display: inline-flex; }
    .site-header__cta { display: none; }
    .site-header__actions { margin-left: auto; }
    .site-header__phone { width: 44px; justify-content: center; background: var(--moc-coral-tint); border-radius: 12px; }
    .site-nav {
      display: none; position: fixed; inset: 64px 0 0 0; background: var(--moc-bg); overflow-y: auto;
      padding: 16px clamp(16px, 4vw, 32px) 120px; flex-direction: column; justify-content: flex-start; gap: 16px;
    }
    .site-nav.is-open { display: flex; }
    .site-nav__list { flex-direction: column; gap: 0; }
    .site-nav__item { border-bottom: 1px solid var(--moc-border); }
    .site-nav__link, .site-nav__toggle { width: 100%; justify-content: space-between; min-height: 56px; font-size: 18px; padding: 8px 4px; }
    .site-nav__sub { position: static; box-shadow: none; padding: 0 0 12px; min-width: 0; background: transparent; }
    .site-nav__sub a { padding: 12px 4px 12px 16px; font-size: 16px; }
    .site-nav__item.is-open .site-nav__toggle svg { transform: rotate(180deg); }
    .site-nav__phone-mobile {
      display: flex; align-items: center; justify-content: center; min-height: 52px; border-radius: var(--radius-pill);
      background: var(--moc-purple-700); color: var(--moc-white); font-weight: 700; text-decoration: none;
    }
  }
</style>

<script>
  const nav = document.getElementById('site-nav');
  const menu = document.querySelector<HTMLButtonElement>('.site-header__menu');
  menu?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    menu.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  });
  document.querySelectorAll<HTMLButtonElement>('.site-nav__toggle').forEach((btn) => {
    btn.addEventListener('click', () => {
      const item = btn.parentElement!;
      const open = !item.classList.contains('is-open');
      document.querySelectorAll('.site-nav__item.is-open').forEach((el) => {
        if (el !== item) {
          el.classList.remove('is-open');
          el.querySelector('.site-nav__toggle')?.setAttribute('aria-expanded', 'false');
        }
      });
      item.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('.site-nav__item.is-open').forEach((el) => {
      el.classList.remove('is-open');
      el.querySelector('.site-nav__toggle')?.setAttribute('aria-expanded', 'false');
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.site-nav__item')) {
      document.querySelectorAll('.site-nav__item.is-open').forEach((el) => {
        el.classList.remove('is-open');
        el.querySelector('.site-nav__toggle')?.setAttribute('aria-expanded', 'false');
      });
    }
  });
</script>
