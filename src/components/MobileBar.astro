---
// Sticky bottom bar on mobile. On virtual office pages it reads "Get your address" and scrolls to the form.
import { booking, contact } from '../data/facts';

interface Props {
  variant?: 'rooms' | 'virtual-office';
}
const { variant = 'rooms' } = Astro.props;
---
<div class="mobile-bar">
  <a class="mobile-bar__icon" href={contact.phoneHref} data-track="phone_click" aria-label={`Call ${contact.phone}`}>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.6a1 1 0 0 1-.25 1z" fill="currentColor" /></svg>
  </a>
  <a class="mobile-bar__icon" href={contact.whatsappHref} data-track="whatsapp_click" rel="noopener" aria-label={`WhatsApp ${contact.text}`}>
    <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4a.5.5 0 0 0 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c1.6.7 2.3.8 3.1.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.2-.2-.2-.4-.3z" /></svg>
  </a>
  {variant === 'virtual-office' ? (
    <a class="btn btn--primary mobile-bar__cta" href="#get-your-address">Get your address</a>
  ) : (
    <a class="btn btn--primary mobile-bar__cta" href={booking.url} target="_blank" rel="noopener" data-track="booking_click">Check availability</a>
  )}
</div>

<style>
  .mobile-bar { display: none; }
  @media (max-width: 960px) {
    .mobile-bar {
      display: flex; gap: 10px; align-items: center;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, 0.97); border-top: 1px solid var(--moc-border);
      box-shadow: 0 -8px 24px rgba(42, 7, 82, 0.08);
    }
    .mobile-bar__icon {
      flex: none; width: 48px; height: 48px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center;
      background: var(--moc-purple-tint); color: var(--moc-purple-800);
    }
    .mobile-bar__cta { flex: 1; }
  }
</style>
