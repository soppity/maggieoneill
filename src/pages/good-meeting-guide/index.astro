---
// The Good Meeting Guide: lead magnet landing page (owner, Oct 2026). Replaces the GHL page at goodmeeting.mobtc.co.uk
// (301 in netlify.toml). The form posts to netlify/functions/lead.mjs, which forwards it to the GHL webhook with
// form_name "good-meeting-guide", and to Netlify Forms as a backup. On success the visitor goes to the thank-you page,
// which has the download. The home page pop-up (components/GuidePopup.astro) links here.
// Copy from the owner's GHL page (Oct 2026), lightly edited to house style ("Maggie O'Neill Centre", no "The").
// Images are crops of the owner's screenshots of that page (public/images/good-meeting-guide/).
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { goodMeetingGuide as gmg, site } from '../../data/facts';
import { breadcrumbNode } from '../../lib/schema';
import '../../styles/forms.css';

const url = `${site.url}${gmg.path}`;
const title = "The Good Meeting Guide, Free | Maggie O'Neill Centre";
const description =
  "Why everyone secretly hates your meetings, and the 4 changes that fix it. A free 14-page guide from the Maggie O'Neill Centre. No fluff, no jargon, 10 minutes to read.";

const learn = [
  'The "film test": why a 2-hour film flies by but a 1-hour meeting drags (and how to steal the trick)',
  "The one ingredient every gripping meeting has (it's not biscuits)",
  'Why "meeting stew" is killing your weekly meeting, and the 4 meetings that replace it',
  'The counter-intuitive maths: how more types of meeting = 5+ hours back every week',
  'A print-and-pin wall chart your whole team can run from',
  'Your first 30 days, week by week: start Monday, no permission needed',
];

const schema = [
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: gmg.name, url },
  ]),
];
---
<Base title={title} description={description} ogImage={`${site.url}/images/good-meeting-guide/bored-meeting.png`} ogImageAlt="An illustration of a man asleep on a meeting table" schema={schema}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: gmg.name, path: gmg.path }]} />

  <section class="section gmg">
    <div class="container gmg__inner">
      <span class="eyebrow">Free guide</span>
      <h1>Why everyone secretly <em>hates</em> your meetings, and the 4 changes that fix it</h1>
      <p class="gmg__lede">A free 14-page guide from the Maggie O'Neill Centre. No fluff, no jargon, takes 10 minutes to read.</p>
      <img class="gmg__illo" src="/images/good-meeting-guide/bored-meeting.png" width="812" height="438" alt="An illustration of a man in a suit asleep on a meeting table, next to a cup of tea and his notes" />

      <div class="card gmg__learn">
        <h2>Inside you'll learn...</h2>
        <ul>
          {learn.map((l) => (
            <li>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><circle cx="12" cy="12" r="12" fill="currentColor" /><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
              <span>{l}</span>
            </li>
          ))}
        </ul>
      </div>

      <img class="gmg__pages" src="/images/good-meeting-guide/guide-pages.jpg" width="1300" height="670" loading="lazy" alt="Pages from the Good Meeting Guide, including the film test, the weekly tactical meeting and research on how much time meetings take" />

      <p class="gmg__ask" id="get-the-guide">Pop your first name and email below to download the guide instantly. That's it. No spam, no 47-part email course, just the PDF.</p>

      <form class="gmg__form" name={gmg.formName} method="POST" data-netlify="true" netlify-honeypot="bot-field" data-gmg novalidate>
        <input type="hidden" name="form-name" value={gmg.formName} />
        <p class="form__honeypot"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
        <div class="gmg__fields">
          <div class="field">
            <label class="visually-hidden" for="gmg-name">First name</label>
            <input id="gmg-name" name="first_name" type="text" autocomplete="given-name" placeholder="First name" required />
            <span class="field__error"></span>
          </div>
          <div class="field">
            <label class="visually-hidden" for="gmg-email">Email</label>
            <input id="gmg-email" name="email" type="email" autocomplete="email" placeholder="Email" required />
            <span class="field__error"></span>
          </div>
          <button class="btn btn--primary gmg__submit" type="submit">Download the guide</button>
        </div>
        <label class="gmg__consent">
          <input type="checkbox" name="marketing_consent" value="yes" />
          <span>Optional: send me the occasional email about meetings and training at the Maggie O'Neill Centre. Unsubscribe any time.</span>
        </label>
        <p class="form__status" role="status" aria-live="polite"></p>
      </form>

      <p class="gmg__foot">Free from the Maggie O'Neill Centre, the charity venue in Huyton. We see hundreds of meetings a year. We're fans of about 8 of them.</p>
      <p class="gmg__privacy">We use your details to send you the guide. See our <a href="/privacy/">privacy policy</a>.</p>
    </div>
  </section>
</Base>

<script>
  import { goodMeetingGuide as gmg } from '../../data/facts';
  import { isEmail, lastError, setFieldError, submitNetlifyForm } from '../../scripts/netlifyForm';

  const form = document.querySelector<HTMLFormElement>('[data-gmg]');
  form?.addEventListener('input', (e) => setFieldError(e.target as HTMLInputElement, ''));
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = form.querySelector<HTMLInputElement>('[name="first_name"]');
    const email = form.querySelector<HTMLInputElement>('[name="email"]');
    let ok = true;
    if (!name?.value.trim()) { setFieldError(name, 'Please tell us your first name.'); ok = false; }
    if (!isEmail(email?.value ?? '')) { setFieldError(email, 'Please enter a valid email address.'); ok = false; }
    if (!ok) { form.querySelector<HTMLElement>('[data-invalid] input')?.focus(); return; }

    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = form.querySelector<HTMLElement>('.form__status');
    if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }
    if (status) { status.textContent = ''; delete status.dataset.state; }
    // Unticked checkboxes aren't sent, so say "no" explicitly for the CRM.
    const consent = form.querySelector<HTMLInputElement>('[name="marketing_consent"]');
    if (await submitNetlifyForm(form, { marketing_consent: consent?.checked ? 'yes' : 'no' })) {
      location.href = gmg.thankYou;
    } else {
      if (btn) { btn.disabled = false; btn.textContent = 'Download the guide'; }
      if (status) {
        status.textContent = `Sorry, that didn't send. Please try again. (Error: ${lastError})`;
        status.dataset.state = 'error';
      }
    }
  });
</script>

<style>
  .gmg { background: var(--moc-cream); }
  .gmg__inner { max-width: 1000px; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 24px; }
  .gmg h1 { font-size: clamp(36px, 5.6vw, 68px); line-height: 1.04; max-width: 900px; }
  .gmg h1 em { font-style: normal; color: var(--moc-coral-500); }
  .gmg__lede { font-size: clamp(18px, 2vw, 22px); color: var(--moc-slate-text); max-width: 640px; }
  .gmg__illo { width: 100%; max-width: 640px; height: auto; border-radius: var(--radius-card); background: var(--moc-white); box-shadow: var(--moc-shadow-card); }
  .gmg__learn { width: 100%; max-width: 780px; text-align: left; padding: clamp(24px, 4vw, 40px); margin-top: 16px; }
  .gmg__learn h2 { font-size: 26px; margin-bottom: 18px; }
  .gmg__learn ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 18px; }
  .gmg__learn li { display: grid; grid-template-columns: 22px 1fr; gap: 14px; align-items: start; font-size: var(--text-lead-size); }
  .gmg__learn svg { color: var(--moc-coral-500); margin-top: 3px; }
  .gmg__pages { width: 100%; max-width: 900px; height: auto; margin-top: 16px; border-radius: var(--radius-card); }
  .gmg__ask { font-size: clamp(18px, 2vw, 22px); color: var(--moc-slate-text); max-width: 760px; }
  .gmg__form { width: 100%; max-width: 820px; display: flex; flex-direction: column; gap: 12px; scroll-margin-top: 100px; }
  .gmg__fields { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; padding: 10px; background: var(--moc-white); border-radius: 999px; box-shadow: var(--moc-shadow-card); }
  .gmg__fields .field { text-align: left; }
  .gmg__fields input { border-radius: 999px; background: var(--moc-cream); border-color: transparent; padding-left: 22px; }
  .gmg__submit { white-space: nowrap; }
  .gmg__consent { display: grid; grid-template-columns: 22px 1fr; gap: 10px; align-items: start; text-align: left; font-size: 15px; color: var(--moc-slate-text); cursor: pointer; padding: 0 12px; }
  .gmg__consent input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--moc-purple-700); }
  .gmg__foot { color: var(--moc-slate-text); max-width: 640px; margin-top: 8px; }
  .gmg__privacy { font-size: var(--text-caption-size); color: var(--moc-slate-text); }
  @media (max-width: 720px) {
    .gmg__inner { text-align: left; align-items: stretch; }
    .gmg__fields { grid-template-columns: 1fr; border-radius: var(--radius-card); }
  }
</style>
