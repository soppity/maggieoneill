---
// Reviews (Blueprint page 13, Template: Trust). Audience: bookers doing final checks.
// Score and count · themes · by sector · leave a review · CTA. WebPage only: no Review or aggregateRating markup.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { address, reviews, site } from '../../data/facts';
import { images } from '../../data/images';
import { bySector, themes, virtualOfficeReview, writtenReviewsAnalysed } from '../../data/reviewQuotes';
import { breadcrumbNode } from '../../lib/schema';

const path = '/reviews/';
const url = `${site.url}${path}`;
const title = `Maggie O'Neill Centre Reviews: ${reviews.count} on Google`;
const description = `What ${reviews.count} Google reviewers say about the Maggie O'Neill Centre in Huyton: the welcome, the rooms, the tea and the parking.`;

const schema = [
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Reviews', url },
  ]),
];

const G = '<svg aria-hidden="true" width="28" height="28" viewBox="0 0 24 24"><path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.4h6.5a5.5 5.5 0 0 1-2.4 3.6v3h3.8c2.3-2.1 3.6-5.2 3.6-8.7z"/><path fill="#34A853" d="M12 24c3.2 0 6-1.1 7.9-2.9l-3.8-3c-1.1.7-2.4 1.2-4.1 1.2-3.1 0-5.8-2.1-6.7-5H1.4v3.1A12 12 0 0 0 12 24z"/><path fill="#FBBC05" d="M5.3 14.3a7.2 7.2 0 0 1 0-4.6V6.6H1.4a12 12 0 0 0 0 10.8z"/><path fill="#EA4335" d="M12 4.8c1.8 0 3.3.6 4.6 1.8l3.4-3.4A12 12 0 0 0 1.4 6.6l3.9 3.1c.9-2.9 3.6-4.9 6.7-4.9z"/></svg>';
---
<Base title={title} description={description} ogImage={images[133].src} ogImageAlt={images[133].alt} schema={schema}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Reviews', path }]} />

  <section class="rv-hero">
    <div class="container rv-hero__inner">
      <div>
        <span class="eyebrow">Reviews</span>
        <h1>Maggie O'Neill Centre reviews</h1>
        <p class="rv-hero__tagline">Your delegates will tell you it was good.</p>
        <p class="rv-hero__lede">
          The Maggie O'Neill Centre in Huyton has {reviews.count} reviews on {reviews.source}. Here's what people mention most, grouped by theme and
          by the kind of booking they made.
        </p>
      </div>
      <div class="rv-score">
        <Fragment set:html={G} />
        <p class="rv-score__count">{reviews.count}</p>
        <p class="rv-score__label">{reviews.source} reviews, as of {reviews.asOf}</p>
        <a class="btn btn--secondary" href={address.mapsUrl} target="_blank" rel="noopener">Read them on Google</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="themes-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What people mention most</span>
        <h2 id="themes-heading">What do people say about the Maggie O'Neill Centre?</h2>
        <p>We read the {writtenReviewsAnalysed} reviews with written comments and counted what comes up. Here it is, most mentioned first.</p>
      </div>
      <ol class="grid themes">
        {themes.map((t) => (
          <li class="card theme">
            <p class="theme__share">{t.share} written reviews</p>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
            {t.quote && (
              <figure class="theme__quote">
                <blockquote>“{t.quote.quote}”</blockquote>
                <figcaption>{t.quote.name}{t.quote.org && <span>, {t.quote.org}</span>}</figcaption>
              </figure>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="sector-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">By booking</span>
        <h2 id="sector-heading">What do people say about each kind of booking?</h2>
      </div>
      <div class="sectors">
        {bySector.map((s) => (
          <div class="sector">
            <div class="sector__head">
              <h3>{s.title}</h3>
              <p>{s.text} <a href={s.href}>{s.linkText}</a></p>
            </div>
            <div class="sector__quotes">
              {s.quotes.map((q) => (
                <figure class="card sector__quote">
                  <blockquote>“{q.quote}”</blockquote>
                  <figcaption>{q.name}{q.org && <span>, {q.org}</span>}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))}
        <div class="sector">
          <div class="sector__head">
            <h3>Virtual office</h3>
            <p>Virtual office clients write about the post being looked after. <a href="/services/virtual-office/">Virtual office</a></p>
          </div>
          <div class="sector__quotes">
            <div class="card sector__quote">
              <p class="sector__summary">{virtualOfficeReview.summary}</p>
              <p class="sector__who">{virtualOfficeReview.name}, {virtualOfficeReview.org} (summarised from their review)</p>
            </div>
          </div>
        </div>
      </div>
      <p class="more">Read the full stories in our <a href="/case-studies/">case studies</a>.</p>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="leave-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Been here?</span>
        <h2 id="leave-heading">How do I leave a review?</h2>
      </div>
      <div class="prose">
        <p>
          Find the Maggie O'Neill Centre on Google Maps and choose "Write a review". It helps if you say what you booked, for example "our
          fostering training day" or "a team meeting in the Forum". That helps other people find the right room.
        </p>
        <p><a class="btn btn--primary" href={address.mapsUrl} target="_blank" rel="noopener">Review us on Google</a></p>
      </div>
    </div>
  </section>

  <CtaBand heading="See it for yourself" />
</Base>

<style>
  .rv-hero { background: var(--moc-hero-wash); padding: clamp(40px, 7vw, 80px) 0; }
  .rv-hero__inner { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .rv-hero h1 { margin-top: 10px; font-size: clamp(38px, 5.4vw, 64px); font-weight: var(--text-hero-weight); line-height: 1.05; color: var(--moc-purple-900); }
  .rv-hero__tagline { margin-top: 16px; font: 700 clamp(21px, 2.3vw, 28px)/1.25 var(--font-display); color: var(--moc-coral-text); }
  .rv-hero__lede { margin-top: 20px; max-width: 580px; font-size: clamp(18px, 1.8vw, var(--text-lead-size)); line-height: 1.55; }
  .rv-score { background: var(--moc-white); border-radius: var(--radius-card); box-shadow: var(--moc-shadow-card-hover); padding: 32px; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .rv-score__count { margin-top: 8px; font: 800 clamp(56px, 7vw, 80px)/1 var(--font-display); color: var(--moc-purple-900); }
  .rv-score__label { color: var(--moc-slate-text); margin-bottom: 16px; }
  .themes { list-style: none; margin: 0; padding: 0; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .theme { padding: 26px 28px; display: flex; flex-direction: column; gap: 10px; }
  .theme__share { font-size: var(--text-eyebrow-size); font-weight: 700; letter-spacing: var(--text-eyebrow-tracking); text-transform: uppercase; color: var(--moc-coral-text); }
  .theme p { color: var(--moc-slate-text); font-size: var(--text-small-size); }
  .theme__quote { margin: auto 0 0; padding-top: 14px; border-top: 1px solid var(--moc-border); }
  .theme__quote blockquote, .sector__quote blockquote { margin: 0; font: 600 17px/1.45 var(--font-display); color: var(--moc-purple-900); }
  .theme__quote figcaption, .sector__quote figcaption, .sector__who { margin-top: 8px; font-weight: 700; font-size: var(--text-small-size); color: var(--moc-ink, inherit); }
  .sectors { display: grid; gap: 32px; }
  .sector { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(20px, 4vw, 48px); align-items: start; }
  .sector__head p { margin-top: 8px; color: var(--moc-slate-text); }
  .sector__quotes { display: grid; gap: 12px; }
  .sector__quote { margin: 0; padding: 22px 26px; }
  .sector__summary { font: 600 17px/1.45 var(--font-display); color: var(--moc-purple-900); }
  .more { margin-top: 32px; font-weight: 700; }
  .two-col { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .prose { display: flex; flex-direction: column; gap: 16px; }
  @media (max-width: 900px) {
    .rv-hero__inner, .sector, .two-col { grid-template-columns: 1fr; }
    .themes { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) { .themes { grid-template-columns: 1fr; } }
</style>
