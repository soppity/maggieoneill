---
// Cookie policy (Trust template). Lists what the site actually sets. Update it if a new tool is added.
import Base from '../../layouts/Base.astro';
import { contact, site } from '../../data/facts';
import { images } from '../../data/images';
import { breadcrumbNode } from '../../lib/schema';

const url = `${site.url}/cookies/`;
const rows = [
  {
    name: 'Your cookie choice',
    who: site.name,
    why: 'Remembers whether you accepted or rejected cookies, so we don’t ask again. Stored in your browser, not as a cookie.',
    when: 'Always',
  },
  {
    name: '_ga, _ga_*',
    who: 'Google Analytics, through Google Tag Manager',
    why: 'Counts visits and shows which pages people use and how they found us. It doesn’t tell us who you are.',
    when: 'Only if you accept',
  },
  {
    name: 'Enquiry form cookies',
    who: 'GoHighLevel (LeadConnector)',
    why: 'Make the enquiry and virtual office forms work and pass your message to us.',
    when: 'On pages with a form',
  },
  {
    name: 'Lease details form progress',
    who: site.name,
    why: 'Saves your answers on the operator licence lease details form, so you can finish later on the same device. Stored in your browser, not as a cookie.',
    when: 'Only if you use that form',
  },
  {
    name: 'Good Meeting Guide pop-up',
    who: site.name,
    why: 'Remembers that you have seen the Good Meeting Guide pop-up, so it only shows once. Stored in your browser, not as a cookie.',
    when: 'On the home page',
  },
  {
    name: 'Google Maps',
    who: 'Google',
    why: 'Shows the map of how to find us.',
    when: 'Only if you press “Show the map”',
  },
];
---
<Base
  title="Cookies | Maggie O'Neill Centre"
  description="How the Maggie O'Neill Centre website uses cookies, what each one does, and how to change your choice."
  ogImage={images[1].src}
  ogImageAlt={images[1].alt}
  schema={[breadcrumbNode(url, [{ name: 'Home', url: `${site.url}/` }, { name: 'Cookies', url }])]}
>
  <section class="section legal">
    <div class="container">
      <nav class="legal__crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Cookies</nav>
      <h1>Cookies on the Maggie O'Neill Centre website</h1>
      <p class="legal__lede">
        We only use analytics cookies if you say yes. They help us see how people find the site and which pages are useful.
        You can change your choice at any time.
      </p>
      <button type="button" class="btn btn--primary" data-cookie-settings>Change your cookie choice</button>

      <h2>What we use</h2>
      <div class="legal__table">
        <table>
          <thead>
            <tr><th scope="col">What</th><th scope="col">Who sets it</th><th scope="col">What it does</th><th scope="col">When</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr><th scope="row">{r.name}</th><td>{r.who}</td><td>{r.why}</td><td>{r.when}</td></tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2>Questions</h2>
      <p>
        Call us on <a href={contact.phoneHref} data-track="phone_click">{contact.phone}</a>
        {contact.email && <> or email <a href={`mailto:${contact.email}`} data-track="email_click">{contact.email}</a></>}.
      </p>
      <p class="legal__updated">Last updated: October 2026</p>
    </div>
  </section>
</Base>

<style>
  .legal .container { max-width: 880px; display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .legal__crumbs { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  .legal h1 { font-size: clamp(34px, 5vw, var(--text-h1-size)); font-weight: 800; }
  .legal h2 { font-size: clamp(24px, 3vw, 30px); margin-top: 24px; }
  .legal__lede { font-size: var(--text-lead-size); }
  .legal__table { width: 100%; overflow-x: auto; }
  .legal table { width: 100%; border-collapse: collapse; font-size: var(--text-small-size); background: var(--moc-white); border-radius: var(--radius-tile); overflow: hidden; box-shadow: var(--moc-shadow-card); }
  .legal th, .legal td { text-align: left; vertical-align: top; padding: 14px 16px; border-bottom: 1px solid var(--moc-border); }
  .legal thead th { background: var(--moc-purple-tint); color: var(--moc-purple-900); }
  .legal tbody tr:last-child > * { border-bottom: 0; }
  .legal__updated { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  @media (max-width: 640px) {
    .legal table, .legal thead, .legal tbody, .legal tr, .legal th, .legal td { display: block; }
    .legal thead { display: none; }
    .legal tbody tr { padding: 10px 0; border-bottom: 1px solid var(--moc-border); }
    .legal tbody th, .legal tbody td { border-bottom: 0; padding: 4px 16px; }
  }
</style>
