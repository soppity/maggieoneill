---
// Guides for bookers (Blueprint 05 · page 19, Trust template). Lists published guides only, virtual office first.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Photo from '../../components/Photo.astro';
import CtaBand from '../../components/sections/CtaBand.astro';
import { site } from '../../data/facts';
import { images } from '../../data/images';
import { guidePath, publishedGuides } from '../../data/guides';
import { breadcrumbNode } from '../../lib/schema';

const url = `${site.url}/blog/`;
const title = "Guides for Training Bookers | Maggie O'Neill Centre";
const description =
  'Practical guides for people who book training and meetings, and for directors who need a business address. From Maggie O’Neill Centre.';

const streams = [
  { key: 'virtual-office' as const, heading: 'Virtual office and registered office guides', intro: 'Business addresses, Companies House and keeping your home address private.' },
  { key: 'training' as const, heading: 'Guides for training bookers', intro: 'Planning the day, choosing a layout and adding social value.' },
]
  .map((s) => ({ ...s, guides: publishedGuides(s.key) }))
  .filter((s) => s.guides.length > 0);

const schema = [
  { '@type': 'Blog', '@id': `${url}#blog`, name: 'Guides', url, publisher: { '@id': `${site.url}/#org` }, inLanguage: 'en-GB' },
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Guides', url },
  ]),
];
---
<Base title={title} description={description} ogImage={images[6].src} ogImageAlt={images[6].alt} schema={schema}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Guides', path: '/blog/' }]} />

  <section class="section guides-head">
    <div class="container">
      <h1>Guides for training bookers and small businesses</h1>
      <p class="guides-head__tagline">For the people who book the room.</p>
      <p class="guides-head__lede">Straight answers to the questions we get asked most, from business addresses to training days.</p>
    </div>
  </section>

  {streams.map((s) => (
    <section class="section section--white" aria-labelledby={`${s.key}-heading`}>
      <div class="container">
        <div class="section-head">
          <h2 id={`${s.key}-heading`}>{s.heading}</h2>
          <p>{s.intro}</p>
        </div>
        <ul class="grid guide-cards">
          {s.guides.map((g) => (
            <li>
              <a class="card guide-card" href={guidePath(g)}>
                <Photo n={g.image} width={600} height={360} sizes="(max-width: 640px) 100vw, 360px" />
                <div class="guide-card__body">
                  <h3>{g.title}</h3>
                  <p>{g.summary}</p>
                  <span class="guide-card__link">Read the guide <span aria-hidden="true">→</span></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  <CtaBand />
</Base>

<style>
  .guides-head { background: var(--moc-bg-warm); }
  .guides-head h1 { font-size: clamp(36px, 5vw, 60px); font-weight: 800; max-width: 900px; }
  .guides-head__tagline { margin-top: 14px; font: 700 clamp(20px, 2.2vw, 26px)/1.25 var(--font-display); color: var(--moc-coral-text); }
  .guides-head__lede { margin-top: 20px; font-size: var(--text-lead-size); max-width: 640px; }
  .guide-cards { list-style: none; margin: 0; padding: 0; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .guide-card { display: flex; flex-direction: column; overflow: hidden; height: 100%; text-decoration: none; color: inherit; }
  .guide-card :global(img) { aspect-ratio: 5 / 3; }
  .guide-card__body { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .guide-card__body p { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  .guide-card__link { margin-top: auto; font-weight: 700; color: var(--moc-coral-text); }
  @media (max-width: 900px) { .guide-cards { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .guide-cards { grid-template-columns: 1fr; } }
</style>
