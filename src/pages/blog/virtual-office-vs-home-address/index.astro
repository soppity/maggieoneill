---
// Virtual office guide 5. Legal points must be checked against gov.uk before publishing (Blueprint 04 · Check before the push).
import Guide from '../../../layouts/Guide.astro';
import { address, formatPrice, rooms, virtualOffice, withCover } from '../../../data/facts';
import { guideBySlug } from '../../../data/guides';

const guide = guideBySlug('virtual-office-vs-home-address');
const [p20, p40] = virtualOffice.plans;
const dc = virtualOffice.directorsCover;
const pod = rooms.find((r) => r.slug === 'pod')!;

const title = "Virtual Office vs Home Address | Maggie O'Neill Centre";
const description =
  "Should your business use your home address or a virtual office? Cost, privacy and what each includes, compared. From Maggie O'Neill Centre.";

const answer =
  "Your home address is free but public. A virtual office gives you a business address and keeps your home private. It costs a small monthly fee, and you keep working from home. Pick the one that matches how you really work.";

const faqs = [
  {
    q: 'Should I use my home address for my business?',
    a: "You can, and it's free. But if you run a limited company, your home address is on the public Companies House register. It also goes on your website and invoices. A virtual office keeps your home private for a monthly fee.",
  },
  {
    q: 'Can I use a virtual office and work from home?',
    a: 'Yes. That’s how most virtual office clients work. The virtual office is your public address, and you carry on working from home.',
  },
  {
    q: 'Do I need to tell anyone if I run a business from home?',
    a: 'Check your mortgage, tenancy or lease, and tell your home insurer. Some have rules about running a business from home, even if you only work at a desk.',
  },
  {
    q: "Does the Maggie O'Neill Centre offer coworking?",
    a: `No, we don't do coworking or hot desks. Need a quiet room to work or meet in? Book the ${pod.name} for ${formatPrice(pod.prices!.hour!)} an hour. Virtual offices start at ${formatPrice(p20.price)} a month.`,
  },
];
---
<Guide
  guide={guide}
  title={title}
  description={description}
  tagline="Two ways to give your business an address."
  answer={answer}
  faqs={faqs}
  cta={{
    heading: 'A business address without the desk',
    text: `A virtual office at ${address.street}, Huyton, from ${formatPrice(p20.price)} a month. Keep working from home, and keep your home private.`,
    href: '/services/virtual-office/',
    label: 'Virtual office Liverpool',
  }}
>
  <h2>Home address or virtual office: compared</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th scope="col"><span class="visually-hidden">Question</span></th><th scope="col">Home address</th><th scope="col">Virtual office</th></tr>
      </thead>
      <tbody>
        <tr><th scope="row">Cost</th><td>Free</td><td>A small monthly fee</td></tr>
        <tr><th scope="row">Keeps your home private</th><td>No</td><td>Yes</td></tr>
        <tr><th scope="row">Registered office for Companies House</th><td>Yes</td><td>Yes</td></tr>
        <tr><th scope="row">Somewhere to work</th><td>Yes</td><td>No</td></tr>
        <tr><th scope="row">Post handled for you</th><td>No</td><td>Yes</td></tr>
        <tr><th scope="row">Meeting rooms</th><td>No</td><td>Often in the same building</td></tr>
      </tbody>
    </table>
  </div>

  <h2>Using your home address</h2>
  <p>
    It's free and it's simple. But say you run a limited company. You might use your home as the registered office or your director's service address.
    If so, it's on the public Companies House register for anyone to find. It also goes on your website, invoices and online listings.
  </p>
  <p>
    Some people feel a home address makes a business look smaller than it is. And customers, couriers and junk mail all come to
    your front door. If you move house, you have to update your address everywhere.
  </p>

  <h2>Using a virtual office</h2>
  <p>
    A virtual office gives you a real business address, without renting a desk. You can use it as your registered office and your business address.
    With the right plan, it can be your director's service address too. You carry on working from home, or wherever suits you.
  </p>
  <p>
    At the Maggie O'Neill Centre, a <a href="/services/virtual-office/">virtual office in Liverpool</a> costs {formatPrice(p20.price)} a month
    for {p20.name}. Or it's {formatPrice(p40.price)} for {p40.name}. That gives you unlimited post scanning and 2 free meeting room hours a month, worth {formatPrice(p40.price)}. {dc.name}
    adds your director's service address for {formatPrice(dc.price)} a month ({formatPrice(withCover(p20))} or {formatPrice(withCover(p40))}).
  </p>

  <h2>Which one is right for you?</h2>
  <ul>
    <li><strong>Choose your home address</strong> if you're a sole trader. It suits you if you don't mind your address on your website and invoices.</li>
    <li><strong>Choose a virtual office</strong> if you work from home but want to keep your home private. You get a proper business address, and your post is looked after.</li>
  </ul>
  <p class="callout">
    Need to meet clients? At the Maggie O'Neill Centre, meeting rooms are in the same building as your virtual office address. The smallest is the
    {' '}{pod.name}, a boardroom for {pod.capacity.boardroom}, at {formatPrice(pod.prices!.hour!)} an hour. Need a desk of your own? See <a href="/services/private-offices/">private offices</a>.
    Or start with <a href="/services/virtual-office/">registered office address plans in Liverpool</a>.
  </p>
</Guide>
