---
// Knowsley operator licence address. Public service page (owner brief, Oct 2026), moved in from taxi.mobtc.co.uk.
// Sells the satellite office lease to private hire operators applying to Knowsley Council.
// Rules from the brief: CTAs are only "Check if you qualify" (#enquire) and Call. Never link to, mention or embed the
// application guide or the lease form, no chat widget, and never show the planning reference (public wording is
// "Class E commercial building"). Schema: Service + FAQPage + BreadcrumbList.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/sections/Hero.astro';
import Steps from '../../components/sections/Steps.astro';
import Faqs from '../../components/sections/Faqs.astro';
import { address, contact, operatorLicence as ol, parking, site } from '../../data/facts';
import { images } from '../../data/images';
import { breadcrumbNode, faqNode, serviceNode } from '../../lib/schema';
import '../../styles/forms.css';

const path = ol.path;
const url = `${site.url}${path}`;
const title = "Knowsley Operator Licence Address | Maggie O'Neill Centre";
const description =
  "Need a council-recognised Knowsley address for your Operator's Licence? Real lease, planning permission, exit clause if refused. Starting from £100/month.";
const ogImage = `${site.url}/images/operators-licence/operators-licence-hero.png`;
const heroAlt = "Maggie O'Neill Centre, Knowsley address for private hire operator licence applications";

const lede = `You need a real lease, real planning permission and a real council-approved address in Knowsley for your Operator's Licence. Starting from £${ol.from} a month for ${ol.termMonths} months, with an exit clause if your application is refused. It's the compliant Knowsley address, not a virtual office, used by ${ol.operatorsSupported} operators in the borough.`;

const reasons = [
  {
    title: 'A real lease',
    text: "Not a virtual office: Knowsley rejects those. Yours is signed, dated and council-recognised, a satellite office lease with a real address.",
  },
  {
    title: 'Planning permission ready',
    text: 'The exact planning reference Knowsley asks for. We send you the PDF the moment you sign.',
  },
  {
    title: "Exit if you're refused",
    text: ol.exitClause,
  },
];

const numbers = [
  { figure: `£${ol.setupFee}`, label: 'Setup or hidden fees' },
  { figure: `${ol.termMonths} mo`, label: 'Lease with exit clause' },
  { figure: ol.operatorsSupported, label: 'Operators supported' },
];

const steps = [
  { title: 'Tell us about your operation', text: "Quick call or enquiry. We confirm you're applying to Knowsley and agree your vehicle tier." },
  { title: 'Sign your lease', text: `${ol.termMonths}-month satellite office lease with your own office number, plus the Knowsley planning permission certificate PDF.` },
  { title: 'Apply to the council, with our help', text: `We walk you through the Knowsley application at no extra cost. Most decisions arrive within ${ol.decisionWeeks} weeks.` },
];

const tierList = ol.tiers.map((t) => `£${t.price} for ${t.label}`).join(', ');

const faqs = [
  {
    q: "Does Knowsley Council accept virtual office addresses for Private Hire Operator's Licences?",
    a: `No. Knowsley specifically rejects virtual office addresses. Knowsley Council requires an office number of a physical office, whereas a virtual office only provides an address, not a physical lease. We've done this over 15 times, and these are the required specifics. The Maggie O'Neill Centre provides exactly what they need: a satellite office lease at ${address.street}, Huyton, with the planning permission documentation included.`,
  },
  {
    q: "What planning permission does the Maggie O'Neill Centre have?",
    a: `We are ${ol.planningPublic}, which is the correct planning permission for a Knowsley satellite office operator licence. We provide the full PDF of the planning permission certificate the day you sign your lease.`,
  },
  {
    q: "How much does a Knowsley Private Hire Operator's Licence cost?",
    a: `Knowsley Council charges from £${ol.councilFeeFrom} for a new 1-year licence covering one vehicle, up to £${ol.councilFeeTo} for a 5-year licence covering 51+ vehicles. We'll talk you through the right fee band for your operation. The lease with the Maggie O'Neill Centre is a separate ${ol.termMonths}-month term starting from £${ol.from} a month, tiered by vehicle count: ${tierList}.`,
  },
  {
    q: 'How long does the Knowsley operator licence application take?',
    a: `Knowsley Licensing typically processes new applications within ${ol.decisionWeeks} weeks of submission. Renewals are usually faster.`,
  },
  {
    q: 'What happens if Knowsley refuses my licence application?',
    a: "The lease agreement has an exit clause built in. If the council refuses your licence, you email us a copy of the refusal letter, your direct debit is cancelled, and you're released from the remainder of the lease term. You don't pay for months you can't use.",
  },
  {
    q: "Can I use a residential address for my Knowsley operator's licence?",
    a: "Some operators try this. Knowsley typically rejects residential addresses because they don't have commercial planning permission for use as private hire operator premises. A satellite office lease at the Maggie O'Neill Centre is the simpler, council-recognised route.",
  },
  {
    q: "What documents do I need to apply for a Knowsley operator's licence?",
    a: "You provide: basic DBS certificate, public liability insurance certificate, HM Tax Check code, proof of ID for each director, proof of citizenship or Right to Work for all directors, and the council application fee. We provide a signed lease agreement and the planning permission certificate PDF, which we send you after you sign. You're responsible for submitting these to the council.",
  },
  {
    q: "Can I use the Maggie O'Neill Centre address if I live outside Knowsley?",
    a: 'Yes. Your personal home address can be anywhere. The operator address (where you operate from as a business) is what needs to be in Knowsley with planning permission. Many of our operators live elsewhere in Liverpool City Region.',
  },
  {
    q: "Do I need to physically work at the Maggie O'Neill Centre to use the address?",
    a: "No. The lease grants you the right to use the address as your council-registered base of operation. You don't need to attend physically to operate. The centre is here if you ever want to host a meeting, but day-to-day operation can be entirely off-site.",
  },
  {
    q: "Where is the Maggie O'Neill Centre?",
    a: `${address.oneLine}, within Knowsley Metropolitan Borough, with free ${parking.spaces}-space parking and easy M57 access. We're a registered charity (${site.charityNumber}) running a flexible workspace facility, with profits funding Maggie's Meals and community programmes across Knowsley.`,
  },
];

const schema = [
  serviceNode({
    url,
    name: "Knowsley Private Hire Operator's Licence Address",
    serviceType: 'Private Hire Operator Address Service',
    description: `Council-recognised satellite office lease with planning permission for Knowsley Private Hire Operator's Licence applications. Starting from £${ol.from} per month, ${ol.termMonths}-month term, exit clause included if the council refuses.`,
    audience: 'Taxi and private hire operators applying to Knowsley Council',
    areaServed: ['Knowsley Metropolitan Borough'],
    catalogName: 'Satellite office lease, priced by vehicles on the licence',
    offers: ol.tiers.map((t) => ({ name: `Satellite office lease, ${t.label}`, price: t.price, description: `${ol.termMonths}-month lease, direct debit on the 1st, no setup fee.` })),
  }),
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: "Operator's licence", url },
  ]),
  faqNode(url, faqs),
];
---
<Base
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={heroAlt}
  preloadImage={images[3].src}
  schema={schema}
  mobileBar="custom"
  mobileBarHref="#enquire"
  mobileBarLabel="Check if you qualify"
>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: "Operator's licence", path }]} />

  <Hero
    title="Knowsley operator licence address for private hire operators"
    tagline="Your Knowsley operator's licence, sorted."
    lede={lede}
    image={3}
    imageAlt={heroAlt}
    primary={{ label: 'Check if you qualify', href: '#enquire' }}
    secondary={{ label: `Call now: ${contact.phone}`, href: contact.phoneHref }}
  >
    <p class="ol-supporting"><strong>{ol.operatorsSupported}</strong> operators supported</p>
  </Hero>

  <section class="section section--white ol-trust" aria-label="Who uses us">
    <div class="container ol-trust__inner">
      <span class="eyebrow">Used every week by Knowsley's private hire operators</span>
      <p>{ol.operatorsSupported} taxi and private hire operators use our address as their council-registered satellite office in Knowsley.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="why-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why it works</span>
        <h2 id="why-heading">Why does Knowsley accept our address?</h2>
        <p>Three reasons Knowsley accepts our address when they reject virtual offices.</p>
      </div>
      <ol class="grid ol-reasons">
        {reasons.map((r, i) => (
          <li class="card ol-reason">
            <span class="ol-reason__num" aria-hidden="true">{i + 1}</span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="help-heading">
    <div class="container ol-help">
      <div>
        <span class="eyebrow">On your side</span>
        <h2 id="help-heading">We want you to get your licence.</h2>
        <p>
          If your application fails, you don't need us, and we don't want you trapped in a lease you can't use. That's why we help you through the
          council application at no extra cost, with a step-by-step walkthrough of every section of the Knowsley form once you're on board.
        </p>
      </div>
      <ul class="ol-numbers">
        {numbers.map((n) => (
          <li><strong>{n.figure}</strong><span>{n.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--cream" id="pricing" aria-labelledby="pricing-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our pricing</span>
        <h2 id="pricing-heading">How much is a Knowsley operator licence address?</h2>
        <p>
          Starting at £{ol.from} a month. {ol.termMonths} months, direct debit on the 1st, no setup fee. Our lease pricing follows the tiers of car
          amounts in the operator licence application.
        </p>
      </div>
      <ul class="grid ol-tiers">
        {ol.tiers.map((t, i) => (
          <li class:list={['card', 'ol-tier', { 'ol-tier--lead': i === 0 }]}>
            <h3>{t.label}</h3>
            <p class="ol-tier__price"><strong>£{t.price}</strong> a month</p>
          </li>
        ))}
      </ul>
      <p class="ol-pricing__cta"><a class="btn btn--primary" href="#enquire">Check if you qualify</a></p>
    </div>
  </section>

  <Steps id="how-heading" eyebrow="How it works" heading="How do you get a Knowsley operator licence address?" intro="Three steps, and we help with all of them." steps={steps} tone="white" />

  <section class="section ol-enquire" id="enquire" aria-labelledby="enquire-heading">
    <div class="container ol-enquire__inner">
      <div class="ol-enquire__copy">
        <span class="eyebrow">Enquire</span>
        <h2 id="enquire-heading">See if we're the right fit</h2>
        <p>Tell us a little about your operation and we'll call you back, usually within one working day.</p>
        <p>Prefer to talk? <a href={contact.phoneHref} data-track="phone_click">Call {contact.phone}</a>.</p>
      </div>
      <div class="ol-enquire__box">
        <form class="form" name="operator-licence-enquiry" method="POST" data-netlify="true" netlify-honeypot="bot-field" data-ol-enquiry novalidate>
          <input type="hidden" name="form-name" value="operator-licence-enquiry" />
          <p class="form__honeypot"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
          <div class="form__row">
            <div class="field">
              <label for="ol-name">Full name <span class="req">*</span></label>
              <input id="ol-name" name="name" autocomplete="name" required />
              <span class="field__error"></span>
            </div>
            <div class="field">
              <label for="ol-mobile">Mobile <span class="req">*</span></label>
              <input id="ol-mobile" name="mobile" type="tel" inputmode="tel" autocomplete="tel" placeholder="07xxx xxxxxx" required />
              <span class="field__error"></span>
            </div>
          </div>
          <div class="form__row">
            <div class="field">
              <label for="ol-email">Email <span class="req">*</span></label>
              <input id="ol-email" name="email" type="email" autocomplete="email" required />
              <span class="field__error"></span>
            </div>
            <div class="field">
              <label for="ol-trading">Trading name</label>
              <input id="ol-trading" name="trading_name" autocomplete="organization" />
            </div>
          </div>
          <div class="form__row">
            <div class="field">
              <label for="ol-council">Which council are you applying to? <span class="req">*</span></label>
              <select id="ol-council" name="council" required>
                <option value="">Choose a council</option>
                <option value="knowsley">Knowsley</option>
                <option value="liverpool">Liverpool</option>
                <option value="sefton">Sefton</option>
                <option value="other">Other</option>
              </select>
              <span class="field__error"></span>
            </div>
            <div class="field">
              <label for="ol-vehicles">How many vehicles?</label>
              <select id="ol-vehicles" name="vehicles">
                <option value="">Choose</option>
                {ol.tiers.map((t) => <option value={t.vehicles}>{t.vehicles === '2-10' ? '2–10' : t.vehicles === '11-50' ? '11–50' : t.vehicles}</option>)}
              </select>
            </div>
          </div>
          <p class="form__note" data-ol-borough hidden>
            Our planning permission is specific to Knowsley Council, so we can only support Knowsley applications.
            {' '}<a href="/operators-licence/exit/" data-ol-exit>See where to go next</a>.
          </p>
          <div class="field">
            <label for="ol-type">New application or renewal?</label>
            <select id="ol-type" name="application_type">
              <option value="">Choose</option>
              <option value="new">New application</option>
              <option value="renewal">Renewal</option>
            </select>
          </div>
          <div class="field">
            <label for="ol-notes">Anything else we should know?</label>
            <textarea id="ol-notes" name="notes"></textarea>
          </div>
          <p class="form__status" role="status" aria-live="polite"></p>
          <p><button class="btn btn--primary" type="submit">Request a call back</button></p>
        </form>
        <div class="form-thanks" data-ol-thanks hidden tabindex="-1">
          <h3>Thanks, we'll be in touch shortly.</h3>
          <p>If it's urgent, call us on <a href={contact.phoneHref} data-track="phone_click">{contact.phone}</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <Faqs faqs={faqs} heading="Questions about the Knowsley operator licence address" />

  <section class="section section--white ol-close" aria-label="About us">
    <div class="container">
      <p class="ol-close__line">Registered charity {site.charityNumber} · {ol.operatorsSupported} operators supported</p>
      <p>
        Also at the Maggie O'Neill Centre: <a href="/services/meeting-rooms/">meeting rooms in Huyton</a>,
        {' '}<a href="/services/virtual-office/call-answering/">call answering</a> and a
        {' '}<a href="/services/virtual-office/">virtual office for other businesses</a>. <a href="/visit/">Come and see the building</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  import { isEmail, isUkMobile, setFieldError, submitNetlifyForm } from '../../scripts/netlifyForm';

  const form = document.querySelector<HTMLFormElement>('[data-ol-enquiry]');
  const thanks = document.querySelector<HTMLElement>('[data-ol-thanks]');
  const council = form?.querySelector<HTMLSelectElement>('[name="council"]');
  const note = form?.querySelector<HTMLElement>('[data-ol-borough]');
  const exitLink = form?.querySelector<HTMLAnchorElement>('[data-ol-exit]');

  // Clear a field's error as soon as it's changed.
  form?.addEventListener('input', (e) => setFieldError(e.target as Element, ''));
  form?.addEventListener('change', (e) => setFieldError(e.target as Element, ''));

  // Not Knowsley? Say so before they submit, and point them to the right place.
  council?.addEventListener('change', () => {
    const v = council.value;
    const other = v !== '' && v !== 'knowsley';
    if (note) note.hidden = !other;
    if (exitLink) exitLink.href = `/operators-licence/exit/?borough=${encodeURIComponent(v)}`;
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const get = (n: string) => form.querySelector<HTMLInputElement>(`[name="${n}"]`);
    const checks: [HTMLInputElement | null, string][] = [
      [get('name'), (get('name')?.value.trim().length ?? 0) < 2 ? 'Please tell us your name.' : ''],
      [get('mobile'), isUkMobile(get('mobile')?.value ?? '') ? '' : 'Please enter a UK mobile starting 07.'],
      [get('email'), isEmail(get('email')?.value ?? '') ? '' : 'Please enter a valid email address.'],
      [get('council'), get('council')?.value ? '' : 'Please choose a council.'],
    ];
    checks.forEach(([el, msg]) => setFieldError(el, msg));
    const firstBad = checks.find(([, msg]) => msg);
    if (firstBad) {
      firstBad[0]?.focus();
      return;
    }
    const status = form.querySelector<HTMLElement>('.form__status');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (status) { status.textContent = 'Sending…'; status.removeAttribute('data-state'); }
    const ok = await submitNetlifyForm(form);
    if (ok) {
      form.hidden = true;
      if (thanks) { thanks.hidden = false; thanks.focus(); }
    } else {
      if (button) button.disabled = false;
      if (status) { status.textContent = 'Sorry, that didn’t send. Please try again, or call us on 0151 482 0408.'; status.dataset.state = 'error'; }
    }
  });
</script>

<style>
  .ol-supporting { margin-top: 18px; color: var(--moc-purple-900); }
  .ol-supporting strong { font-family: var(--font-display); font-size: 22px; }
  .ol-trust { padding-top: 32px; padding-bottom: 32px; }
  .ol-trust__inner { display: flex; flex-direction: column; gap: 8px; }
  .ol-trust__inner p { font-size: var(--text-lead-size); color: var(--moc-purple-900); max-width: 820px; }
  .ol-reasons { grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; padding: 0; margin: 0; }
  .ol-reason { padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .ol-reason__num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--moc-coral-tint); color: var(--moc-coral-text); font: 800 18px/1 var(--font-display); }
  .ol-reason p { color: var(--moc-slate-text); }
  .ol-help { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .ol-help h2 { margin: 8px 0 14px; }
  .ol-help p { font-size: var(--text-lead-size); }
  .ol-numbers { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .ol-numbers li { display: flex; align-items: baseline; gap: 16px; padding: 18px 22px; border-radius: var(--radius-card); background: var(--moc-purple-tint); }
  .ol-numbers strong { font: 800 clamp(30px, 3.4vw, 40px)/1 var(--font-display); color: var(--moc-purple-900); min-width: 110px; }
  .ol-numbers span { color: var(--moc-purple-900); font-weight: 600; }
  .ol-tiers { grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; padding: 0; margin: 0; }
  .ol-tier { padding: 26px 24px; display: flex; flex-direction: column; gap: 8px; border-top: 4px solid var(--moc-purple-700); }
  .ol-tier--lead { border-top-color: var(--moc-coral-500); }
  .ol-tier h3 { font-size: 19px; }
  .ol-tier__price strong { font: 800 44px/1 var(--font-display); color: var(--moc-purple-900); letter-spacing: -0.02em; }
  .ol-tier__price { color: var(--moc-slate-text); }
  .ol-pricing__cta { margin-top: 28px; }
  .ol-enquire { background: var(--moc-purple-tint); scroll-margin-top: 88px; }
  .ol-enquire__inner { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .ol-enquire__copy { display: flex; flex-direction: column; gap: 14px; position: sticky; top: 104px; }
  .ol-enquire__copy p { font-size: var(--text-lead-size); }
  .ol-enquire__box { background: var(--moc-white); border-radius: var(--radius-card); box-shadow: var(--moc-shadow-card); padding: clamp(22px, 3vw, 36px); }
  .ol-close__line { font-weight: 700; color: var(--moc-purple-900); margin-bottom: 10px; }
  @media (max-width: 960px) { .ol-tiers { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) {
    .ol-reasons { grid-template-columns: 1fr; }
    .ol-help, .ol-enquire__inner { grid-template-columns: 1fr; }
    .ol-enquire__copy { position: static; }
  }
  @media (max-width: 520px) { .ol-tiers { grid-template-columns: 1fr; } }
</style>
