---
// Knowsley operator licence address. Public service page (owner briefs, Oct 2026), moved in from taxi.mobtc.co.uk.
// Sells the satellite office lease to private hire operators who need premises in Knowsley for their operator's licence.
// Keyword brief (Oct 2026): primary "knowsley operator licence address"; secondary "knowsley private hire (operator)",
// "operator licence knowsley", "private hire operator premises / operating base Knowsley", "knowsley taxi licensing".
// Rules: one CTA (the coded lease details form at /operators-licence/apply/, owner Oct 2026) plus the main phone number. Never link to the application guide, never show the planning reference
// (public wording: "planning permission in place"), no chat widget, no other licensing authorities named.
// Schema: Service (BusinessAudience, four Offers) + FAQPage + BreadcrumbList.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Hero from '../../components/sections/Hero.astro';
import KeyFacts from '../../components/sections/KeyFacts.astro';
import Steps from '../../components/sections/Steps.astro';
import Faqs from '../../components/sections/Faqs.astro';
import { address, contact, operatorLicence as ol, parking, site } from '../../data/facts';
import { images } from '../../data/images';
import { breadcrumbNode, faqNode, serviceNode } from '../../lib/schema';

const path = ol.path;
const url = `${site.url}${path}`;
// "Knowsley Operator Licence Address from £100 | Maggie O'Neill Centre" renders at 67 characters, so the shorter form.
const title = "Knowsley Operator Licence Address | Maggie O'Neill Centre";
const description = `A real lease and planning-approved premises in Knowsley for your private hire operator's licence. From £${ol.from} a month, exit clause if refused.`;
const ogImage = `${site.url}/images/operators-licence/operators-licence-hero.png`;
const heroAlt = "Maggie O'Neill Centre, Knowsley address for private hire operator licence applications";
const councilChange = 'https://www.knowsley.gov.uk/business-licences-and-consumers/licences-and-permits/taxi-and-private-hire/private-hire-operator-6';
const applyPath = `${ol.path}apply/`;
const councilNew = 'https://www.knowsley.gov.uk/business-licences-and-consumers/licences-and-permits/taxi-and-private-hire/private-hire-operator-1';

// Answer first: who, what, where, price, proof (40 to 60 words).
const lede = `The Maggie O'Neill Centre in Huyton leases satellite office space to private hire operators. It's for operators who need premises in Knowsley for their operator's licence. You get a real ${ol.termMonths}-month lease at a planning-approved address, from £${ol.from} a month. There's an exit clause if Knowsley Council refuses your application. ${ol.operatorsSupported} operators already use it.`;

const tierList = ol.tiers.map((t) => `£${t.price} for ${t.label}`).join(', ');

const keyFacts = [
  { term: 'Address', detail: `${address.oneLine}, in Knowsley.` },
  { term: 'Price by fleet size', detail: `${tierList}, a month.` },
  { term: 'Lease term', detail: `${ol.termMonths} months, direct debit on the 1st.` },
  { term: 'Exit clause', detail: ol.exitClause },
  { term: 'Planning permission', detail: ol.planningLine },
  { term: 'Setup fee', detail: 'None.' },
  { term: 'Operators helped', detail: `${ol.operatorsSupported} use our address in Knowsley.` },
  { term: 'Phone', detail: contact.phone, href: contact.phoneHref, linkText: 'Call now' },
];

const getsWithLease = [
  { title: 'A real lease', text: `A signed ${ol.termMonths}-month satellite office lease, at Class E commercial premises. You get your own suite number.` },
  { title: 'Planning approval', text: 'Planning permission is in place for the premises. We send you the certificate once you sign.' },
  { title: 'An exit clause', text: ol.exitClause },
  { title: 'Help with your application', text: 'We take you through the Knowsley Council application, step by step. There is no extra cost.' },
  { title: 'The address for your application', text: "Your suite number and our address. They're ready to go in the operator's office box on the council form." },
];

const numbers = [
  { figure: `£${ol.setupFee}`, label: 'Setup or hidden fees' },
  { figure: `${ol.termMonths} mo`, label: 'Lease with exit clause' },
  { figure: ol.operatorsSupported, label: 'Operators helped' },
];

const steps = [
  { title: 'Send us your details', text: "Fill in our lease details form or call us. We check you're applying to Knowsley. Then we agree your vehicle band." },
  { title: 'Sign your lease', text: `You sign a ${ol.termMonths}-month satellite office lease with your own suite number. You also get the planning permission certificate.` },
  { title: 'Apply to the council, with our help', text: `We take you through the Knowsley application at no extra cost. Most decisions come within ${ol.decisionWeeks} weeks.` },
];

type Faq = { q: string; a: string; link?: { text: string; href: string } };
const faqs: Faq[] = [
  {
    q: "Is the Maggie O'Neill Centre in Knowsley?",
    a: `Yes. The Maggie O'Neill Centre is at ${address.oneLine}. That's in Huyton, inside Knowsley Metropolitan Borough. There's a free ${parking.spaces}-space car park, and it's easy to reach from the M57.`,
  },
  {
    q: "Can an operator based outside Knowsley get a Knowsley private hire operator's licence?",
    a: "Yes. Knowsley taxi licensing needs the operator's licence to be for premises inside the borough. It doesn't matter where you live. Your home address can be anywhere. Many of the operators who use the Maggie O'Neill Centre live elsewhere in the Liverpool City Region.",
  },
  {
    q: "Can I use my home address for a Knowsley operator's licence?",
    a: "Usually not. Knowsley Council asks for a lease, with a suite number, at Class E commercial premises. A home is residential, not Class E. A satellite office lease at the Maggie O'Neill Centre is the simpler route, and the council recognises it.",
  },
  {
    q: 'Does Knowsley Council inspect the premises?',
    a: "No. Licensing officers don't visit the premises. They ask for a signed lease, with a suite number, at Class E commercial premises inside the borough. The Maggie O'Neill Centre is a Class E commercial building. Your lease names your own suite number. So your application has what the council asks for.",
  },
  {
    q: 'How long is the lease?',
    a: `The lease at the Maggie O'Neill Centre is ${ol.termMonths} months. You pay by direct debit on the 1st of each month. There's no setup fee. After the first ${ol.termMonths} months, either side can end it with 30 days' written notice.`,
  },
  {
    q: 'Do you help with the Knowsley council application?',
    a: "Yes. The Maggie O'Neill Centre helps every operator with the Knowsley Council private hire operator's licence application. There's no extra cost. Once you're on board, we take you through every section of the form.",
  },
  {
    q: 'How long does a Knowsley operator licence application take?',
    a: `Knowsley Licensing usually decides new private hire operator licence applications within ${ol.decisionWeeks} weeks of you sending them in. Renewals are often faster.`,
  },
  {
    q: 'Can I move my existing Knowsley operator licence to your address?',
    a: "Yes. Do you already hold a Knowsley private hire operator's licence? Sign the lease with the Maggie O'Neill Centre. Then tell Knowsley Council about your change of details.",
    link: { text: 'tell Knowsley Council about your change of details', href: councilChange },
  },
  {
    q: "How much does a Knowsley council private hire operator's licence cost?",
    a: `Knowsley Council charges from £${ol.councilFeeFrom} for a new 1-year operator's licence for one vehicle. It goes up to £${ol.councilFeeTo} for a 5-year licence for 51+ vehicles. The council fee is separate from the lease. You can see current fees on Knowsley Council's private hire operator page.`,
    link: { text: "Knowsley Council's private hire operator page", href: councilNew },
  },
  {
    q: "What planning permission does the Maggie O'Neill Centre have?",
    a: `The Maggie O'Neill Centre is ${ol.planningPublic}. Planning permission is in place for the premises. We share the reference once you qualify. You get the full planning permission certificate the day you sign your lease.`,
  },
  {
    q: "What documents do I need to apply for a Knowsley operator's licence?",
    a: "You provide: a basic DBS certificate, a public liability insurance certificate, an HM Tax Check code, proof of ID for each director, proof of citizenship or Right to Work for all directors, and the council application fee. We provide a signed lease and the planning permission certificate PDF. We send these to you after you sign. It's up to you to send them all to the council.",
  },
  {
    q: "Do I need to physically work at the Maggie O'Neill Centre to use the address?",
    a: "No. The lease gives you the right to use the Maggie O'Neill Centre as the operating base the council has on record. You don't need to come in to operate. The centre is here if you ever want to hold a meeting. But you can run things day to day from somewhere else.",
  },
];

const schema = [
  serviceNode({
    url,
    name: 'Knowsley private hire operator licence address',
    serviceType: 'Satellite office lease for private hire operator licensing',
    description: lede,
    audience: 'Private hire and taxi operators',
    audienceType: 'BusinessAudience',
    atVenue: true,
    areaServed: ['Knowsley', 'North West England'],
    catalogName: 'Satellite office lease, priced by vehicles on the licence',
    offers: ol.tiers.map((t) => ({
      name: `Satellite office lease, ${t.label}`,
      price: t.price,
      description: `${ol.termMonths}-month satellite office lease covering ${t.label} on your Knowsley private hire operator's licence. Direct debit on the 1st, no setup fee.`,
    })),
  }),
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: "Operator's licence", url },
  ]),
  faqNode(url, faqs),
];
---
<Base
  title={title}
  description={description}
  ogImage={ogImage}
  ogImageAlt={heroAlt}
  preloadImage={images[3].src}
  schema={schema}
  mobileBar="custom"
  mobileBarHref={applyPath}
  mobileBarLabel="Check if you qualify"
>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: "Operator's licence", path }]} />

  <Hero
    title="Your Knowsley operator's licence premises, sorted."
    lede={`A real lease at planning-approved premises in Knowsley, from £${ol.from} a month. There's an exit clause if the council says no. We've helped other operators through it, and we'll help you too.`}
    image={3}
    imageAlt={heroAlt}
    primary={{ label: 'Check if you qualify', href: applyPath }}
    secondary={{ label: `Call now: ${contact.phone}`, href: contact.phoneHref }}
  >
    <p class="ol-supporting"><strong>{ol.operatorsSupported}</strong> operators helped</p>
  </Hero>

  <KeyFacts
    heading="Your Knowsley operator licence address, in a few lines"
    intro={`For Knowsley private hire operators, the operating base has to be real premises in the borough. Ours is a satellite office lease at the Maggie O'Neill Centre. Planning permission is in place. Help with your private hire operator licence application is included.`}
    facts={keyFacts}
  />
  <p class="container updated">Last updated: October 2026</p>

  <section class="section" aria-label="Premises in Knowsley">
    <div class="container ol-why">
      <div class="ol-why__block">
        <span class="eyebrow">Knowsley private hire</span>
        <h2>Why do private hire operators need premises in Knowsley?</h2>
        <p>
          Because Knowsley Council gives a private hire operator's licence for premises inside the borough. Licensing officers don't inspect the
          premises. They ask for a signed lease, with a suite number, at Class E commercial premises in Knowsley. Are you based elsewhere? Do you want
          to run Knowsley-licensed drivers and vehicles? Then you need just that. The Maggie O'Neill Centre is a Class E commercial building. A
          satellite office lease here gives you the lease, the suite number and the planning permission certificate.
        </p>
      </div>
      <div class="ol-why__block">
        <span class="eyebrow">Not a virtual office</span>
        <h2>Can a virtual office be used for a Knowsley operator's licence?</h2>
        <p>
          No. For a private hire operator's licence, Knowsley Council asks for a lease, with a suite number, at Class E commercial premises. So this
          is a lease, not a virtual office. A <a href="/services/virtual-office/">virtual office</a> is right for a registered address or a business address.
          We offer those too. But for your Knowsley operator's licence, you need the satellite office lease.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="gets-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">What's included</span>
        <h2 id="gets-heading">What do I get with the lease?</h2>
        <p>Everything Knowsley taxi licensing asks for on the premises side. Plus help with the paperwork.</p>
      </div>
      <ul class="grid ol-reasons">
        {getsWithLease.map((r, i) => (
          <li class="card ol-reason">
            <span class="ol-reason__num" aria-hidden="true">{i + 1}</span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="help-heading">
    <div class="container ol-help">
      <div>
        <span class="eyebrow">On your side</span>
        <h2 id="help-heading">We want you to get your licence.</h2>
        <p>
          If your application fails, you don't need us. And we don't want you stuck in a lease you can't use. That's why we help you with the
          council application at no extra cost. Once you're on board, we take you through every section of the Knowsley form, step by step.
        </p>
      </div>
      <ul class="ol-numbers">
        {numbers.map((n) => (
          <li><strong>{n.figure}</strong><span>{n.label}</span></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--cream" id="pricing" aria-labelledby="pricing-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Our pricing</span>
        <h2 id="pricing-heading">How much does a Knowsley operator licence address cost?</h2>
        <p>
          From £{ol.from} a month. The price follows the vehicle bands on the council's operator licence application. The lease is {ol.termMonths} months.
          You pay by direct debit on the 1st, and there's no setup fee.
        </p>
      </div>
      <ul class="grid ol-tiers">
        {ol.tiers.map((t, i) => (
          <li class:list={['card', 'ol-tier', { 'ol-tier--lead': i === 0 }]}>
            <h3>{t.label}</h3>
            <p class="ol-tier__price"><strong>£{t.price}</strong> a month</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="refused-heading">
    <div class="container ol-refused">
      <span class="eyebrow">Exit clause</span>
      <h2 id="refused-heading">What happens if Knowsley refuses my application?</h2>
      <p>
        You're released from the lease. Say Knowsley Council refuses your operator's licence application, or takes away (revokes) your licence.
        Just email us a copy of the council's letter. We cancel your direct debit, and you owe nothing for the months after. It's built into the agreement.
      </p>
    </div>
  </section>

  <Steps
    id="start-heading"
    eyebrow="Get started"
    heading="How do I get started?"
    intro="Send us your details on our lease details form. Once we've checked them, we send you the application guide and the planning details."
    steps={steps}
  />

  <section class="section ol-enquire" id="get-started" aria-labelledby="enquire-heading">
    <div class="container ol-enquire__inner">
      <div class="ol-enquire__copy">
        <span class="eyebrow">Your details</span>
        <h2 id="enquire-heading">See if we're the right fit</h2>
        <p>Tell us about your business in our lease details form. Your answers save as you go. So you can come back and finish later.</p>
      </div>
      <div class="ol-enquire__box">
        <ul class="tick-list">
          <li><span>Which council you're applying to. And if it's a new application or a renewal.</span></li>
          <li><span>How many vehicles, so we can confirm your price band.</span></li>
          <li><span>Your business details, for the lease and our anti-money laundering (AML) checks.</span></li>
        </ul>
        <p class="ol-enquire__cta"><a class="btn btn--primary" href={applyPath}>Start your lease details</a></p>
        <p>Prefer to talk? <a href={contact.phoneHref} data-track="phone_click">Call {contact.phone}</a>.</p>
      </div>
    </div>
  </section>

  <Faqs faqs={faqs} heading="Knowsley private hire licence questions" />

  <section class="section section--white ol-close" aria-label="About us">
    <div class="container">
      <p class="ol-close__line">{ol.operatorsSupported} operators helped · Registered charity {site.charityNumber}</p>
      <p>
        Also at the Maggie O'Neill Centre: <a href="/services/meeting-rooms/">meeting rooms in Huyton</a>,
        {' '}<a href="/services/virtual-office/call-answering/">call answering</a> and a
        {' '}<a href="/services/virtual-office/">virtual office for registered and business addresses</a>. <a href="/visit/">Come and see the building</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .ol-supporting { margin-top: 18px; color: var(--moc-purple-900); }
  .ol-supporting strong { font-family: var(--font-display); font-size: 22px; }
  .updated { margin-top: -40px; margin-bottom: 0; font-size: var(--text-caption-size); color: var(--moc-slate-text); position: relative; }
  .ol-why { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 64px); }
  .ol-why__block { display: flex; flex-direction: column; gap: 12px; }
  .ol-why__block p { font-size: var(--text-lead-size); }
  .ol-reasons { grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; padding: 0; margin: 0; }
  .ol-reason { padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .ol-reason__num { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--moc-coral-tint); color: var(--moc-coral-text); font: 800 18px/1 var(--font-display); }
  .ol-reason p { color: var(--moc-slate-text); }
  .ol-help { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: clamp(28px, 5vw, 64px); align-items: center; }
  .ol-help h2 { margin: 8px 0 14px; }
  .ol-help p { font-size: var(--text-lead-size); }
  .ol-numbers { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; }
  .ol-numbers li { display: flex; align-items: baseline; gap: 16px; padding: 18px 22px; border-radius: var(--radius-card); background: var(--moc-purple-tint); }
  .ol-numbers strong { font: 800 clamp(30px, 3.4vw, 40px)/1 var(--font-display); color: var(--moc-purple-900); min-width: 110px; }
  .ol-numbers span { color: var(--moc-purple-900); font-weight: 600; }
  .ol-tiers { grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; padding: 0; margin: 0; }
  .ol-tier { padding: 26px 24px; display: flex; flex-direction: column; gap: 8px; border-top: 4px solid var(--moc-purple-700); }
  .ol-tier--lead { border-top-color: var(--moc-coral-500); }
  .ol-tier h3 { font-size: 19px; }
  .ol-tier__price strong { font: 800 44px/1 var(--font-display); color: var(--moc-purple-900); letter-spacing: -0.02em; }
  .ol-tier__price { color: var(--moc-slate-text); }
  .ol-refused { max-width: 860px; display: flex; flex-direction: column; gap: 12px; }
  .ol-refused p { font-size: var(--text-lead-size); }
  .ol-enquire { background: var(--moc-purple-tint); scroll-margin-top: 88px; }
  .ol-enquire__inner { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 5vw, 64px); align-items: start; }
  .ol-enquire__copy { display: flex; flex-direction: column; gap: 14px; position: sticky; top: 104px; }
  .ol-enquire__copy p { font-size: var(--text-lead-size); }
  .ol-enquire__cta { margin: 22px 0 14px; }
  .ol-enquire__box { background: var(--moc-white); border-radius: var(--radius-card); box-shadow: var(--moc-shadow-card); padding: clamp(22px, 3vw, 36px); }
  .ol-close__line { font-weight: 700; color: var(--moc-purple-900); margin-bottom: 10px; }
  @media (max-width: 960px) { .ol-tiers { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) {
    .ol-why, .ol-reasons, .ol-help, .ol-enquire__inner { grid-template-columns: 1fr; }
    .ol-enquire__copy { position: static; }
    .updated { margin-top: -24px; }
  }
  @media (max-width: 520px) { .ol-tiers { grid-template-columns: 1fr; } }
</style>
