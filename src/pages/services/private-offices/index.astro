---
// Private offices. Spec: Website Blueprint page 8 (Template: Service). Audience: small teams needing a base.
// Job: small, high-value. Sell the hosted building and the community around it.
// Owner, Oct 2026: 10 offices, all let, so the CTA is the waitlist. From £450 a month on a 1-year lease, bills included.
// Single (1 to 2 people) and double (4 to 6). Desks, chairs and filing cabinets. 4 free meeting room hours a month and
// 20% off after that. Deliveries taken in. VoIP phones available at extra cost. No access outside opening hours, except
// the Thursday late stay. The centre is looking for a second location.
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Hero from '../../../components/sections/Hero.astro';
import KeyFacts from '../../../components/sections/KeyFacts.astro';
import Reviews from '../../../components/sections/Reviews.astro';
import VirtualOfficeBand from '../../../components/sections/VirtualOfficeBand.astro';
import Faqs from '../../../components/sections/Faqs.astro';
import OfficeWaitlistForm from '../../../components/sections/OfficeWaitlistForm.astro';
import FindUs from '../../../components/sections/FindUs.astro';
import Photo from '../../../components/Photo.astro';
import { contact, formatPrice, hours, parking, privateOffices as po, rooms, site } from '../../../data/facts';
import { images } from '../../../data/images';
import { quotes } from '../../../data/reviewQuotes';
import { breadcrumbNode, faqNode, serviceNode } from '../../../lib/schema';

const path = '/services/private-offices/';
const url = `${site.url}${path}`;
const pod = rooms.find((r) => r.slug === 'pod')!;
const from = formatPrice(po.from);
const [single, double] = po.sizes;
const full = po.vacancies === 0;

const title = "Private Offices to Rent in Huyton | Maggie O'Neill Centre";
const description = `Private offices in Huyton from ${from} a month, all bills included, with hosts on site, free meeting room hours and free parking. Maggie O'Neill Centre.`;

const intro = `The Maggie O'Neill Centre in Huyton, Knowsley, has ${po.total} private offices: single offices for ${single.people.replace(' people', '')} and double offices for ${double.people}. Offices cost from ${from} a month on a ${po.lease}, with all bills and utilities included, ${po.freeMeetingHours} free meeting room hours a month, 1Gb fibre WiFi, hosts on site and free parking.${full ? ' All offices are currently let, so join the waitlist and we’ll be in touch when one comes up.' : ''}`;

const keyFacts = [
  { term: 'Price', detail: `From ${from} a month on a ${po.lease}. All bills and utilities included.` },
  { term: 'Sizes', detail: `${single.name}s for ${single.people}, ${double.name.toLowerCase()}s for ${double.people}.` },
  { term: 'Furnished', detail: 'Desks, chairs and filing cabinets.' },
  { term: 'Meeting rooms', detail: `${po.freeMeetingHours} free hours a month, then ${po.meetingDiscount}% off.` },
  { term: 'Deliveries', detail: 'Taken in by our hosts while you’re out.' },
  { term: 'Access', detail: `${hours.summary}, with a late stay on ${po.lateStay}.` },
  { term: 'Parking', detail: `Free ${parking.spaces}-space car park, ${parking.motorway}.` },
  { term: 'Availability', detail: full ? `All ${po.total} offices are let. Join the waitlist.` : 'Ask us what’s available.', href: full ? '#waitlist' : '#enquire', linkText: full ? 'Join the waitlist' : 'Book a viewing' },
];

const faqs = [
  {
    q: 'How much does a private office cost?',
    a: `Private offices at the Maggie O'Neill Centre cost from ${from} a month on a ${po.lease}. All bills and utilities are included.`,
  },
  {
    q: 'Do you have any offices available?',
    a: full
      ? `Not right now. All ${po.total} offices at the Maggie O'Neill Centre are let. Join the waitlist and we'll get in touch when one comes up.`
      : `Call ${contact.phone} or send us a message and we'll tell you what's available.`,
  },
  {
    q: 'What sizes are the offices?',
    a: `There are ${single.name.toLowerCase()}s for ${single.people} and ${double.name.toLowerCase()}s for ${double.people}.`,
  },
  {
    q: "What's included in the price?",
    a: `All bills and utilities, desks, chairs and filing cabinets, 1Gb fibre WiFi, ${po.freeMeetingHours} free meeting room hours a month, hosts on site who take in your deliveries, a shared kitchen fully stocked for making tea and coffee, and free parking.`,
  },
  {
    q: 'Can I book meeting rooms?',
    a: `Yes. Office tenants get ${po.freeMeetingHours} free meeting room hours every month, and ${po.meetingDiscount}% off any hours after that. Rooms range from the ${pod.name}, a boardroom for ${pod.capacity.boardroom}, to rooms for whole teams.`,
  },
  {
    q: 'Can I get into my office outside opening hours?',
    a: `The building is open ${hours.summary}, and there's a late stay on ${po.lateStay}. There's no access outside those hours.`,
  },
  {
    q: 'Do you offer phone systems?',
    a: 'Yes. We can set up a VoIP phone system on your mobiles and laptops for an extra monthly cost. It runs over the internet, so your business number goes wherever you do.',
  },
  {
    q: 'Do you take deliveries?',
    a: "Yes. Our hosts take in deliveries for office tenants and let you know when they've arrived.",
  },
  {
    q: 'Is there parking?',
    a: `Yes. The Maggie O'Neill Centre has a free ${parking.spaces}-space car park on site, ${parking.motorway}, and it is on a main bus route.`,
  },
  {
    q: 'Do you offer hot desking?',
    a: `No. The Maggie O'Neill Centre no longer offers hot desks or coworking. If you only need a room now and then, the ${pod.name} is ${formatPrice(pod.prices!.hour!)} an hour, and a virtual office gives you a business address without an office.`,
  },
];

const reviews = [quotes.simon, quotes.heather, quotes.markK];

const schema = [
  serviceNode({
    url,
    name: 'Private office rental',
    serviceType: 'Private office space for small teams',
    description: intro,
    provider: 'venue',
    areaServed: ['Huyton', 'Knowsley', 'Liverpool', 'Merseyside'],
    offers: [
      {
        name: 'Private office',
        price: po.from,
        unit: 'MONTH',
        description: `A private office from ${from} a month on a ${po.lease}, with all bills and utilities included.`,
      },
    ],
  }),
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Private offices', url },
  ]),
  faqNode(url, faqs),
];
---
<Base title={title} description={description} ogImage={images[102].src} ogImageAlt={images[102].alt} preloadImage={images[102].src} schema={schema}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Private offices', path }]} />

  <Hero
    title="Your own office door, with hosts down the corridor."
    lede="A quiet office with all the bills included, free parking, meeting rooms when you need them and friendly faces in reception. Small teams settle here and stay."
    image={102}
    primary={{ label: full ? 'Join the waitlist' : 'Book a viewing', href: full ? '#waitlist' : '#enquire' }}
    secondary={{ label: `Call ${contact.phone}`, href: contact.phoneHref }}
  >
    {full && <p class="po-status"><span aria-hidden="true">●</span> All {po.total} offices are currently let. <a href="#waitlist">Join the waitlist</a> to hear first when one comes up.</p>}
  </Hero>

  <KeyFacts heading="Private offices, in a few lines" intro={intro} facts={keyFacts} />
  <p class="container updated">Last updated: October 2026</p>

  <section class="section section--cream" aria-labelledby="office-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The offices</span>
        <h2 id="office-heading">What are the offices like?</h2>
        <p>Quiet rooms with a window, furnished with desks, chairs and filing cabinets. Bring your laptop and get on with it.</p>
      </div>
      <ul class="sizes">
        {po.sizes.map((sz) => (
          <li class="card size">
            <h3>{sz.name}</h3>
            <p>For {sz.people}.</p>
          </li>
        ))}
        <li class="card size">
          <h3>From {from} a month</h3>
          <p>On a {po.lease}, with all bills and utilities included.</p>
        </li>
      </ul>
      <ul class="gallery">
        {[100, 101, 104].map((n) => (
          <li><Photo n={n} width={640} height={480} sizes="(max-width: 700px) 100vw, 380px" /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="included-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Around your office</span>
        <h2 id="included-heading">What comes with an office here?</h2>
        <p>The best bit is the building around you.</p>
      </div>
      <ul class="tick-list">
        <li><span>All bills and utilities included in the price.</span></li>
        <li><span>{po.freeMeetingHours} free meeting room hours every month, and {po.meetingDiscount}% off any hours after that.</span></li>
        <li><span>Hosts on site {hours.summary}, who welcome your visitors and take in your deliveries.</span></li>
        <li><span>A late stay on {po.lateStay}.</span></li>
        <li><span>1Gb fibre WiFi throughout the building.</span></li>
        <li><span>A VoIP phone system on your mobiles and laptops, if you want one, for an extra monthly cost.</span></li>
        <li><span>A shared kitchen, fully stocked for making tea and coffee, and free parking for you and your visitors, {parking.motorway}.</span></li>
        <li><span>A calm, clean building, and a charity that puts what you pay back into Knowsley.</span></li>
      </ul>
    </div>
  </section>

  <Reviews reviews={reviews} heading="What do people say about working here?" />

  <section class="section section--cream" aria-labelledby="second-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Growing</span>
        <h2 id="second-heading">Know of a building that could be our second location?</h2>
      </div>
      <div class="prose">
        <p>Our offices are full and the waitlist is growing, so we're looking for a second location. If you know of a commercial property that could work, we'd love to hear about it.</p>
        <p><a href={contact.phoneHref} data-track="phone_click">Call {contact.phone}</a> or <a href={`mailto:${contact.email}`}>email {contact.email}</a>.</p>
      </div>
    </div>
  </section>

  <VirtualOfficeBand />

  <Faqs faqs={faqs} heading="Private office questions" />

  <section class="section section--white more-links" aria-label="Related pages">
    <div class="container">
      <p>
        See also <a href="/services/meeting-rooms/">meeting room hire in Huyton</a>, <a href="/services/virtual-office/">virtual offices</a>, our
        {' '}<a href="/operators-licence/">Knowsley operator licence address</a> for private hire operators, and
        {' '}<a href="/social-value/">where your money goes</a>, or call <a href={contact.phoneHref} data-track="phone_click">{contact.phone}</a>.
      </p>
    </div>
  </section>

  {full ? <OfficeWaitlistForm /> : <FindUs />}
</Base>

<style>
  .po-status { margin-top: 20px; display: inline-flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: var(--radius-pill); background: var(--moc-white); border: 1px solid var(--moc-border); font-size: var(--text-small-size); font-weight: 600; color: var(--moc-purple-900); }
  .po-status span { color: var(--moc-coral-500); }
  .po-status a { font-weight: 700; }
  .two-col { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .sizes { list-style: none; margin: 0 0 24px; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .size { padding: 22px 26px; }
  .size p { margin-top: 6px; color: var(--moc-slate-text); }
  .gallery { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .gallery :global(img) { aspect-ratio: 4 / 3; border-radius: var(--radius-card); width: 100%; height: 100%; object-fit: cover; }
  .prose { display: flex; flex-direction: column; gap: 16px; }
  .updated { margin-top: -40px; margin-bottom: 0; font-size: var(--text-caption-size); color: var(--moc-slate-text); position: relative; }
  .more-links { padding: 40px 0; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } .updated { margin-top: -24px; } }
  @media (max-width: 700px) { .gallery, .sizes { grid-template-columns: 1fr; } }
</style>
