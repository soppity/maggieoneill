---
// Meeting rooms. Spec: Website Blueprint page 6 (Template: Service). Audience: team leads, managers and small businesses
// booking meetings, interviews and away days. Also catches old hot-desking and coworking traffic (301s in netlify.toml):
// hot desking is no longer offered (PROJECT_NOTES), so the Pod is offered by the hour instead.
// No half-day rates (owner, Oct 2026): rooms are hired by the hour or the day.
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Hero from '../../../components/sections/Hero.astro';
import KeyFacts from '../../../components/sections/KeyFacts.astro';
import RoomCards from '../../../components/sections/RoomCards.astro';
import HostedDay from '../../../components/sections/HostedDay.astro';
import Comparison from '../../../components/sections/Comparison.astro';
import VirtualOfficeBand from '../../../components/sections/VirtualOfficeBand.astro';
import Faqs from '../../../components/sections/Faqs.astro';
import FindUs from '../../../components/sections/FindUs.astro';
import Photo from '../../../components/Photo.astro';
import CaseCard from '../../../components/CaseCard.astro';
import { accessibility, accessibilityFaq, booking, catering, contact, formatPrice, hours, layoutTriage, listNames, parking, rateGroups, rooms, site, virtualOffice } from '../../../data/facts';
import { images } from '../../../data/images';
import { caseStudies } from '../../../data/caseStudies';
import { quotes } from '../../../data/reviewQuotes';
import { bookingTermsPath, cancellationSummary } from '../../../data/bookingTerms';
import { breadcrumbNode, faqNode, roomPlaceNode, serviceNode } from '../../../lib/schema';
import Reviews from '../../../components/sections/Reviews.astro';

const path = '/services/meeting-rooms/';
const url = `${site.url}${path}`;
const title = "Meeting Room Hire near Liverpool, Huyton | Maggie O'Neill Centre";

const order = ['pod', 'hub', 'foundry', 'forum', 'summit', 'grove'];
const meetingRooms = order.map((s) => rooms.find((r) => r.slug === s)!);
const pod = rooms.find((r) => r.slug === 'pod')!;
const groups = rateGroups().filter((g) => g.rooms.some((r) => order.includes(r.slug)));
const the = (names: string[]) => listNames(names.map((n) => `the ${n}`));
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);
const rateSentences = groups.map(
  (g) => `${the(g.rooms.filter((r) => order.includes(r.slug)).map((r) => r.name))} ${g.rooms.length > 1 ? 'cost' : 'costs'} ${formatPrice(g.hour)} an hour or ${formatPrice(g.day)} a day`,
);

const description = `Hosted meeting rooms and boardrooms in Huyton, near Liverpool, from the ${pod.name} at ${formatPrice(pod.prices!.hour!)} an hour. Screen, tea and coffee and free parking included, ${parking.motorway}. Maggie O'Neill Centre.`;

const intro = `The Maggie O'Neill Centre is in Huyton. It's 20 to 30 minutes from Liverpool city centre and ${parking.motorway}. We have meeting rooms for a one-to-one in the ${pod.name} or a whole team away day. Rooms cost from ${formatPrice(pod.prices!.hour!)} an hour. There are ${parking.spaces} free parking spaces outside. Every meeting and training room has a screen with Mac and PC wireless casting and HDMI. Self-serve tea and coffee is in the room, and hosts are here all day.`;

const keyFacts = [
  { term: 'Prices', detail: `From ${formatPrice(pod.prices!.hour!)} an hour. Book by the hour or the day. Everything is included.`, href: '#rooms', linkText: 'All room rates' },
  { term: 'Rooms', detail: `${meetingRooms.length} rooms. The ${pod.name} seats ${pod.capacity.boardroom}, and bigger rooms fit whole teams.` },
  { term: 'Good for', detail: 'Team meetings, board meetings, interviews, client meetings and away days.' },
  { term: 'Tech', detail: 'A screen with Mac and PC wireless casting and HDMI. Cables, 1Gb fibre WiFi, a flipchart and pens.' },
  { term: 'Tea and coffee', detail: 'In your room all day. Self-serve and included.' },
  { term: 'Parking', detail: `Free ${parking.spaces}-space car park, ${parking.motorway}.` },
  { term: 'Your hosts', detail: 'Here all day. Just walk in and get started.' },
  { term: 'Cancelling', detail: 'Change a standard booking for free up to 1 business day before.', href: bookingTermsPath, linkText: 'Booking terms' },
];

const faqs = [
  {
    q: 'How much does it cost to hire a meeting room near Liverpool?',
    a: `Meeting rooms at the Maggie O'Neill Centre in Huyton cost from ${formatPrice(pod.prices!.hour!)} an hour. ${rateSentences.map(cap).join('. ')}. Your host, tea and coffee, the screen and free parking are all included.`,
  },
  {
    q: 'Can I book a meeting room by the hour?',
    a: `Yes. You can book every meeting room at the Maggie O'Neill Centre by the hour or the day. There are no half-day rates. A short meeting just costs the hourly rate.`,
  },
  {
    q: 'Do you have a small room for interviews or one-to-ones?',
    a: `Yes. The ${pod.name} at the Maggie O'Neill Centre seats up to ${pod.capacity.boardroom} around an oak table. It has a wall screen. It costs ${formatPrice(pod.prices!.hour!)} an hour or ${formatPrice(pod.prices!.day!)} a day.`,
  },
  {
    q: 'Do you have a boardroom?',
    a: "Yes. The Hub is set as a boardroom. We can set the bigger rooms at the Maggie O'Neill Centre boardroom style too. Tell us your numbers. We'll set the right room before you arrive.",
  },
  {
    q: 'How many people can the meeting rooms hold?',
    a: `It depends on the room and the layout. The ${pod.name} seats ${pod.capacity.boardroom}, and the bigger rooms fit whole teams. ${layoutTriage}`,
  },
  {
    q: 'Do you offer hot desking or coworking?',
    a: `No. The Maggie O'Neill Centre no longer has hot desks or coworking. For a quiet room to work or meet in, the ${pod.name} is ${formatPrice(pod.prices!.hour!)} an hour. For a business address, a virtual office costs from ${formatPrice(virtualOffice.from)} a month.`,
  },
  {
    q: 'Is there a screen in every meeting room?',
    a: "Yes. Every meeting and training room at the Maggie O'Neill Centre has a screen. You can cast to it from a Mac or PC, or plug in with HDMI. We give you the cables. There's 1Gb fibre WiFi, a flipchart and pens too.",
  },
  {
    q: "Is parking free at the Maggie O'Neill Centre?",
    a: `Yes. The Maggie O'Neill Centre has a free ${parking.spaces}-space car park on site. It's ${parking.motorway}, and on a main bus route.`,
  },
  {
    q: 'Can you provide lunch?',
    a: `Yes. ${catering.summary.replace('our partner', "the Maggie O'Neill Centre's partner")}`,
  },
  {
    q: 'Is the venue accessible?',
    a: accessibilityFaq,
  },
  {
    q: 'What happens if I need to cancel?',
    a: cancellationSummary,
  },
  {
    q: 'Can I book a meeting room in the evening or at the weekend?',
    a: `Yes. The Maggie O'Neill Centre is open ${hours.summary}. You can ask us for evening and weekend room hire.`,
  },
];

const reviews = [quotes.anita, quotes.kim, quotes.peter];
const pcn = caseStudies.find((c) => c.slug === 'central-and-south-pcn')!;

const schema = [
  serviceNode({
    url,
    name: 'Meeting room hire',
    serviceType: 'Meeting room and boardroom hire',
    description: intro,
    provider: 'venue',
    areaServed: ['Huyton', 'Knowsley', 'Liverpool', 'Merseyside'],
    catalogName: 'Meeting room hourly rates',
    offers: groups.map((g) => {
      const names = listNames(g.rooms.filter((r) => order.includes(r.slug)).map((r) => r.name));
      return {
        name: `${names}: hourly rate`,
        price: g.hour,
        unit: 'HOUR' as const,
        description: `Hosted hire of the ${names} by the hour, with tea and coffee, the screen and free parking included.`,
      };
    }),
  }),
  ...meetingRooms.map((r) => roomPlaceNode(r, images[r.image]?.src)),
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Meeting rooms', url },
  ]),
  faqNode(url, faqs),
];
---
<Base title={title} description={description} ogImage={images[66].src} ogImageAlt={images[66].alt} preloadImage={images[66].src} schema={schema}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Meeting rooms', path }]} />

  <Hero
    title="Meeting rooms where you walk in, sit down and get on with it."
    lede="A quiet one-to-one in the Pod, or a whole team round the table. Your host has the room ready, the screen on and the coffee poured. From £20 an hour, with free parking, 30 seconds from the M57."
    image={66}
    secondary={{ label: 'See the rooms', href: '#rooms' }}
  />

  <KeyFacts heading="Meeting room hire, in short" intro={intro} facts={keyFacts} />
  <p class="container updated">Last updated: October 2026</p>

  <div id="rooms">
    <RoomCards
      heading="Which meeting rooms can you hire?"
      intro="Every room is hosted and set to your layout. Each has a screen with Mac and PC wireless casting and HDMI. Book by the hour or the day."
      order={order}
    />
  </div>

  <section class="section section--white" aria-labelledby="pod-heading">
    <div class="container two-col two-col--media">
      <div class="media">
        <Photo n={95} width={720} height={540} sizes="(max-width: 900px) 100vw, 520px" />
      </div>
      <div>
        <div class="section-head">
          <span class="eyebrow">The {pod.name}</span>
          <h2 id="pod-heading">Need a small room for an interview or a one-to-one?</h2>
          <p>
            The {pod.name} seats up to {pod.capacity.boardroom} around an oak table. It has a wall screen. It's {formatPrice(pod.prices!.hour!)} an hour or
            {' '}{formatPrice(pod.prices!.day!)} a day. Tea and coffee and free parking are included.
          </p>
        </div>
        <ul class="tick-list">
          <li>Interviews and one-to-ones.</li>
          <li>Client meetings away from the office.</li>
          <li>A quiet room to work or take calls for a few hours.</li>
        </ul>
        <p class="pod__cta"><a class="btn btn--primary" href={booking.url} target="_blank" rel="noopener" data-track="booking_click">Book the {pod.name}</a></p>
      </div>
    </div>
  </section>

  <HostedDay />

  <section class="section section--cream" aria-labelledby="monthly-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Regular meetings</span>
        <h2 id="monthly-heading">Need somewhere for your monthly meetings?</h2>
        <p>
          Boards, partners and teams from different sites meet here every month. It's neutral ground and easy to reach. We set the room
          the same way every time.
        </p>
      </div>
      <CaseCard study={pcn} />
    </div>
  </section>

  <Reviews reviews={reviews} heading="What do people say about meeting here?" />

  <section class="section section--white" aria-labelledby="desk-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Hot desking</span>
        <h2 id="desk-heading">Looking for a hot desk or coworking?</h2>
      </div>
      <div class="prose">
        <p>
          We no longer have hot desks or coworking. Need a quiet room to work, meet a client or take calls? The {pod.name} is
          {' '}{formatPrice(pod.prices!.hour!)} an hour.
        </p>
        <p>
          Need a business address? A <a href="/services/virtual-office/">virtual office</a> gives you a real address in Huyton. It costs from
          {' '}{formatPrice(virtualOffice.from)} a month.
        </p>
      </div>
    </div>
  </section>

  <Comparison />

  <VirtualOfficeBand />

  <Faqs faqs={faqs} heading="Meeting room questions" />

  <section class="section section--white more-links" aria-label="More rooms and services">
    <div class="container">
      <p>
        Running a course? See <a href="/services/training-rooms/">training room hire near Liverpool</a>. Planning something bigger? See
        {' '}<a href="/services/event-space-business-and-community/">events and conferences</a>. You can also see <a href="/whats-included/">everything that's included</a>,
        {' '}<a href="/case-studies/">case studies</a> and our <a href={bookingTermsPath}>booking terms</a>. Or call
        {' '}<a href={contact.phoneHref} data-track="phone_click">{contact.phone}</a>.
      </p>
    </div>
  </section>

  <FindUs />
</Base>

<style>
  .two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .two-col--media { align-items: center; }
  .two-col .section-head { margin-bottom: 24px; }
  .media { margin: 0; }
  .media :global(img) { aspect-ratio: 4 / 3; border-radius: var(--radius-card); }
  .pod__cta { margin-top: 24px; }
  .prose { display: flex; flex-direction: column; gap: 16px; }
  .updated { margin-top: 0; padding-top: 16px; margin-bottom: 0; font-size: var(--text-caption-size); color: var(--moc-slate-text); position: relative; }
  .more-links { padding: 40px 0; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } .updated { margin-top: 0; padding-top: 16px; } }
</style>
