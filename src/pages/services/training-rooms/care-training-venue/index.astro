---
// Care training venue. Spec: Website Blueprint page 3 (Template: Sector) and PROJECT_NOTES.md.
// The pitch for care providers is functional: purpose-built space for mandatory support-worker training.
// "Calm" belongs to the fostering and adoption and Oliver McGowan pages, not here. We host the training; the provider delivers it.
// Hoist training: floor space for a hoist, but no bed is provided.
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Hero from '../../../../components/sections/Hero.astro';
import ProofStrip from '../../../../components/sections/ProofStrip.astro';
import KeyFacts from '../../../../components/sections/KeyFacts.astro';
import ClientLogos from '../../../../components/sections/ClientLogos.astro';
import RoomCards from '../../../../components/sections/RoomCards.astro';
import HostedDay from '../../../../components/sections/HostedDay.astro';
import Reviews from '../../../../components/sections/Reviews.astro';
import CaseCard from '../../../../components/CaseCard.astro';
import { caseStudies } from '../../../../data/caseStudies';
import Faqs from '../../../../components/sections/Faqs.astro';
import FindUs from '../../../../components/sections/FindUs.astro';
import Photo from '../../../../components/Photo.astro';
import NameMarquee from '../../../../components/sections/NameMarquee.astro';
import { accessibility, accessibilityFaq, careClients, contact, formatPrice, layoutTriage, parking, site, trainingDayFrom } from '../../../../data/facts';
import { clientLogos, images } from '../../../../data/images';
import { bookingTermsPath, larger, standard, weekly } from '../../../../data/bookingTerms';
import { breadcrumbNode, faqNode, serviceNode } from '../../../../lib/schema';

const path = '/services/training-rooms/care-training-venue/';
const url = `${site.url}${path}`;

const title = "Care Training Venue, Merseyside | Maggie O'Neill Centre";
const description =
  "Training rooms for care staff training in Huyton: TMVA, safety intervention, hoist, medication and first aid. Set up before you arrive, with free parking.";

const courses = [
  'TMVA and safety intervention',
  'Hoist training, and moving and handling',
  'Medication training',
  'First aid',
  'Safeguarding',
  'Epilepsy awareness',
  'Induction for new support workers',
];

const intro = `Care providers run mandatory training for their support workers at the Maggie O'Neill Centre in Huyton, near Liverpool. They run ${courses
  .slice(0, 4)
  .map((c) => c.charAt(0).toLowerCase() + c.slice(1))
  .join(', ')} and more. Your room is set before your trainer arrives. Self-serve tea and coffee is in the room all day. Parking is free for everyone on the course.`;

const keyFacts = [
  { term: 'Courses', detail: 'TMVA, safety intervention, hoist, medication, first aid, safeguarding and induction.' },
  { term: 'Practical space', detail: 'We clear the room for safety intervention. There\'s floor space for a hoist.' },
  { term: 'Set-up', detail: 'We set your layout and test the screen before your trainer arrives.' },
  { term: 'Repeat dates', detail: 'Just ask, and we\'ll hold regular dates for your training calendar.' },
  { term: 'Prices', detail: `Training rooms from ${formatPrice(trainingDayFrom)} a day. Everything is included.`, href: '/whats-included/', linkText: "See what's included" },
  { term: 'Parking', detail: `Free ${parking.spaces}-space car park, ${parking.motorway}.` },
  { term: 'Invoicing', detail: 'We invoice your organisation. PO numbers are welcome.' },
  { term: 'Access', detail: accessibility.accessLine },
];

const faqs = [
  {
    q: "What care training can we run at the Maggie O'Neill Centre?",
    a: "Care providers run lots of courses at the Maggie O'Neill Centre. They include TMVA, safety intervention, hoist training, moving and handling, medication, first aid, safeguarding, epilepsy awareness and induction training. Your trainer runs the course. We host it.",
  },
  {
    q: 'Is there space for safety intervention and TMVA training?',
    a: "Yes. Tell us it's a practical session. We'll clear the room before you arrive. That gives you open floor space for safety intervention and TMVA training.",
  },
  {
    q: 'Can we run hoist training?',
    a: "Yes. There's floor space for a hoist. Maggie O'Neill Centre doesn't provide a bed. Please bring the kit your session needs.",
  },
  {
    q: 'Can we book the same dates every month?',
    a: 'Yes. Ask us to hold regular dates for your training calendar. Your host will keep the same room, set the same way each time.',
  },
  {
    q: 'How many support workers can we train at once?',
    a: `It depends on the room and how practical the session is. ${layoutTriage}`,
  },
  {
    q: 'How much does a care training room cost?',
    a: `Training rooms at the Maggie O'Neill Centre start at ${formatPrice(trainingDayFrom)} a day. That includes your host, the screen, tea and coffee, and free parking.`,
  },
  {
    q: 'Do you invoice, and do you take purchase orders?',
    a: `Yes. Maggie O'Neill Centre invoices your organisation. PO numbers are welcome. ${larger.paymentMethods.split('. ')[0]}.`,
  },
  {
    q: 'What happens if we need to cancel a training day?',
    a: `${standard.definition} ${standard.points[0].split(' Business days')[0]} Block bookings and courses have their own terms. You'll find them in the booking terms.`,
  },
  {
    q: 'Is there parking for everyone on the course?',
    a: `Yes. There's a free ${parking.spaces}-space car park on site at the Maggie O'Neill Centre, ${parking.motorway}.`,
  },
  {
    q: 'Is the venue accessible?',
    a: accessibilityFaq,
  },
];

const reviews = [
  { quote: 'From booking to the event as easy as possible.', name: 'Anita Johnson' },
  { quote: 'Patrick went above and beyond to make sure everything was perfect.', name: 'Jane Turner' },
  { quote: 'Just off the motorway, on a main bus route.', name: 'Bec Bowden' },
];

const careLogos = clientLogos.filter((l) => [156, 153].includes(l.n));

const careCases = caseStudies.filter((c) => c.sector === 'care');

const schema = [
  serviceNode({
    url,
    name: 'Care training venue hire',
    serviceType: 'Training room hire for care staff and support worker training',
    description: intro,
    provider: 'venue',
    audience: 'Care providers and their learning and development teams',
    areaServed: ['Huyton', 'Knowsley', 'Liverpool', 'Merseyside'],
  }),
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Training rooms', url: `${site.url}/services/training-rooms/` },
    { name: 'Care training venue', url },
  ]),
  faqNode(url, faqs),
];
---
<Base title={title} description={description} ogImage={images[43].src} ogImageAlt={images[43].alt} preloadImage={images[43].src} schema={schema}>
  <Breadcrumbs
    trail={[
      { name: 'Home', path: '/' },
      { name: 'Training rooms', path: '/services/training-rooms/' },
      { name: 'Care training venue', path },
    ]}
  />

  <Hero
    title="Care training, in rooms built for it."
    lede="Your support workers give everything on shift. On training day the room is ready before your trainer arrives. The tea is on. There's free parking right outside. So the day goes well from the start."
    image={43}
    primary={{ label: 'Plan your training dates', href: '#enquire' }}
    secondary={{ label: 'See the rooms', href: '#rooms' }}
  >
    <ProofStrip />
  </Hero>

  <ClientLogos heading="Care providers who train at the Maggie O'Neill Centre" logos={careLogos}>
    <NameMarquee names={careClients} label="More care providers who train at the Maggie O'Neill Centre:" />
  </ClientLogos>

  <KeyFacts heading="Your care training venue, in a few lines" intro={intro} facts={keyFacts} />
  <p class="container updated">Last updated: October 2026</p>

  <section class="section" aria-labelledby="built-heading">
    <div class="container two-col two-col--media">
      <div>
        <div class="section-head">
          <span class="eyebrow">Built for care staff training</span>
          <h2 id="built-heading">What does a care training day need from a venue?</h2>
          <p>A room that's ready. Tech that works. Space for the practical parts. We set all that up every time.</p>
        </div>
        <ul class="tick-list">
          <li>Layouts for both halves of the day. Tables for classroom work, then open floor for practical sessions.</li>
          <li>We test the screen before your trainer walks in. HDMI cables and Mac and PC wireless casting are ready.</li>
          <li>Room for a full group, with a host on site all day if you need anything.</li>
          <li>We hold regular dates for your training calendar. Same room, set the same way.</li>
        </ul>
      </div>
      <div class="media">
        <Photo n={105} width={720} height={540} sizes="(max-width: 900px) 100vw, 520px" />
      </div>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="courses-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Courses we host</span>
        <h2 id="courses-heading">Which care courses run at the Maggie O'Neill Centre?</h2>
        <p>Care providers bring their own trainers and run all of these here. Your trainer runs the course. We host it.</p>
      </div>
      <ul class="courses">
        {courses.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="practical-heading">
    <div class="container two-col two-col--media">
      <div class="media">
        <Photo n={44} width={720} height={540} sizes="(max-width: 900px) 100vw, 520px" />
      </div>
      <div>
        <div class="section-head">
          <span class="eyebrow">Space for practical kit</span>
          <h2 id="practical-heading">Is there room for safety intervention and hoist training?</h2>
          <p>Yes. Tell us what the session involves when you book. We'll set the room for it before you arrive.</p>
        </div>
        <ul class="tick-list">
          <li>We move the tables back for open floor space during safety intervention and TMVA training.</li>
          <li>Floor space for a hoist. We don't provide a bed, so please bring the kit your session needs.</li>
          <li>Free parking right outside, so trainers can unload kit easily.</li>
        </ul>
      </div>
    </div>
  </section>

  <div id="rooms">
    <RoomCards
      heading="Which rooms work for care training?"
      intro="These rooms suit care training days. Tell us your numbers and what the day involves. We'll suggest the right one."
      order={['summit', 'forum', 'community-room', 'foundry', 'grove']}
    />
  </div>

  <HostedDay />

  <section class="section section--cream" aria-labelledby="who-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Who trains here</span>
        <h2 id="who-heading">Which care providers use the Maggie O'Neill Centre?</h2>
        <p>Care providers are our biggest group of customers. Here are two of our regulars.</p>
      </div>
      <div class="stories">
        {careCases.map((c) => <CaseCard study={c} />)}
      </div>
    </div>
  </section>

  <Reviews reviews={reviews} heading="What do trainers and their groups say?" />

  <section class="section section--white" aria-labelledby="booking-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">The practical bits</span>
        <h2 id="booking-heading">How do block bookings and invoicing work?</h2>
      </div>
      <ul class="tick-list">
        <li>{standard.definition} {standard.points[0].split(' Business days')[0]}</li>
        <li>{weekly[0]}</li>
        <li>{weekly[1]} {larger.payment[0].split('. ')[0]}.</li>
        <li>{larger.paymentMethods}</li>
        <li><span>Full details are in our <a href={bookingTermsPath}>booking and cancellation terms</a>.</span></li>
      </ul>
    </div>
  </section>

  <Faqs faqs={faqs} heading="Care training venue questions" />

  <section class="section section--white more-links" aria-label="Related pages">
    <div class="container">
      <p>
        See also our <a href="/services/training-rooms/fostering-adoption-training-venue/">fostering and adoption training venue</a>,
        {' '}<a href="/services/training-rooms/oliver-mcgowan-training-venue/">Oliver McGowan training venue</a> and
        {' '}<a href="/whats-included/">everything that's included</a>. Back to
        {' '}<a href="/services/training-rooms/">training room hire near Liverpool</a>, or call {' '}<a href={contact.phoneHref} data-track="phone_click">{contact.phone}</a>.
      </p>
    </div>
  </section>

  <FindUs />
</Base>

<style>
  .two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .two-col--media { align-items: center; }
  .two-col .section-head { margin-bottom: 24px; }
  .media { margin: 0; }
  .media :global(img) { aspect-ratio: 4 / 3; border-radius: var(--radius-card); }
  .updated { margin-top: 0; padding-top: 16px; margin-bottom: 0; font-size: var(--text-caption-size); color: var(--moc-slate-text); position: relative; }
  .courses { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; align-content: start; }
  .courses li { padding: 12px 18px; border-radius: var(--radius-pill); background: var(--moc-white); color: var(--moc-purple-900); font-weight: 600; }
  .stories { display: grid; gap: 16px; }
  .story { padding: 24px 28px; display: flex; flex-direction: column; gap: 8px; }
  .more-links { padding: 40px 0; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } .updated { margin-top: 0; padding-top: 16px; } }
</style>
