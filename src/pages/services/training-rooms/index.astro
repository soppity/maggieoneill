---
// Training rooms hub: the lead service and main SEO hub. Spec: Website Blueprint page 2 (Template: Service).
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Hero from '../../../components/sections/Hero.astro';
import ProofStrip from '../../../components/sections/ProofStrip.astro';
import KeyFacts from '../../../components/sections/KeyFacts.astro';
import SectorCards from '../../../components/sections/SectorCards.astro';
import RoomCards from '../../../components/sections/RoomCards.astro';
import Layouts from '../../../components/sections/Layouts.astro';
import HostedDay from '../../../components/sections/HostedDay.astro';
import Comparison from '../../../components/sections/Comparison.astro';
import Reviews from '../../../components/sections/Reviews.astro';
import VirtualOfficeBand from '../../../components/sections/VirtualOfficeBand.astro';
import CaseCard from '../../../components/CaseCard.astro';
import { caseStudies } from '../../../data/caseStudies';
import Faqs from '../../../components/sections/Faqs.astro';
import FindUs from '../../../components/sections/FindUs.astro';
import { accessibility, accessibilityFaq, catering, contact, cqcRegistration, formatPrice, halfDay, hours, idealFor, layoutTriage, listNames, parking, rateGroups, rooms, site, trainingDayFrom } from '../../../data/facts';
import { images } from '../../../data/images';
import { bookingTermsPath, cancellationSummary } from '../../../data/bookingTerms';
import { breadcrumbNode, faqNode, roomPlaceNode, serviceNode } from '../../../lib/schema';

const path = '/services/training-rooms/';
const url = `${site.url}${path}`;
const title = "Training Room Hire near Liverpool | Maggie O'Neill Centre";
const description = `Hosted training rooms in Huyton from ${formatPrice(trainingDayFrom)} a day. Set to your layout, screen tested for Mac and PC, tea in the room, free parking. Maggie O'Neill Centre.`;

const pod = rooms.find((r) => r.slug === 'pod')!;
const auditorium = rooms.find((r) => r.slug === 'auditorium')!;
const the = (names: string[]) => listNames(names.map((n) => `the ${n}`));
const groups = rateGroups(['pod']);
const rateSentences = groups.map((g) => `${the(g.rooms.map((r) => r.name))} cost ${formatPrice(g.hour)} an hour or ${formatPrice(g.day)} a day`);
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);

const intro = `Maggie O'Neill Centre is a hosted training venue in Huyton, near Liverpool. Training rooms start at ${formatPrice(trainingDayFrom)} a day. They seat groups from 2 up to ${auditorium.capacity.theatre}. Every meeting and training room has an LED flatscreen you connect to wirelessly, so there are no cords across the room. Self-serve tea and coffee is in the room all day. Parking is free, and hosts are on site all day.`;

const keyFacts = [
  { term: 'Prices', detail: `From ${formatPrice(trainingDayFrom)} a day. Everything is included.`, href: '#rooms', linkText: 'All room rates' },
  { term: 'Group sizes', detail: `From 2 up to ${auditorium.capacity.theatre}. The ${auditorium.name} takes ${auditorium.capacity.cabaret} cabaret or ${auditorium.capacity.theatre} theatre.` },
  { term: 'Layouts', detail: 'U-shape, boardroom, classroom, cabaret, banquet or theatre, set up before you arrive. We\'ll tell you which one works best.' },
  { term: 'Tech', detail: 'Every meeting and training room has an LED flatscreen. Connect wirelessly from a Mac or PC, so there are no cords stretched across the room. HDMI too, plus 1Gb fibre WiFi, a flipchart and pens.' },
  { term: 'Tea and coffee', detail: 'In the room all day. It\'s self-serve and included.' },
  { term: 'Parking', detail: `Free ${parking.spaces}-space car park, ${parking.motorway}, with nearby overflow parking for bigger bookings.` },
  { term: 'Access', detail: accessibility.accessLine },
  { term: 'Hours', detail: `${hours.summary}. ${hours.extra}` },
  { term: 'Cancelling', detail: 'Free to change up to 1 business day before a single-day, single-room booking.', href: bookingTermsPath, linkText: 'Booking terms' },
];

const faqs = [
  {
    q: 'How much does it cost to hire a training room near Liverpool?',
    a: `Training rooms at the Maggie O'Neill Centre start at ${formatPrice(trainingDayFrom)} a day. That includes your host, tea and coffee, the screen and free parking. ${rateSentences.map(cap).join('. ')}. The ${auditorium.name} costs from ${formatPrice(auditorium.prices!.hourFrom!)} an hour.`,
  },
  {
    q: 'How do I check availability?',
    a: `You can check dates and book online in the Maggie O'Neill Centre booking calendar. Or call ${contact.phone} and speak to a host.`,
  },
  {
    q: 'How many people can the training rooms hold?',
    a: `Training rooms at the Maggie O'Neill Centre fit groups from ${pod.capacity.boardroom} in the ${pod.name} to ${auditorium.capacity.cabaret} cabaret style in the ${auditorium.name}. Tell us your numbers. We'll suggest the right room.`,
  },
  {
    q: 'Which layout should I book?',
    a: `You don't need to pick a layout yourself. ${layoutTriage.replace("we'll", "your host at the Maggie O'Neill Centre will")}`,
  },
  {
    q: 'Is there a screen in every training room?',
    a: "Yes. Every meeting and training room at the Maggie O'Neill Centre has an LED flatscreen. You connect to it wirelessly from a Mac or PC, so there are no cords across the room. We have HDMI cables too. You also get 1Gb fibre WiFi, a flipchart and pens.",
  },
  {
    q: 'Are tea and coffee included?',
    a: "Yes. Tea and coffee are in the room all day. It's self-serve, so help yourself. It's included in every booking at the Maggie O'Neill Centre.",
  },
  {
    q: "Is parking free at the Maggie O'Neill Centre?",
    a: `Yes. There's a free ${parking.spaces}-space car park on site at the Maggie O'Neill Centre, ${parking.motorway}. We're on a main bus route too.`,
  },
  {
    q: 'Will someone be there on the day?',
    a: `Yes. Hosts are on site at the Maggie O'Neill Centre all day. They look after your group. You can also call ${contact.phone} and speak to a real person.`,
  },
  {
    q: 'What do I need to bring?',
    a: "Nothing. We have it all ready at the Maggie O'Neill Centre before you arrive. That's the screen, HDMI cables, 1Gb fibre WiFi, flipchart, pens, tea and coffee.",
  },
  {
    q: 'Is the training venue accessible?',
    a: accessibilityFaq,
  },
  {
    q: 'What happens if I need to cancel?',
    a: cancellationSummary,
  },
  {
    q: 'Can I book a half day?',
    a: `${halfDay.replace('There are no half-day rates.', "Maggie O'Neill Centre doesn't have half-day rates.")}`,
  },
  {
    q: 'Can you provide lunch or catering?',
    a: `Yes. ${catering.summary.replace('our partner', "the Maggie O'Neill Centre's partner")}`,
  },
  {
    q: 'Can I hire a training room in the evening or at the weekend?',
    a: `Yes. Maggie O'Neill Centre is open ${hours.summary}. Just ask if you need a room in the evening or at the weekend.`,
  },
];

const reviews = [
  { quote: 'A great and calming atmosphere for the adoption course we have done.', name: 'Fozzer Foz' },
  { quote: 'So easy to get to.', name: 'Jen Murphy', org: 'Rainbow Teaching School Hub' },
  { quote: 'Just off the motorway, on a main bus route.', name: 'Bec Bowden' },
];

const featuredCases = caseStudies.filter((c) => ['amore', 'afg'].includes(c.slug));

const schema = [
  serviceNode({
    url,
    name: 'Training room hire',
    serviceType: 'Training venue hire',
    description: intro,
    provider: 'venue',
    areaServed: ['Huyton', 'Knowsley', 'Liverpool', 'Merseyside'],
    catalogName: 'Training room day rates',
    offers: groups.map((g) => ({
      name: `${listNames(g.rooms.map((r) => r.name))}: day rate`,
      price: g.day,
      unit: 'DAY' as const,
      description: `Hosted day hire of the ${listNames(g.rooms.map((r) => r.name))}, with tea and coffee, the screen and free parking included.`,
    })),
  }),
  ...rooms.map((r) => roomPlaceNode(r, images[r.image]?.src)),
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Training rooms', url },
  ]),
  faqNode(url, faqs),
];
---
<Base title={title} description={description} ogImage={images[105].src} ogImageAlt={images[105].alt} preloadImage={images[105].src} schema={schema}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Training rooms', path }]} />

  <Hero
    title="Training rooms your delegates will ask to come back to."
    lede="You've got enough to think about on a training day. We'll set the room before you arrive. Tea and coffee are ready and the screen works. Parking is free and hosts are here all day. You just deliver."
    image={105}
    secondary={{ label: 'See rooms and prices', href: '#rooms' }}
  >
    <ProofStrip />
  </Hero>

  <KeyFacts heading="Training room hire, in a few lines" intro={intro} facts={keyFacts} />
  <p class="container updated">Last updated: October 2026</p>

  <SectorCards />

  <RoomCards />

  <Layouts />

  <HostedDay />

  <section class="section section--white" aria-labelledby="ideal-heading">
    <div class="container ideal">
      <div class="section-head">
        <span class="eyebrow">Ideal for</span>
        <h2 id="ideal-heading">What kind of training happens here?</h2>
        <p>All kinds of training, for a range of sectors. We host them all.</p>
      </div>
      <ul class="ideal__list">
        {idealFor.map((i) => <li>{i}</li>)}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="cases-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Case studies</span>
        <h2 id="cases-heading">Which care providers train here?</h2>
        <p>Here are two care providers who train their staff at the Maggie O'Neill Centre.</p>
      </div>
      <div class="grid cases">
        {featuredCases.map((c) => <CaseCard study={c} />)}
      </div>
      <p class="cases__others">
        <strong>{cqcRegistration.careProvidersHome} other care providers</strong> call us home for training, office space and CQC registration.
        {' '}<a href={cqcRegistration.path}>How CQC registration works here</a>
      </p>
      <p class="cases__more"><a href="/case-studies/">See all case studies</a></p>
    </div>
  </section>

  <Reviews reviews={reviews} heading="What do trainers and their groups say?" />

  <Comparison />

  <VirtualOfficeBand />

  <Faqs faqs={faqs} heading="Training room questions" />

  <section class="section section--white more-links" aria-label="More rooms and services">
    <div class="container">
      <p>
        Need something different? See <a href="/services/meeting-rooms/">meeting room hire in Huyton</a>,
        {' '}<a href="/services/event-space-business-and-community/">events and conferences</a> in the {auditorium.name}.
        {' '}Or <a href="/visit/">come and see the rooms</a> before you book. Read our <a href={bookingTermsPath}>booking and cancellation terms</a>.
      </p>
    </div>
  </section>

  <FindUs />
</Base>

<style>
  .updated { margin-top: 0; padding-top: 16px; margin-bottom: 0; font-size: var(--text-caption-size); color: var(--moc-slate-text); position: relative; }
  .ideal { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(24px, 5vw, 64px); align-items: center; }
  .ideal .section-head { margin-bottom: 0; }
  .ideal__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .ideal__list li { padding: 12px 20px; border-radius: var(--radius-pill); background: var(--moc-purple-tint); color: var(--moc-purple-900); font-weight: 600; }
  .cases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cases__others { margin-top: 28px; padding: 18px 22px; border-radius: var(--radius-card); background: var(--moc-purple-tint); font-size: var(--text-lead-size); }
  .cases__others a { font-weight: 700; white-space: nowrap; }
  .cases__more { margin-top: 24px; font-weight: 700; }
  .more-links { padding: 40px 0; }
  @media (max-width: 900px) { .ideal, .cases { grid-template-columns: 1fr; } .updated { margin-top: 0; padding-top: 16px; } }
</style>
