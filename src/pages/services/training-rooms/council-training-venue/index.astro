---
// Councils, schools and public sector training. Spec: Website Blueprint page 5 (Template: Sector) and PROJECT_NOTES.md.
// Job: win local public-sector training with social value and the borough link. Schools: Meadow Park Primary,
// Alt Bridge, Knowsley Central. We host the training; the council or school delivers it.
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Hero from '../../../../components/sections/Hero.astro';
import KeyFacts from '../../../../components/sections/KeyFacts.astro';
import ClientLogos from '../../../../components/sections/ClientLogos.astro';
import RoomCards from '../../../../components/sections/RoomCards.astro';
import HostedDay from '../../../../components/sections/HostedDay.astro';
import Reviews from '../../../../components/sections/Reviews.astro';
import CaseCard from '../../../../components/CaseCard.astro';
import { caseStudies } from '../../../../data/caseStudies';
import Faqs from '../../../../components/sections/Faqs.astro';
import FindUs from '../../../../components/sections/FindUs.astro';
import Photo from '../../../../components/Photo.astro';
import { accessibility, accessibilityFaq, contact, formatPrice, lastYear, layoutTriage, parking, rooms, site, trainingDayFrom } from '../../../../data/facts';
import { clientLogos, images, schoolLogos } from '../../../../data/images';
import { bookingTermsPath, larger, standard } from '../../../../data/bookingTerms';
import { breadcrumbNode, faqNode, serviceNode } from '../../../../lib/schema';

const path = '/services/training-rooms/council-training-venue/';
const url = `${site.url}${path}`;
const hourFrom = Math.min(...rooms.filter((r) => r.slug !== 'pod' && r.prices?.hour).map((r) => r.prices!.hour!));

const title = "Council & CPD Training, Knowsley | Maggie O'Neill Centre";
const description =
  "Training and team days for Knowsley Council, housing and schools, in the borough. Hosted rooms, free parking and social value built in. Maggie O'Neill Centre.";

const intro = `The Maggie O'Neill Centre is a Knowsley charity in Huyton, ${parking.motorway}. Knowsley Council teams, Livv Housing and local schools book its training rooms for training days, CPD and team meetings. Hosts are on site all day, tea and coffee are served in the room, parking is free, and every booking funds Maggie's Meals in the borough.`;

const keyFacts = [
  { term: 'Who uses it', detail: 'Knowsley Council, Livv Housing and local schools.' },
  { term: 'Social value', detail: "A registered charity. Every booking funds Maggie's Meals in Knowsley." },
  { term: 'Sessions', detail: 'Training days, CPD, INSET days, Knowsley Education days and governor meetings.' },
  { term: 'Prices', detail: `From ${formatPrice(hourFrom)} an hour or ${formatPrice(trainingDayFrom)} a day, everything included.`, href: '/whats-included/', linkText: "See what's included" },
  { term: 'Invoicing', detail: 'Invoices to your council, school or organisation, with PO numbers welcome.' },
  { term: 'Parking', detail: `Free ${parking.spaces}-space car park, ${parking.motorway}.` },
  { term: 'Your hosts', detail: 'On site all day, looking after your team.' },
  { term: 'Access', detail: accessibility.accessLine },
];

const faqs = [
  {
    q: "Who in the public sector uses the Maggie O'Neill Centre?",
    a: "Knowsley Council teams, Livv Housing, and schools including Meadow Park Primary, Alt Bridge School and Knowsley Central School book training rooms at the Maggie O'Neill Centre.",
  },
  {
    q: 'How does booking here add social value?',
    a: "The Maggie O'Neill Centre is a registered charity in Knowsley. What you pay for the room funds Maggie's Meals and community support in the borough, so the spend stays local.",
  },
  {
    q: 'Can you provide social value information for our procurement?',
    a: `Yes. The Maggie O'Neill Centre's social value statement is on the social value page, written to copy straight into your procurement or social value report. Call ${contact.phone} with any questions.`,
  },
  {
    q: 'Can schools book INSET days here?',
    a: "Yes. Schools book the Maggie O'Neill Centre for INSET days, staff CPD, SEND training and governor meetings, and Knowsley Education hosts days here too. Your school delivers the session, and we host it.",
  },
  {
    q: 'Do you invoice, and do you take purchase orders?',
    a: `Yes. The Maggie O'Neill Centre invoices your council, school or organisation, and PO numbers are welcome. ${larger.paymentMethods.split('. ')[0]}.`,
  },
  {
    q: 'How much does a training room cost?',
    a: `Training rooms at the Maggie O'Neill Centre cost from ${formatPrice(hourFrom)} an hour or ${formatPrice(trainingDayFrom)} a day, with on-site hosts, the screen, tea and coffee, and free parking included.`,
  },
  {
    q: 'How many people can we bring?',
    a: `It depends on the room and the layout. ${layoutTriage}`,
  },
  {
    q: 'What happens if we need to cancel?',
    a: `${standard.definition} ${standard.points[0].split(' Business days')[0]} Larger bookings and courses have their own terms, set out in the booking terms.`,
  },
  {
    q: 'Is there parking?',
    a: `Yes. The Maggie O'Neill Centre has a free ${parking.spaces}-space car park on site, ${parking.motorway}.`,
  },
  {
    q: 'Is the venue accessible?',
    a: accessibilityFaq,
  },
];

const reviews = [
  { quote: 'So easy to get to.', name: 'Jen Murphy', org: 'Rainbow Teaching School Hub' },
  { quote: 'A wonderful place where the community can gather.', name: 'Sufiah Abbasi' },
  { quote: 'From booking to the event as easy as possible.', name: 'Anita Johnson' },
];

const publicLogos = clientLogos.filter((l) => [149, 150, 152].includes(l.n));

const schema = [
  serviceNode({
    url,
    name: 'Council, school and public sector training venue hire',
    serviceType: 'Training room hire for councils, schools, housing associations and the public sector',
    description: intro,
    provider: 'venue',
    audience: 'Councils, schools, housing associations and public sector teams',
    areaServed: ['Huyton', 'Knowsley', 'Liverpool', 'Merseyside'],
  }),
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Training rooms', url: `${site.url}/services/training-rooms/` },
    { name: 'Council and public sector training', url },
  ]),
  faqNode(url, faqs),
];
---
<Base title={title} description={description} ogImage={images[114].src} ogImageAlt={images[114].alt} preloadImage={images[114].src} schema={schema}>
  <Breadcrumbs
    trail={[
      { name: 'Home', path: '/' },
      { name: 'Training rooms', path: '/services/training-rooms/' },
      { name: 'Council and public sector training', path },
    ]}
  />

  <Hero
    title="Council and public sector training in Knowsley"
    tagline="Train in the borough, and the spend stays local."
    lede="The Maggie O'Neill Centre is a Knowsley charity. Every booking funds Maggie's Meals, a few streets from where your teams work."
    image={114}
    primary={{ label: 'Get the social value statement', href: '/social-value/#statement' }}
    secondary={{ label: 'See the rooms', href: '#rooms' }}
  />

  <ClientLogos heading="Public sector organisations that use the Maggie O'Neill Centre" logos={[...publicLogos, ...schoolLogos]} />

  <KeyFacts heading="Your public sector training venue, in a few lines" intro={intro} facts={keyFacts} />
  <p class="container updated">Last updated: October 2026</p>

  <section class="section section--cream" aria-labelledby="value-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Social value</span>
        <h2 id="value-heading">How does booking here add social value?</h2>
        <p>
          The Maggie O'Neill Centre is a registered charity (no. {site.charityNumber}) in Knowsley. What you pay for the room funds Maggie's Meals
          and community support in the borough, so your training budget stays local.
        </p>
      </div>
      <div>
        <p class="stats__label">In the last year</p>
        <dl class="stats">
          <div><dt>rooms hired</dt><dd>{lastYear.roomsHired}</dd></div>
          <div><dt>businesses served</dt><dd>{lastYear.businessesServed}</dd></div>
          <div><dt>people accessed Maggie's Meals</dt><dd>{lastYear.mealsAccessed}</dd></div>
        </dl>
        <p class="stats__more"><a href="/social-value/">Social value at the Maggie O'Neill Centre</a></p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="schools-heading">
    <div class="container two-col two-col--media">
      <div>
        <div class="section-head">
          <span class="eyebrow">For schools</span>
          <h2 id="schools-heading">Can schools use the Maggie O'Neill Centre?</h2>
          <p>Yes. Meadow Park Primary, Alt Bridge School and Knowsley Central School all book here.</p>
        </div>
        <ul class="tick-list">
          <li>INSET days for the whole staff team.</li>
          <li>Staff CPD and SEND training.</li>
          <li>Governor meetings.</li>
          <li>Days hosted by Knowsley Education.</li>
          <li>Free parking for every member of staff, and the room set before anyone arrives.</li>
        </ul>
      </div>
      <div class="media">
        <Photo n={67} width={720} height={540} sizes="(max-width: 900px) 100vw, 520px" />
      </div>
    </div>
  </section>

  <div id="rooms">
    <RoomCards
      heading="Which rooms can public sector teams hire?"
      intro="Every room is hosted and set to your layout. Meeting and training rooms have a screen with Mac and PC wireless casting and HDMI, and the Auditorium has a stage, sound system and technician-run AV. Prices include everything on the Hosted Day list."
      order={['auditorium', 'summit', 'forum', 'community-room', 'foundry', 'grove', 'hub']}
    />
  </div>

  <HostedDay />

  <section class="section section--white" aria-labelledby="livv-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Case study</span>
        <h2 id="livv-heading">How does Livv Housing Group use the Maggie O'Neill Centre?</h2>
        <p>For over 14 years: leadership training, department meetings, company-wide programmes and the overflow when their own rooms are full.</p>
      </div>
      <CaseCard study={caseStudies.find((c) => c.slug === 'livv-housing-group')!} />
    </div>
  </section>

  <Reviews reviews={reviews} heading="What do people say about the Maggie O'Neill Centre?" />

  <Faqs faqs={faqs} heading="Council and public sector venue questions" />

  <section class="section section--white more-links" aria-label="Related pages">
    <div class="container">
      <p>
        See also <a href="/social-value/">social value</a>, <a href="/community/">Maggie's Meals and community</a>,
        {' '}<a href="/services/event-space-business-and-community/">events in the Auditorium</a>, our <a href={bookingTermsPath}>booking terms</a> and
        {' '}<a href="/whats-included/">everything that's included</a>. Back to
        {' '}<a href="/services/training-rooms/">training room hire near Liverpool</a>, or call {' '}<a href={contact.phoneHref} data-track="phone_click">{contact.phone}</a>.
      </p>
    </div>
  </section>

  <FindUs />
</Base>

<style>
  .two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .two-col--media { align-items: center; }
  .two-col .section-head { margin-bottom: 24px; }
  .media { margin: 0; }
  .media :global(img) { aspect-ratio: 4 / 3; border-radius: var(--radius-card); }
  .updated { margin-top: -40px; margin-bottom: 0; font-size: var(--text-caption-size); color: var(--moc-slate-text); position: relative; }
  .stats__label { font-size: var(--text-eyebrow-size); font-weight: 600; letter-spacing: var(--text-eyebrow-tracking); text-transform: uppercase; color: var(--moc-purple-700); }
  .stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin: 12px 0 0; }
  .stats div { display: flex; flex-direction: column-reverse; gap: 6px; }
  .stats dd { margin: 0; font: 800 clamp(36px, 5vw, 52px)/1 var(--font-display); color: var(--moc-purple-900); }
  .stats dt { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  .stats__more { margin-top: 24px; font-weight: 700; }
  .more-links { padding: 40px 0; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } .updated { margin-top: -24px; } }
  @media (max-width: 520px) { .stats { grid-template-columns: 1fr; } }
</style>
