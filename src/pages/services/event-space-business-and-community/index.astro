---
// Events and conferences. Spec: Website Blueprint page 7 (Template: Service). Keep this URL: it has search history.
// Job: sell the Auditorium (60 cabaret, 100 theatre) and the Grove for launches, talks, networking and community events.
// Oct 2026: conference and corporate searches moved to /services/conference-venue/, so this page leads on events.
// Owner, Oct 2026: business, training and community events only. Not a party or function venue.
// Auditorium pricing is "from £100 an hour", quoted per event (owner, Oct 2026).
// Owner, Oct 2026: lectern, mics and sound system confirmed; AV run by a technician; no wireless casting in the Auditorium
// itself (breakout spaces have it). Breakout: the Grove, the Auditorium foyer, as many extra spaces as needed, and open
// space at the back of the Auditorium. The events Hosted Day is facts.hostedEvent.
// Owner, Oct 2026 (revamp): catering through our partner first, own catering only by prior approval; the technician is
// charged, shown as (£); events are hourly with a 3-hour minimum, or a day rate (no half days). Features, testimonials
// and the 10 FAQs below come from the old events page, rewritten in house voice. The full list lives at ./faqs/.
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Hero from '../../../components/sections/Hero.astro';
import KeyFacts from '../../../components/sections/KeyFacts.astro';
import ClientLogos from '../../../components/sections/ClientLogos.astro';
import HostedDay from '../../../components/sections/HostedDay.astro';
import Comparison from '../../../components/sections/Comparison.astro';
import Faqs from '../../../components/sections/Faqs.astro';
import FindUs from '../../../components/sections/FindUs.astro';
import Photo from '../../../components/Photo.astro';
import { accessibility, accessibilityFaq, catering, contact, formatPrice, hostedEvent, hours, parking, rooms, site } from '../../../data/facts';
import { images } from '../../../data/images';
import { bookingTermsPath, exceptional, larger } from '../../../data/bookingTerms';
import { breadcrumbNode, faqNode, roomPlaceNode, serviceNode } from '../../../lib/schema';

const path = '/services/event-space-business-and-community/';
const url = `${site.url}${path}`;
const auditorium = rooms.find((r) => r.slug === 'auditorium')!;
const grove = rooms.find((r) => r.slug === 'grove')!;
const cab = auditorium.capacity.cabaret!;
const theatre = auditorium.capacity.theatre!;
const from = formatPrice(auditorium.prices!.hourFrom!);

const title = "Event Space Hire near Liverpool | Maggie O'Neill Centre";
const description = `Event space hire in Huyton, near Liverpool: a ${theatre}-seat Auditorium with a stage and sound system, the Grove for networking, and ${parking.spaces} free parking spaces.`;

const intro = `The Maggie O'Neill Centre in Huyton, near Liverpool, hosts launches, talks, networking and community events. The ${auditorium.name} seats up to ${theatre} theatre style (rows) or ${cab} cabaret (small round tables). It has a stage, lectern, microphones and sound system. A technician runs the AV (£). It costs from ${from} an hour, with a 3-hour minimum. Or we quote a day rate for your event. Six breakout rooms can run sessions at the same time. Hosts check on your event all day. Our catering partner can feed everyone. There are ${parking.spaces} free parking spaces outside.`;

const keyFacts = [
  { term: 'Capacity', detail: `Up to ${theatre} theatre style or ${cab} cabaret in the ${auditorium.name}.` },
  { term: 'Prices', detail: `From ${from} an hour (3-hour minimum), or a day rate. We quote for your event.` },
  { term: 'On stage', detail: 'A stage, lectern, microphones, sound system and lighting. A technician runs the AV (£).' },
  { term: 'Breakout rooms', detail: `Six breakout rooms, including the ${grove.name}. Plus the Pod, the Auditorium foyer and space at the back of the hall.` },
  { term: 'Catering', detail: `From our partner, ${catering.partner}. Your own food only if we agree it first.` },
  { term: 'Parking', detail: `Free ${parking.spaces}-space car park, ${parking.motorway}. Plus ${parking.overflow}.` },
  { term: 'Your hosts', detail: 'We talk your event through first. Then hosts check on it all day.' },
  { term: 'Access', detail: accessibility.accessLine },
];

const faqs = [
  {
    q: 'Is there enough parking on site?',
    a: `Yes. There's a free ${parking.spaces}-space car park right outside. That's rare at our prices. Usually only big city conference centres have their own. For bigger events, there's an overflow car park across the main road. A parking attendant will show your guests where to go.`,
  },
  {
    q: 'What are your opening hours for events?',
    a: `We're open ${hours.summary}. We're flexible about setting up early and clearing away late. You can ask us for evening and weekend events. Tell us your times and we'll do our best to fit them.`,
  },
  {
    q: 'Can we bring our own catering?',
    a: `We mainly work with our catering partner, ${catering.partner}. That keeps the food and service the same high standard. Have a special request? Talk to us first. Sometimes we can agree other plans.`,
  },
  {
    q: 'Is catering available on site?',
    a: `Yes. Tea and coffee are included all day, in or near every space you book. For food, ${catering.partner} can make a menu for your event. They do vegetarian, vegan and gluten-free options. You order from them and pay them directly. We'll put you in touch when you book.`,
  },
  {
    q: 'What AV equipment is in the Auditorium?',
    a: `The ${auditorium.name} has a stage, a lectern, microphones, a projector, a sound system and lighting. A technician sets up and runs the AV on the day. You pay for this, and every Auditorium booking needs it. Tell us what your speakers need. We'll have it ready before you arrive.`,
  },
  {
    q: 'What is your cancellation policy?',
    a: `Events count as larger bookings. ${larger.chargeable} ${larger.reschedule} ${exceptional}`,
  },
  {
    q: 'Do you need a deposit, and what are the payment terms?',
    a: `Yes. ${larger.payment[0]} ${larger.payment[1]} ${larger.payment[2]} ${larger.paymentMethods}`,
  },
  {
    q: 'What is included in the room hire?',
    a: `We talk your event through with you first. We set the rooms to your layout, and hosts check on you all day. You get tea and coffee in or near every space. Every breakout room has a screen or projector, cables and a flipchart. There's 1Gb fibre WiFi and free parking. The Auditorium technician and food cost extra.`,
  },
  {
    q: 'How do I check availability or arrange a visit?',
    a: `Call ${contact.phone}, email ${contact.email}, or use the form on this page. Want to see the space first? We do tours every weekday. Just shout.`,
  },
  {
    q: 'Do you host parties or private functions?',
    a: "No. The Maggie O'Neill Centre hosts business, training and community events only. We don't take bookings for parties or private functions.",
  },
  {
    q: 'What is the total capacity of the venue?',
    a: `The ${auditorium.name} seats up to ${theatre} theatre style, or ${cab} cabaret at tables. Layouts with tables cost extra. On top of that, there are six breakout rooms for 20 to 30 people each, theatre style. And the Pod seats up to 4.`,
  },
];

// Old events page features (owner, Oct 2026), in house voice.
const features = [
  {
    image: 118,
    title: `A ${theatre}-seat Auditorium`,
    text: 'The heart of the building. It\'s warm, comfy and set up before anyone arrives. Toilets are just outside the doors. Tea and coffee are in the foyer all day, so nobody goes without.',
  },
  {
    image: 182,
    title: 'Auditorium AV',
    text: 'A pro sound system for the big moments. It plays music and has microphones for up to six people at once. Panels, awards and launches sound as good as they look. A technician (£) runs it on the day.',
  },
  {
    image: 66,
    title: 'Six breakout rooms',
    text: "Day to day, we're a meeting and training venue. So every room already has what you need. Solicitors, care companies and charities use them every week. Your sessions can run side by side.",
  },
  {
    image: 185,
    title: `${parking.spaces} free parking spaces`,
    text: "Free parking right outside. You rarely find that at our prices. Usually only big city conference centres have their own. For bigger events, there's an overflow car park across the road.",
  },
  {
    image: 54,
    title: 'AV in every space',
    text: 'Every room has a screen or projector, cables, a flipchart and paper. Tea and coffee are close by. So side-by-side sessions run without a hitch.',
  },
];

// Testimonials from the old events page (owner, Oct 2026). Word for word, trimmed at sentence ends.
const testimonials = [
  {
    quote: 'It’s a lovely place – people felt really relaxed, which naturally led to loads of chatting. The ambiance was great and really helped set the tone for what was always meant to be a relaxed gig.',
    name: 'Craig Brougham',
    org: 'Adoption in Merseyside',
  },
  {
    quote: 'We have had the pleasure of using the Centre on numerous occasions, and couldn’t be happier with the experience. They are extremely dedicated, professional, and approachable, nothing is too much trouble!',
    name: 'Suzanne Steele',
    org: 'Primary Care Knowsley',
  },
  {
    quote: 'Everyone you encounter is helpful, kind and generous with their advice and support. They communicate in a timely manner, and nothing is too much trouble.',
    name: 'Penny France',
    org: 'Knowsley Education',
  },
];


const schema = [
  serviceNode({
    url,
    name: 'Event space hire',
    serviceType: 'Event and networking venue hire',
    description: intro,
    provider: 'venue',
    areaServed: ['Huyton', 'Knowsley', 'Liverpool', 'Merseyside'],
    offers: [
      {
        name: `${auditorium.name} hire`,
        price: auditorium.prices!.hourFrom!,
        unit: 'HOUR',
        description: `Hosted hire of the ${auditorium.name}, from ${from} an hour, quoted per event.`,
      },
    ],
  }),
  roomPlaceNode(auditorium, images[auditorium.image]?.src),
  roomPlaceNode(grove, images[grove.image]?.src),
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Event space hire', url },
  ]),
  faqNode(url, faqs),
];
---
<Base title={title} description={description} ogImage={images[181].src} ogImageAlt={images[181].alt} preloadImage={images[181].src} schema={schema}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Event space hire', path }]} />

  <Hero
    title="Event space for launches, talks and community events."
    lede="A proper stage, a sound system and a team who care how your event goes. We'll talk it through with you first. Then we're here all day, so it goes the way you planned."
    image={181}
    primary={{ label: 'Plan your event', href: '#enquire' }}
    secondary={{ label: `Call ${contact.phone}`, href: contact.phoneHref }}
  />

  <ClientLogos heading="Organisations that host events and training here" />

  <KeyFacts heading="Event venue hire, in short" intro={intro} facts={keyFacts} />
  <p class="container updated">Last updated: October 2026</p>

  <section class="section section--white" aria-labelledby="features-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Features</span>
        <h2 id="features-heading">Does the venue have everything you need?</h2>
        <p>Here's what comes with the building. Don't see something? Just ask.</p>
      </div>
      <ul class="grid features">
        {features.map((f) => (
          <li class="card feature">
            <Photo n={f.image} width={560} height={420} sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 280px" />
            <div class="feature__body">
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="aud-heading">
    <div class="container two-col two-col--media">
      <div class="media">
        <Photo n={113} width={720} height={540} sizes="(max-width: 900px) 100vw, 520px" />
      </div>
      <div>
        <div class="section-head">
          <span class="eyebrow">The {auditorium.name}</span>
          <h2 id="aud-heading">What is the Auditorium like?</h2>
          <p>A proper hall for talks, launches and community events. We set it the way you need before your guests arrive. Running a conference? See our <a href="/services/conference-venue/">conference venue near Liverpool</a>.</p>
        </div>
        <ul class="tick-list">
          <li>Up to {theatre} theatre style, or {cab} cabaret style at tables.</li>
          <li>A stage, lectern, microphones, sound system and lighting.</li>
          <li>AV set up and run by a technician on the day (£).</li>
          <li>From {from} an hour (3-hour minimum), or a day rate. We quote for your event.</li>
          <li>Toilets just outside the doors. An accessible toilet on the same floor.</li>
          <li>Tea and coffee in the foyer.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="grove-heading">
    <div class="container two-col two-col--media">
      <div>
        <div class="section-head">
          <span class="eyebrow">Breakout and networking</span>
          <h2 id="grove-heading">Where can guests break out and network?</h2>
          <p>Six breakout rooms for side-by-side sessions, plus space to mingle. Every breakout room has a flatscreen with wireless casting.</p>
        </div>
        <ul class="tick-list">
          <li><span>The {grove.name}, one of the six breakout rooms. It has a canopy of greenery. Good for standing, mingling and chatting over drinks.</span></li>
          <li><span>The Auditorium foyer, right outside the hall.</span></li>
          <li><span>Open networking space at the back of the {auditorium.name}. Handy if you don't need the whole room.</span></li>
          <li><span>Six breakout rooms for 20 to 30 people each, and the Pod for up to 4.</span></li>
        </ul>
      </div>
      <div class="media">
        <Photo n={183} width={720} height={540} sizes="(max-width: 900px) 100vw, 520px" />
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="food-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Food and drink</span>
        <h2 id="food-heading">Can you cater for an event?</h2>
      </div>
      <div class="prose">
        <p>Our catering partner, {catering.partner}, can make a menu for your event. They do vegetarian, vegan and gluten-free options. You order from them and pay them directly. We'll put you in touch when you book.</p>
        <p>We mainly work with {catering.partner}. That keeps the food and service the same high standard. Have a special request? Talk to us first. Sometimes we can agree other plans.</p>
        <p>There's a fridge to keep food in. Tea and coffee are included all day, in or near every space you book.</p>
      </div>
    </div>
  </section>

  <HostedDay
    image={114}
    caption="A talk in the Auditorium, with the welcome screen up and the lighting set."
    items={hostedEvent}
    heading="What's included when you book an event?"
    intro="Every event and Auditorium booking at the Maggie O'Neill Centre comes with all of this."
  />

  <Comparison />

  <section class="section" aria-labelledby="testimonials-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Testimonials</span>
        <h2 id="testimonials-heading">What do event organisers say?</h2>
      </div>
      <div class="grid testimonials">
        {testimonials.map((t) => (
          <figure class="card testimonial">
            <blockquote>“{t.quote}”</blockquote>
            <figcaption>{t.name}<span>, {t.org}</span></figcaption>
          </figure>
        ))}
      </div>
      <p class="testimonials__more"><a href="/reviews/">Read our Google reviews</a></p>
    </div>
  </section>

  <Faqs faqs={faqs} heading="Event venue questions" />

  <section class="section section--cream all-faqs" aria-label="All event FAQs">
    <div class="container">
      <div class="all-faqs__inner">
        <p>Numbers, layouts, AV, food, deposits, cancelling and more. Every question organisers ask us.</p>
        <a class="btn btn--primary" href="/services/event-space-business-and-community/faqs/">See all event FAQs</a>
      </div>
    </div>
  </section>

  <section class="section section--white more-links" aria-label="Related pages">
    <div class="container">
      <p>
        See also our <a href="/services/conference-venue/">conference venue near Liverpool</a>,
        {' '}<a href="/services/meeting-rooms/">meeting room hire in Huyton</a>,
        {' '}<a href="/services/training-rooms/council-training-venue/">council and public sector events</a>,
        {' '}<a href="/whats-included/">everything that's included</a> and our <a href={bookingTermsPath}>booking terms</a>. Or call
        {' '}<a href={contact.phoneHref} data-track="phone_click">{contact.phone}</a>.
      </p>
    </div>
  </section>

  <FindUs />
</Base>

<style>
  /* Five cards: the two Auditorium cards lead, wider, then three across. */
  .features { list-style: none; margin: 0; padding: 0; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .feature { grid-column: span 2; }
  .feature:nth-child(-n + 2) { grid-column: span 3; }
  .feature { overflow: hidden; display: flex; flex-direction: column; }
  .feature :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .feature__body { padding: 22px 24px 26px; display: flex; flex-direction: column; gap: 8px; }
  .feature__body h3 { font-size: 20px; }
  .feature__body p { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  .testimonials { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .testimonial { margin: 0; padding: 28px; display: flex; flex-direction: column; gap: 16px; }
  .testimonial blockquote { margin: 0; font: 600 18px/1.5 var(--font-display); color: var(--moc-purple-900); }
  .testimonial figcaption { margin-top: auto; font-weight: 700; font-size: var(--text-small-size); }
  .testimonial figcaption span { font-weight: 500; color: var(--moc-slate-text); }
  .testimonials__more { margin-top: 20px; font-weight: 700; }
  @media (max-width: 1100px) { .features { grid-template-columns: 1fr 1fr; } .feature, .feature:nth-child(-n + 2) { grid-column: auto; } .feature:last-child { grid-column: 1 / -1; } .feature:last-child :global(img) { aspect-ratio: 16 / 7; } }
  @media (max-width: 900px) { .testimonials { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .features { grid-template-columns: 1fr; } .feature:last-child :global(img) { aspect-ratio: 4 / 3; } }
  .all-faqs { padding-top: 0; }
  .all-faqs__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 22px 28px; border-radius: var(--radius-card); background: var(--moc-white); box-shadow: var(--moc-shadow-card); }
  .all-faqs__inner p { margin: 0; font-size: var(--text-lead-size); }
  .two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .two-col--media { align-items: center; }
  .two-col .section-head { margin-bottom: 24px; }
  .media { margin: 0; }
  .media :global(img) { aspect-ratio: 4 / 3; border-radius: var(--radius-card); }
  .prose { display: flex; flex-direction: column; gap: 16px; }
  .updated { margin-top: 0; padding-top: 16px; margin-bottom: 0; font-size: var(--text-caption-size); color: var(--moc-slate-text); position: relative; }
  .more-links { padding: 40px 0; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } .updated { margin-top: 0; padding-top: 16px; } }
</style>
