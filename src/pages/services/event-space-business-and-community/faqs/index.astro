---
// Events FAQs: the full list from the owner (Oct 2026), kept off the main events page so it stays short.
// Wording is the owner's, lightly edited for UK spelling and house style. Q8 and Q9 use the booking terms in
// bookingTerms.ts (the owner asked for the updated policy there). Schema: FAQPage + BreadcrumbList.
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Faqs from '../../../../components/sections/Faqs.astro';
import CtaBand from '../../../../components/sections/CtaBand.astro';
import { accessibility, catering, contact, hours, parking, site } from '../../../../data/facts';
import { exceptional, larger } from '../../../../data/bookingTerms';
import { images } from '../../../../data/images';
import { breadcrumbNode, faqNode } from '../../../../lib/schema';

const parent = '/services/event-space-business-and-community/';
const path = `${parent}faqs/`;
const url = `${site.url}${path}`;
const title = "Event Venue FAQs, Huyton | Maggie O'Neill Centre";
const description =
  "Everything event organisers ask about the Maggie O'Neill Centre: capacity, layouts, AV, catering, parking, access, deposits and cancellations.";

const groups = [
  {
    title: 'Venue and room sizes',
    faqs: [
      {
        q: 'What is the total capacity of your venue?',
        a: "Our main Auditorium seats up to 100 people. We also have six breakout rooms, including the Grove. Each takes 20 to 30 guests, theatre style. Then there's the Pod, a smaller room for up to 4 people.",
      },
      {
        q: 'Can the Auditorium be set in different layouts (theatre, classroom, banquet and so on)?',
        a: "Yes. We can move the Auditorium seats to suit your event. It's set theatre style as standard. Layouts that need tables cost extra.",
      },
      {
        q: 'Can the breakout rooms be used at the same time?',
        a: 'Yes. Lots of breakout sessions can run at once. Each room has its own screen and sound, so it works on its own.',
      },
    ],
  },
  {
    title: 'Booking and dates',
    faqs: [
      {
        q: 'How do I check dates or arrange a visit?',
        a: `Call our team on ${contact.phone} or email ${contact.email} to check dates. Want to see the space? Call, email or fill in the form. We'll gladly show you round.`,
      },
      {
        q: 'How far ahead should I book?',
        a: "Book as soon as you know your date. For bigger events, try to book a few months ahead. We're a meeting and training venue, so our breakout spaces (our meeting rooms) may already be booked. We do our best to fit in last-minute bookings when we can.",
      },
      {
        q: 'Is there a shortest or longest booking?',
        a: "Events are booked by the hour, with a 3-hour minimum, or at a day rate. You can book over several days. We don't do half-day rates. Tell us what you need and we'll give you a price.",
      },
    ],
  },
  {
    title: 'Costs, deposits and cancelling',
    faqs: [
      {
        q: 'What is included in the room hire fee?',
        a: 'Room hire usually includes setting out the chairs and tables. It includes WiFi and basic screens and sound (projector, screens, microphones and so on). Tea and coffee are included all through your event.',
      },
      {
        q: 'Do you need a deposit, and what are the payment terms?',
        a: `Yes. ${larger.payment[0]} ${larger.payment[1]} ${larger.payment[2]} ${larger.paymentMethods}`,
      },
      {
        q: 'What is your cancellation policy?',
        a: `Events are larger bookings. ${larger.definition} ${larger.chargeable} ${larger.reschedule} ${exceptional} You can read the full booking and cancellation terms at ${site.url}/booking-terms/.`,
      },
    ],
  },
  {
    title: 'Room set-up and tech help',
    faqs: [
      {
        q: 'What AV is in the Auditorium?',
        a: 'The Auditorium has microphones, a projector and speakers. They suit talks and panels. Every Auditorium booking needs a technician from our team (£). That way, everything runs smoothly.',
      },
      {
        q: 'Do the breakout rooms have screens?',
        a: "Yes. Each breakout room has an LED flatscreen you can connect to wirelessly. Need more kit? Let us know and we'll do our best to help.",
      },
      {
        q: 'Do you give tech help on the day?',
        a: 'Yes. Our team helps you set up, runs the AV and fixes any problems.',
      },
    ],
  },
  {
    title: 'Food and drink',
    faqs: [
      {
        q: 'Is catering available on site?',
        a: `Tea and coffee are free all day. For meals or snacks, we work with a trusted local caterer, ${catering.partner}. They can make a menu to suit your event.`,
      },
      {
        q: 'Can we bring our own catering?',
        a: 'We mainly work with our local catering partner. That keeps the food and service the same high standard. Have a special request? Talk to us. Sometimes we can agree other plans with you first.',
      },
      {
        q: 'Do you cater for dietary needs and allergies?',
        a: "Yes. Our caterer has lots of options, including vegetarian, vegan, gluten-free and other special diets. We'll put you in touch with them.",
      },
    ],
  },
  {
    title: 'Access and getting here',
    faqs: [
      {
        q: 'What are your opening hours for events?',
        a: `We're usually open ${hours.summary.replace('Monday to Friday, ', 'from ')}. But we're flexible about setting up early and packing away late. Tell us your times and we'll do our best to fit them.`,
      },
      {
        q: 'Is there enough parking on site?',
        a: `Yes. We have ${parking.spaces} parking spaces on site, all free. Expecting lots of guests? We also have an overflow car park across the main road. A parking attendant will show your guests where to go.`,
      },
      {
        q: 'Is there disabled access?',
        a: `Yes, on the ground floor. There are ramps to the Auditorium and the ground-floor breakout rooms. ${accessibility.noLift} Tell us about any access needs before you come.`,
      },
      {
        q: 'Can we decorate the rooms or bring our own branding?',
        a: "Most of the time, yes. You're welcome to bring banners, signs and branded items. We just ask that decorations are safe and don't cause damage.",
      },
    ],
  },
  {
    title: 'On the day',
    faqs: [
      {
        q: 'Do you provide an event coordinator or support staff on the day?',
        a: "Our staff are on site. They can help with the basics and any questions about the building. We're here to help.",
      },
      {
        q: 'How early can we arrive to set up, and how late can we stay to clear away?',
        a: 'Time to set up and pack away is part of your booking. Need extra time? Tell us when you book. Extra hours cost extra.',
      },
      {
        q: 'What if we have last-minute changes or requests?',
        a: "We know plans can change. We'll do our best to fit in last-minute changes. Some requests depend on what's free, or may cost extra.",
      },
    ],
  },
  {
    title: 'Extra kit',
    faqs: [
      {
        q: 'Can we hire extra equipment, like microphones or flipcharts?',
        a: "Yes. We have extra kit, like flipcharts and microphones. Tell us what you need and we'll sort it out.",
      },
    ],
  },
  {
    title: 'Everything else',
    faqs: [
      {
        q: 'Can we host hybrid or virtual events?',
        a: "Our AV can do one-way livestreaming. It can't run a big meeting where people talk both in the room and online. Tell us well ahead, so we can get the right connection and tech in place.",
      },
      {
        q: 'Do you have WiFi?',
        a: "Yes. Fast 1Gb fibre WiFi runs all through the building. We'll give the details to you and your guests when you arrive.",
      },
      {
        q: 'Can we look round before we decide?',
        a: "Please do. Contact our team to arrange a look round. It's a great way to see the space and test the AV if you need to. You can talk through your event in person too.",
      },
      {
        q: 'What safety and emergency procedures do you have?',
        a: 'We follow all local safety rules. Fire exits are clearly marked. Our staff are trained to get everyone out safely. We do regular safety checks.',
      },
      {
        q: 'Are there any noise limits or curfews?',
        a: "We're fairly flexible with evening events. But we ask you to keep the sound down for our neighbours. We'll talk through any curfew or noise rules, mostly if your event runs late. Please note we don't take function bookings. We host business and community events only.",
      },
    ],
  },
];

const schema = [
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Event space hire', url: `${site.url}${parent}` },
    { name: 'Event FAQs', url },
  ]),
  faqNode(url, groups.flatMap((g) => g.faqs)),
];
---
<Base title={title} description={description} ogImage={images[181].src} ogImageAlt={images[181].alt} schema={schema}>
  <Breadcrumbs
    trail={[
      { name: 'Home', path: '/' },
      { name: 'Event space hire', path: parent },
      { name: 'Event FAQs', path },
    ]}
  />

  <section class="section faq-hero">
    <div class="container">
      <span class="eyebrow">Event FAQs</span>
      <h1>Event venue FAQs</h1>
      <p class="faq-hero__tagline">Everything organisers ask us, in one place.</p>
      <p class="faq-hero__lede">
        Every event is different. Can't find your question? Want to talk through your set-up, food or speakers? Call
        {' '}<a href={contact.phoneHref} data-track="phone_click">{contact.phone}</a> or email <a href={`mailto:${contact.email}`}>{contact.email}</a>.
      </p>
      <p><a class="btn btn--secondary" href={parent}>Back to events and conferences</a></p>
    </div>
  </section>

  <Faqs groups={groups} heading="Questions about hosting your event" />

  <CtaBand
    heading="Planning an event?"
    text="Tell us your date, your numbers and what the day involves. We'll help make it a success from start to finish."
  />
</Base>

<style>
  .faq-hero { padding-bottom: 24px; }
  .faq-hero .container { display: flex; flex-direction: column; gap: 14px; }
  .faq-hero .container > * { max-width: 820px; }
  .faq-hero__tagline { font: 700 var(--text-h3-size, 24px) / 1.3 var(--font-display); color: var(--moc-coral-text); }
  .faq-hero__lede { font-size: var(--text-lead-size); }
</style>
