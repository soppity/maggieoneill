---
// Virtual office hub. Spec: docs/reference/Website Blueprint.dc.html, page 8 (Template: Service).
// Copy kept close to virtual.mobtc.co.uk (docs/content/virtual-office-source.md).
import { guidePath, publishedGuides } from '../../../data/guides';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Hero from '../../../components/sections/Hero.astro';
import KeyFacts from '../../../components/sections/KeyFacts.astro';
import PlansCompare from '../../../components/sections/PlansCompare.astro';
import CallAnsweringBand from '../../../components/sections/CallAnsweringBand.astro';
import Steps from '../../../components/sections/Steps.astro';
import CaseCard from '../../../components/CaseCard.astro';
import { caseStudies } from '../../../data/caseStudies';
import Faqs from '../../../components/sections/Faqs.astro';
import VirtualOfficeForm from '../../../components/sections/VirtualOfficeForm.astro';
import OperatorLicenceNote from '../../../components/sections/OperatorLicenceNote.astro';
import Photo from '../../../components/Photo.astro';
import { address, formatPrice, hours, listNames, operatorLicence, reviews, rooms, site, virtualOffice, withCover } from '../../../data/facts';
import { images } from '../../../data/images';
import { breadcrumbNode, faqNode, serviceNode } from '../../../lib/schema';

const path = '/services/virtual-office/';
const url = `${site.url}${path}`;
const title = "Virtual Office Liverpool from £20 | Maggie O'Neill Centre";
const description =
  "A real business address near Liverpool from £20 a month, with real people behind it. Keep your home address off Companies House. Maggie O'Neill Centre.";

const [p20, p40] = virtualOffice.plans;
const dc = virtualOffice.directorsCover;
const ca = virtualOffice.callAnswering;
const pod = rooms.find((r) => r.slug === 'pod')!;

const intro = `A virtual office at the Maggie O'Neill Centre costs ${formatPrice(p20.price)} a month and includes a registered office address for Companies House and a business address you can use everywhere, at ${address.street}, Huyton, near Liverpool, ${address.postcode}. Post is handled in-house by our team and collected from reception, with free parking outside. The ${formatPrice(p40.price)} ${p40.name} plan adds post opened and scanned and 2 free meeting room hours a month, and Director's Cover adds a director's service address for ${formatPrice(dc.price)}. ${virtualOffice.terms}`;

const keyFacts = [
  { term: 'Address', detail: `${address.street}, Huyton, Liverpool, ${address.postcode}. A real building with people in it.` },
  { term: 'Prices', detail: `From ${formatPrice(p20.price)} a month for ${p20.name}, or ${formatPrice(p40.price)} for ${p40.name}.`, href: '#plans', linkText: 'Compare plans' },
  { term: "Director's Cover", detail: `+${formatPrice(dc.price)} a month on either plan. Your home off Companies House in both places.` },
  { term: 'Post', detail: `Handled in-house by our team at reception. Opened and scanned on the ${p40.name} plan.` },
  { term: 'Meeting rooms', detail: `In the same building. The ${p40.name} plan includes 2 free hours a month.` },
  { term: 'Contract', detail: virtualOffice.terms },
  { term: 'Collect post', detail: `${hours.summary}. Free parking outside.` },
  { term: 'Call answering', detail: `Add it for ${formatPrice(ca.price)} a month.`, href: '/services/virtual-office/call-answering/', linkText: 'How it works' },
];

const whoFor = [
  "New limited company directors who don't want their home on the public register",
  'Sole traders and freelancers working from home',
  'Online sellers who need a business address',
  'Property companies, contractors, charities and CICs',
  'Firms outside the region wanting a Liverpool presence',
  'Businesses anywhere in the UK who would rather their registered address supported a charity',
];

// Why people switch, from the current virtual office page.
const reasons = [
  'Anyone can find your home address online.',
  'A home address can make your business look like a hobby.',
  'Public addresses get spammed with junk and scams.',
  'Work mail gets mixed up with your personal post.',
  'Keep unhappy customers away from your front door.',
  'Coffee shops are loud. Get a real address with real meeting rooms.',
  "Some lenders and insurers don't like businesses run from home.",
  'If you move house, a business address stays the same.',
];

const faqs = [
  {
    q: 'How much is a virtual office in Liverpool?',
    a: `A virtual office at the Maggie O'Neill Centre costs from ${formatPrice(p20.price)} a month for a registered office and business address. The ${formatPrice(p40.price)} ${p40.name} plan adds post opened and scanned and 2 free meeting room hours a month. Director's Cover adds ${formatPrice(dc.price)} a month to either plan, taking it to ${formatPrice(withCover(p20))} or ${formatPrice(withCover(p40))}.`,
  },
  {
    q: 'What is the cheapest virtual office in Liverpool that includes a registered office?',
    a: `The ${p20.name} plan at the Maggie O'Neill Centre is ${formatPrice(p20.price)} a month and includes a registered office address for Companies House, a business address and post collected from reception. Lower headline prices elsewhere often cover a business address only, with the registered office, post handling or a setup fee charged on top, so compare what each price includes. Our guide to the cheapest virtual office address in the UK explains what to check.`,
  },
  {
    q: 'Can I use the address as my registered office with Companies House?',
    a: `Yes. Every virtual office plan at the Maggie O'Neill Centre includes a registered office address at ${address.oneLine}. You can also use it as your business address on your website, invoices and letters.`,
  },
  {
    q: 'How do I keep my home address off Companies House?',
    a: `Use the Maggie O'Neill Centre as your registered office and add Director's Cover, which gives you a director's service address too. New filings then show our address instead of your home. Older documents on the register may still show your home address, and Companies House explains how to apply to have it removed.`,
  },
  {
    q: "What is Director's Cover?",
    a: `Director's Cover is a ${formatPrice(dc.price)} a month add-on that gives you a director's service address at the Maggie O'Neill Centre. Your plan already replaces your home as your registered office, so with Director's Cover your home no longer needs to appear in either place on the public register.`,
  },
  {
    q: "If I upgrade my plan, do I keep Director's Cover?",
    a: `Yes. If you have ${p20.name} with Director's Cover at ${formatPrice(withCover(p20))} a month and move up to ${p40.name}, your cover moves with you and the price becomes ${formatPrice(withCover(p40))} a month.`,
  },
  {
    q: 'Who handles my post?',
    a: `The Maggie O'Neill Centre handles your post in-house. It isn't outsourced to another company: our team looks after virtual office post at reception.`,
  },
  {
    q: 'Can I collect my post?',
    a: `Yes. You can collect post from reception at the Maggie O'Neill Centre, ${hours.summary}, and parking is free while you do.`,
  },
  {
    q: 'Can I meet clients at my virtual office address?',
    a: `Yes. Meeting rooms are in the same building, from the ${pod.name} at ${formatPrice(pod.prices!.hour!)} an hour. The ${formatPrice(p40.price)} ${p40.name} plan includes 2 free meeting room hours a month.`,
  },
  {
    q: 'Do I need to be near Liverpool to use the virtual office?',
    a: `No. The Maggie O'Neill Centre has virtual office clients across the UK who chose a charity for their registered address, instead of an online service or a profit-making company. On the Virtual Office plan your post is opened and scanned, so you can read it wherever you are.`,
  },
  {
    q: 'Is there a contract?',
    a: `There's no lock-in. You can cancel a virtual office at the Maggie O'Neill Centre any time with one month's notice.`,
  },
  {
    q: 'How quickly can I start?',
    a: `You can be live as soon as your AML checks are done. Fill in the form, complete the secure AML form we send you, and you get your address and mailbox app.`,
  },
  {
    q: 'Why do you need to do an AML check?',
    a: `Anyone providing a registered office service has to carry out anti-money laundering (AML) checks on their clients by law. The Maggie O'Neill Centre sends you a secure form for this after you sign up.`,
  },
  {
    q: "Can I use a virtual office for a taxi or private hire operator's licence?",
    a: `Not in Knowsley. Some councils accept a virtual office address, but Knowsley Council requires the office number of a physical office with planning permission. For Knowsley operators, the Maggie O'Neill Centre has a dedicated package: a 12-month satellite office lease with planning permission, from £${operatorLicence.from} a month, with an exit clause if the council refuses your licence. See the Knowsley operator licence address page.`,
  },
  {
    q: 'Is it a real address or a PO box?',
    a: `It's a real building with people in it: the Maggie O'Neill Centre, ${address.street}, Huyton. Companies House doesn't accept a PO box as a registered office address.`,
  },
];

const schema = [
  serviceNode({
    url,
    name: 'Virtual office',
    serviceType: 'Virtual office and registered office address',
    description: intro,
    areaServed: ['United Kingdom', ...virtualOffice.areasServed],
    catalogName: 'Virtual office plans',
    offers: [
      ...virtualOffice.plans.map((p) => ({ name: p.name, price: p.price, description: p.summary })),
      { name: `${dc.name} (add-on)`, price: dc.price, description: dc.summary },
      { name: `${ca.name} (add-on)`, price: ca.price, description: ca.summary },
    ],
  }),
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Virtual office', url },
  ]),
  faqNode(url, faqs),
];

const voReviewCount = reviews.count;
---
<Base
  title={title}
  description={description}
  ogImage={images[29].src}
  ogImageAlt={images[29].alt}
  preloadImage={images[29].src}
  schema={schema}
  mobileBar="virtual-office"
>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Virtual office', path }]} />

  <Hero
    title="A business address, with real people handling your post."
    lede={`Keep your home address private and give your business a proper base in Liverpool. Our team takes in your post, lets you know when it arrives, and there's a meeting room down the corridor when you need one. From ${formatPrice(virtualOffice.from)} a month.`}
    image={29}
    primary={{ label: 'Get your address', href: '#get-your-address' }}
    secondary={{ label: 'See plans and prices', href: '#plans' }}
  >
    <ul class="price-chips" aria-label="Virtual office plans">
      {virtualOffice.plans.map((p, i) => (
        <li class:list={{ 'is-lead': i === 0 }}><strong>{formatPrice(p.price)}</strong> {p.name}</li>
      ))}
      <li class="is-addon"><strong>+{formatPrice(dc.price)}</strong> {dc.name}</li>
    </ul>
    <ul class="vo-proof">
      <li><a href="/reviews/">{voReviewCount} Google reviews</a></li>
      <li>Post handled in-house</li>
      <li>Free parking when you collect</li>
    </ul>
  </Hero>

  <KeyFacts heading="Your virtual office, in a few lines" intro={intro} facts={keyFacts} />
  <p class="container updated">Last updated: October 2026</p>

  <OperatorLicenceNote />

  <section class="section" aria-labelledby="who-heading">
    <div class="container two-col">
      <div>
        <div class="section-head">
          <span class="eyebrow">Who it's for</span>
          <h2 id="who-heading">Who uses a virtual office at Maggie's?</h2>
          <p>Directors, sole traders and small firms who want a proper business address without renting an office.</p>
        </div>
        <ul class="tick-list">
          {whoFor.map((w) => <li>{w}</li>)}
        </ul>
      </div>
      <div class="card reasons">
        <h3>Why people switch</h3>
        <p>Some switch for privacy. Others want a better business image: meeting rooms, organised post and a proper postcode.</p>
        <ul>
          {reasons.map((r) => <li>{r}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <PlansCompare />

  <CallAnsweringBand />

  <section class="section section--white" aria-labelledby="ro-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Registered office and Director's Cover</span>
        <h2 id="ro-heading">What's the difference between a registered office and a director's service address?</h2>
      </div>
      <div class="prose">
        <p>
          <strong>A registered office</strong> is your company's official address on the public register. Every plan includes one at the Maggie
          O'Neill Centre, and you can use it as your business address everywhere else too.
        </p>
        <p>
          <strong>A director's service address</strong> is where Companies House and others send letters for you as a director. If you used your
          home, it's on the public register. {dc.summary}
        </p>
        <p>
          Director's Cover costs {formatPrice(dc.price)} a month on top of either plan: {formatPrice(p20.price)} becomes {formatPrice(withCover(p20))}, and
          {' '}{formatPrice(p40.price)} becomes {formatPrice(withCover(p40))}. Move up from {p20.name} later and your cover comes with you.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="post-heading">
    <div class="container two-col two-col--media">
      <div class="post-media">
        <Photo n={137} width={560} height={700} sizes="(max-width: 900px) 100vw, 440px" />
      </div>
      <div>
        <div class="section-head">
          <span class="eyebrow">Your post</span>
          <h2 id="post-heading">What happens to my post?</h2>
          <p>Your post comes to real people at the Maggie O'Neill Centre, not a sorting office. It isn't outsourced to another company.</p>
        </div>
        <ul class="tick-list">
          <li>Our team looks after virtual office post at reception.</li>
          <li>On the {formatPrice(p40.price)} {p40.name} plan, your post is opened and scanned, so you can read it in your mailbox app wherever you are.</li>
          <li>On every plan, you can collect post from reception, {hours.summary}, with free parking outside.</li>
        </ul>
        <p class="post-review">
          Salome, who runs Salowal Ltd, says in her Google review that she's told when her post arrives, and her clients are greeted at reception.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="meet-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Meeting rooms</span>
        <h2 id="meet-heading">Can I meet clients at my virtual office address?</h2>
        <p>Yes. Meeting rooms are in the same building, so clients come to the address on your letterhead.</p>
      </div>
      <div class="prose">
        <p>
          The {pod.name}, a boardroom for {pod.capacity.boardroom}, costs {formatPrice(pod.prices!.hour!)} an hour. Larger rooms are there for team days
          and training. The {formatPrice(p40.price)} {p40.name} plan includes 2 free meeting room hours a month.
        </p>
        <p>Our hosts are on site, the tea is on, and parking is free.</p>
        <p><a href="/services/meeting-rooms/">Meet clients here: meeting room hire in Huyton</a></p>
        <p><a href="/services/private-offices/">Need a desk of your own? See private offices</a></p>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="areas-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Areas we serve</span>
        <h2 id="areas-heading">Which areas does the virtual office cover?</h2>
        <p>
          Businesses across Merseyside use our address in Huyton, near Liverpool: {listNames(virtualOffice.areasServed)}.
        </p>
      </div>
      <ul class="areas">
        {virtualOffice.areasServed.map((a) => <li>{a}</li>)}
        <li class="areas__uk">Across the UK</li>
      </ul>
      <p class="areas__national">{virtualOffice.national}</p>
      <div class="areas__case">
        <CaseCard study={caseStudies.find((c) => c.slug === 'libraries-connected')!} />
      </div>
    </div>
  </section>

  <Steps
    id="signup-heading"
    eyebrow="How sign-up works"
    heading="How do I get a virtual office address?"
    intro="Pick a plan and give us the basics. The AML check follows, and then your address is live."
    steps={virtualOffice.signUp}
  >
    <p class="steps-cta"><a class="btn btn--primary" href="#get-your-address">Get your address</a></p>
  </Steps>

  <section class="section section--white impact" aria-labelledby="impact-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Where your money goes</span>
        <h2 id="impact-heading">{site.closer}</h2>
      </div>
      <p class="prose">
        The Maggie O'Neill Centre is a registered charity (no. {site.charityNumber}). Profits from your virtual office fund Maggie's Meals, our social
        supermarket, and community support in Knowsley. Want to see it? Come for a tour any weekday.
      </p>
    </div>
  </section>

  {publishedGuides('virtual-office').length > 0 && (
    <section class="section" aria-labelledby="vo-guides-heading">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Guides</span>
          <h2 id="vo-guides-heading">Want the detail first?</h2>
          <p>Plain-English guides to business addresses and Companies House.</p>
        </div>
        <ul class="vo-guides">
          {publishedGuides('virtual-office').map((g) => (
            <li><a href={guidePath(g)}>{g.title}</a><span>{g.summary}</span></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Faqs faqs={faqs} heading="Virtual office questions" />

  <VirtualOfficeForm />
</Base>

<style>
  .price-chips { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .price-chips li {
    font-size: 14px; padding: 6px 12px; border-radius: var(--radius-pill); background: var(--moc-white);
    border: 1px solid var(--moc-border); color: var(--moc-ink);
  }
  .price-chips li strong { font-family: var(--font-display); color: var(--moc-purple-900); }
  .price-chips li.is-lead { border-color: var(--moc-coral-500); background: var(--moc-coral-tint); }
  .price-chips li.is-addon { border-style: dashed; border-color: var(--moc-purple-700); }
  .vo-proof { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: var(--text-small-size); font-weight: 600; color: var(--moc-purple-900); }
  .vo-proof li::before { content: '✓ '; color: var(--moc-coral-text); }
  .vo-proof a { color: inherit; }
  .updated { margin-top: -40px; margin-bottom: 0; font-size: var(--text-caption-size); color: var(--moc-slate-text); position: relative; }
  .two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .two-col--media { align-items: center; }
  .two-col .section-head { margin-bottom: 24px; }
  .reasons { padding: 32px; display: flex; flex-direction: column; gap: 12px; background: var(--moc-white); }
  .reasons p { color: var(--moc-slate-text); font-size: var(--text-small-size); }
  .reasons ul { margin: 6px 0 0; padding-left: 20px; display: grid; gap: 8px; }
  .prose { display: flex; flex-direction: column; gap: 16px; font-size: var(--text-body-size); }
  .post-media :global(img) { aspect-ratio: 4 / 5; border-radius: var(--radius-card); object-position: top; max-height: 620px; }
  .post-review { margin-top: 20px; padding: 18px 22px; border-left: 4px solid var(--moc-coral-500); background: var(--moc-white); border-radius: 0 var(--radius-tile) var(--radius-tile) 0; font-size: var(--text-small-size); }
  .areas { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px; }
  .areas li { padding: 10px 18px; border-radius: var(--radius-pill); background: var(--moc-purple-tint); color: var(--moc-purple-900); font-weight: 600; }
  .areas li.areas__uk { background: var(--moc-purple-700); color: var(--moc-white); }
  .areas__national { margin-top: 24px; max-width: 760px; font-size: var(--text-lead-size); }
  .steps-cta { margin-top: 32px; }
  .vo-guides { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: var(--grid-gap); }
  .vo-guides li { display: flex; flex-direction: column; gap: 8px; padding: 22px 24px; border-radius: var(--radius-card); background: var(--moc-white); }
  .vo-guides a { font: 700 19px/1.25 var(--font-display); }
  .vo-guides span { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; } .updated { margin-top: -24px; } }
  .areas__case { margin-top: 28px; max-width: 760px; }
</style>
