---
// For accountants (referral partners). Spec: Website Blueprint page 8b (Template: Service).
// Audience: accountants, bookkeepers and company formation agents in Merseyside. Job: turn them into a steady source of
// virtual office clients. Two ways in (owner, Oct 2026): the firm plan (the firm pays a flat fee plus a set price per
// client, tiered: facts.ts accountantPartners.firmPlan), or referral, where the client pays us and gets 20% off (no commission,
// because accountants must disclose it).
// PilotoMail screens: docs/assets/pilotomail/ (client names in the picker are anonymised: never show real ones).
// Schema: Service (audience: accountants) + FAQPage + BreadcrumbList.
import Base from '../../../../layouts/Base.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Hero from '../../../../components/sections/Hero.astro';
import Steps from '../../../../components/sections/Steps.astro';
import Faqs from '../../../../components/sections/Faqs.astro';
import VirtualOfficeForm from '../../../../components/sections/VirtualOfficeForm.astro';
import AccountantForm from '../../../../components/sections/AccountantForm.astro';
import { accountantPartners as ap, address, contact, formatPrice, hours, site, virtualOffice, withCover } from '../../../../data/facts';
import { images } from '../../../../data/images';
import { breadcrumbNode, faqNode, serviceNode } from '../../../../lib/schema';

const path = '/services/virtual-office/accountants/';
const url = `${site.url}${path}`;
const parent = '/services/virtual-office/';
// SEO: the title and meta use "registered office" (the common search; title kept to 60 characters); visible copy says "registered address" (owner, Oct 2026).
const title = "Registered Office for Accountants | Maggie O'Neill Centre";
const description =
  `Registered office addresses for all your clients near Liverpool, from £11 a client a month with Director's Cover. The more clients, the lower the price. One login for all their post.`;

const off = ap.discount;
const [p20, p40] = virtualOffice.plans;
const dc = virtualOffice.directorsCover;
const ca = virtualOffice.callAnswering;
// Owner, Oct 2026: 20% off both plans and Director's Cover; call answering gets 10% off.
const priceGrid = [
  { name: p20.name, price: p20.price, pct: off, kind: 'plan' },
  { name: p40.name, price: p40.price, pct: off, kind: 'plan' },
  { name: `${dc.name} add-on`, price: dc.price, pct: off, kind: 'addon' },
  { name: `${p20.name} + ${dc.name}`, price: withCover(p20), pct: off, kind: 'cover' },
  { name: `${p40.name} + ${dc.name}`, price: withCover(p40), pct: off, kind: 'cover' },
  { name: `${ca.name} add-on`, price: ca.price, pct: ap.callAnsweringDiscount, kind: 'addon', extra: `plus ${ca.perResponse} per AI response` },
];
const discounted = (n: number, pct = off) => Math.round(n * (100 - pct)) / 100;
const caOff = ap.callAnsweringDiscount;
const fmt = (n: number) => (Number.isInteger(n) ? formatPrice(n) : `£${n.toFixed(2)}`);
const fp = ap.firmPlan;
const fullPrice = withCover(p40);
const tierFor = (n: number) => fp.tiers.find((t) => n <= t.max)!;
const firmBill = (n: number) => tierFor(n).price * n;
const firstTier = fp.tiers[0];
const lowest = fp.tiers[fp.tiers.length - 1];
const firmExamples = fp.examples.map((n) => ({ n, bill: firmBill(n), each: firmBill(n) / n, usual: fullPrice * n }));

const lede = `Put all your clients' registered addresses with the Maggie O'Neill Centre. It's ${formatPrice(firstTier.price)} a client a month, dropping to ${formatPrice(lowest.price)} as you add more. Every client gets the full plan with ${dc.name}. You see all their post under one login. And every address helps a local charity.`;

const benefits = [
  {
    title: 'One login for every client',
    text: "Each client gets their own mailbox in PilotoMail. We add your email to it. Log in once, pick a client, and see their post. No more chasing a photo of a letter from HMRC.",
  },
  {
    title: `From ${formatPrice(lowest.price)} a client`,
    text: `${formatPrice(firstTier.price)} a client to start, dropping to ${formatPrice(lowest.price)} as you add more. Each client gets the full plan with ${dc.name}, which is usually ${formatPrice(fullPrice)} a month.`,
  },
  {
    title: 'No more registered-address admin',
    text: "Your clients' registered address is a real building with a team on site. We handle the post, keep it securely stored, scan it and put it in the app. So it stops being your problem.",
  },
  {
    title: 'Every referral does good',
    text: "We're a charity. What your clients pay helps fund Maggie's Meals and our community work in Knowsley.",
  },
];

const steps = [
  { title: 'Tell us you want to partner', text: "Fill in the partner form below, or call us. We'll have a quick chat and set up your firm." },
  { title: 'Add your clients', text: 'Send us your client list. Add as many as you like, and more whenever you want. We do the AML check on each one.' },
  { title: 'Your email goes on their mailbox', text: "We add your email to each client's PilotoMail mailbox, so all their post shows up under your one login." },
  { title: 'See their post in one place', text: 'Log in, choose the client, and read what has arrived. Your client sees their own post too.' },
];

const faqs = [
  {
    q: 'How much is the firm plan?',
    a: `It's tiered, so the more clients you add, the less each one costs. ${fp.tiers.map((t) => `${t.label}: ${formatPrice(t.price)} each a month`).join('. ')}. Every client is charged at the rate for your total. So 10 clients come to ${formatPrice(firmBill(10))} a month, and 25 clients come to ${formatPrice(firmBill(25))}. There's no VAT to add. The centre is a charity and isn't VAT registered. ${virtualOffice.terms}`,
  },
  {
    q: 'What does each client get?',
    a: `The full plan with ${dc.name}. That's a registered office and business address, a director's service address, and post opened and scanned. Free meeting room hours and coffee aren't included. If a client wants those, they can come to us direct as your referral, with ${off}% off.`,
  },
  {
    q: 'Who pays, and can I charge my clients?',
    a: `Your firm pays us one monthly bill. What you charge your clients is up to you. Some firms include it in their fees. Others charge it on.`,
  },
  {
    q: 'Who pays for forwarding and other post requests?',
    a: fp.costs,
  },
  {
    q: 'Is there a minimum number of clients?',
    a: 'No. Start with a few and add more whenever you like. The more clients you add, the lower the price for every one of them.',
  },
  {
    q: 'Do you pay accountants a referral fee?',
    a: `No. Accountants have to tell their clients about any commission. So we don't pay a referral fee. On the firm plan, your firm is our customer, so there's no commission at all. If a client wants the extras, like meeting rooms and coffee, refer them to us direct and they get ${off}% off.`,
  },
  {
    q: 'How long does the discount last?',
    a: `For referred clients, the ${off}% off lasts for as long as they stay with the Maggie O'Neill Centre. It isn't an introductory offer.`,
  },
  {
    q: 'If I refer clients instead, what do they pay?',
    a: `With ${off}% off, the ${p20.name} plan is ${fmt(discounted(p20.price))} a month, not ${formatPrice(p20.price)}. The ${p40.name} plan is ${fmt(discounted(p40.price))}, not ${formatPrice(p40.price)}. ${dc.name} is ${fmt(discounted(dc.price))} a month, not ${formatPrice(dc.price)}. So a plan with cover comes to ${fmt(discounted(withCover(p20)))}, not ${formatPrice(withCover(p20))}. Or ${fmt(discounted(withCover(p40)))}, not ${formatPrice(withCover(p40))}. ${ca.name} is ${caOff}% off, at ${fmt(discounted(ca.price, caOff))} a month, not ${formatPrice(ca.price)}. ${virtualOffice.terms}`,
  },
  {
    q: "How do I see my clients' post?",
    a: "Through PilotoMail. It's the mailbox app our virtual office clients use. We add your email to the mailbox of each of your clients. So you log in once and choose which client's post to see.",
  },
  {
    q: 'Do my clients still see their own post?',
    a: 'Yes. Each client keeps their own access to their mailbox. Your login sits alongside theirs.',
  },
  {
    q: 'Who does the AML checks?',
    a: "We do. By law, anyone who offers a registered address must check their clients. These are anti-money laundering (AML) checks. So we send each client a secure AML form after they sign up.",
  },
  {
    q: 'Can my clients use the address with Companies House?',
    a: `Yes. Every plan includes a registered address at ${address.oneLine}. Director's Cover adds a director's service address. Then their home comes off the register in both places.`,
  },
];

const schema = [
  serviceNode({
    url,
    name: 'Registered address partner for accountants',
    serviceType: 'Registered address service for accountants and their clients',
    description: lede,
    audience: ap.audience,
    areaServed: ['Liverpool', 'Merseyside', 'Knowsley'],
    catalogName: 'Registered address plans for accountants',
    offers: [
      ...fp.tiers.map((t) => ({ name: `Firm plan, ${t.label}`, price: t.price, description: `Per client, per month. Full plan with ${dc.name}, post opened and scanned. Meeting room hours and coffee not included.` })),
    ].concat(virtualOffice.plans.map((p) => ({
      name: `${p.name} (${off}% off for referred clients)`,
      price: discounted(p.price),
      description: p.summary,
    })).concat(
      { name: `${dc.name} add-on (${off}% off for referred clients)`, price: discounted(dc.price), description: dc.summary },
      { name: `${ca.name} add-on (${caOff}% off for referred clients)`, price: discounted(ca.price, caOff), description: ca.summary },
    )),
  }),
  breadcrumbNode(url, [
    { name: 'Home', url: `${site.url}/` },
    { name: 'Virtual office', url: `${site.url}${parent}` },
    { name: 'For accountants', url },
  ]),
  faqNode(url, faqs),
];
---
<Base
  title={title}
  description={description}
  ogImage={`${site.url}/images/pilotomail/mailbox-picker-hero.webp`}
  ogImageAlt="The PilotoMail 'Choose your mailbox' screen, listing example client companies"
  preloadImage="/images/pilotomail/mailbox-picker-hero.webp"
  schema={schema}
  mobileBar="virtual-office"
>
  <Breadcrumbs
    trail={[
      { name: 'Home', path: '/' },
      { name: 'Virtual office', path: parent },
      { name: 'For accountants', path },
    ]}
  />

  <Hero
    title="Your clients' post, handled. Your admin, gone."
    lede={`Put all your clients' registered addresses with us. From ${formatPrice(lowest.price)} a client a month, with ${dc.name} included. The more clients, the lower the price. You see all their post in one place. And every address helps a local charity.`}
    image={6}
    screen={{ src: '/images/pilotomail/mailbox-picker-hero.webp', width: 1400, height: 947, alt: "The PilotoMail 'Choose your mailbox' screen, listing example client companies under one accountant's login" }}
    primary={{ label: 'Become a partner', href: '#partner' }}
    secondary={{ label: `Call ${contact.phone}`, href: contact.phoneHref }}
  />

  <section class="section section--white" aria-labelledby="benefits-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Why partner with us</span>
        <h2 id="benefits-heading">What do you and your clients get?</h2>
      </div>
      <ul class="grid benefits">
        {benefits.map((b) => (
          <li class="card benefit">
            <h3>{b.title}</h3>
            <p>{b.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--cream" aria-labelledby="login-heading">
    <div class="container two-col two-col--media">
      <div>
        <div class="section-head">
          <span class="eyebrow">One login</span>
          <h2 id="login-heading">How do you see your clients' post?</h2>
          <p>
            Our virtual office clients use PilotoMail, a mailbox app. We add your email to the mailbox of each of your clients. So you
            log in once and choose whose post you want to see.
          </p>
        </div>
        <ul class="tick-list">
          <li>One login, however many clients you have with us.</li>
          <li>Pick a client from your list and read what has arrived.</li>
          <li>On the firm plan, we open and scan every client's post. So you can read it the same day.</li>
          <li>Your clients keep their own access too.</li>
        </ul>
      </div>
      <div class="screens">
        <figure class="screen">
          <img src="/images/pilotomail/login.webp" width="1400" height="745" loading="lazy" decoding="async" alt="The PilotoMail sign-in screen with the Maggie O'Neill Centre logo" />
          <figcaption>Sign in once with your email.</figcaption>
        </figure>
        <figure class="screen">
          <img src="/images/pilotomail/mailbox-picker.webp" width="1400" height="745" loading="lazy" decoding="async" alt="The PilotoMail 'Choose your mailbox' screen listing example client companies" />
          <figcaption>Choose the client whose post you want to see. (Example names.)</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <Steps
    id="how-heading"
    eyebrow="How it works"
    heading="How does it work?"
    intro="Four steps, and most of them are ours."
    steps={steps}
  />

  <section class="section section--cream firm" id="firm-plan" aria-labelledby="firm-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">The firm plan</span>
        <h2 id="firm-heading">What is in the firm plan, and what does it cost?</h2>
        <p>
          The more clients you add, the less each one costs. One bill, one login.
          {' '}{virtualOffice.vat} {virtualOffice.terms}
        </p>
      </div>
      <div class="firm__grid">
        <div class="card firm__price">
          <p class="firm__sum">From <strong>{formatPrice(lowest.price)}</strong> a client a month</p>
          <ul class="firm__tiers">
            {fp.tiers.map((t) => <li><span>{t.label}</span><strong>{formatPrice(t.price)} each</strong></li>)}
          </ul>
          <p class="firm__usual">Every client is charged at the rate for your total number of clients.</p>
          <p class="firm__usual">Each client gets the full plan with {dc.name}, usually <s>{formatPrice(fullPrice)}</s> a month.</p>
          <h3>Every client gets</h3>
          <ul class="tick-list">
            {fp.includes.map((i) => <li>{i}</li>)}
          </ul>
          <p class="firm__excl">{fp.excludes}</p>
        </div>
        <div class="firm__examples">
          <h3>What would my firm pay?</h3>
          <p>Reach the next band and every one of your clients drops to the lower price.</p>
          <table class="firm__table">
            <thead>
              <tr><th scope="col">Clients</th><th scope="col">Your bill</th><th scope="col">Per client</th><th scope="col">Usually</th></tr>
            </thead>
            <tbody>
              {firmExamples.map((e) => (
                <tr>
                  <th scope="row">{e.n}</th>
                  <td><strong>{formatPrice(e.bill)}</strong> a month</td>
                  <td>{fmt(e.each)}</td>
                  <td><s>£{e.usual.toLocaleString('en-GB')}</s></td>
                </tr>
              ))}
            </tbody>
          </table>
          <a class="btn btn--primary" href="#partner">Add your clients</a>
        </div>
      </div>
      <div class="firm__costs">
        <h3>Who pays for forwarding and other post requests?</h3>
        <p>{fp.costs}</p>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="commission-heading">
    <div class="container two-col">
      <div class="section-head">
        <span class="eyebrow">Want the extras?</span>
        <h2 id="commission-heading">What if a client wants meeting rooms and coffee too?</h2>
      </div>
      <div class="prose">
        <p>
          Then refer them to us direct. They sign up and pay us themselves, with {off}% off any plan for as long as they stay.
          They get everything a full-price client gets, like the free meeting room hours on the {p40.name} plan and coffee when they
          call in. You still see their post under your one login.
        </p>
        <p>
          We don't pay referral fees, because accountants have to tell their clients about any commission. So the saving goes
          straight to your client. There's nothing to declare, and your advice stays clean.
        </p>
      </div>
    </div>
  </section>


  <section class="section section--cream" aria-labelledby="discount-heading">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Partner prices</span>
        <h2 id="discount-heading">If you refer clients, what do they pay?</h2>
        <p>{off}% off every plan and {dc.name}. {ap.callAnsweringDiscount}% off {ca.name.toLowerCase()}. It lasts for as long as they stay. {virtualOffice.terms}</p>
      </div>
      <ul class="grid prices">
        {priceGrid.map((r) => (
          <li class:list={['card', 'price', `price--${r.kind}`]}>
            <span class="price__off">{r.pct}% off</span>
            <h3>{r.name}</h3>
            <p class="price__now"><strong>{fmt(discounted(r.price, r.pct))}</strong> a month</p>
            <p class="price__was">Usually <s>{formatPrice(r.price)}</s>{r.extra && `, ${r.extra}`}</p>
          </li>
        ))}
      </ul>
      <p class="prices__note">
        Our own team handles the post and keeps it securely stored. Clients can collect it from reception, {hours.summary}. We also run the AML checks the law
        asks for with a registered address. So that's off your plate too.
      </p>
    </div>
  </section>

  <AccountantForm />

  <Faqs faqs={faqs} heading="Questions from accountants" />

  <VirtualOfficeForm
    heading="Referring a client?"
    intro={`Your client can fill this in themselves. Ask them to put your name or practice in the form. Then we can give them ${off}% off and add your email to their mailbox. On the firm plan, use the partner form above instead.`}
  />

  <section class="section section--white more-links" aria-label="Related pages">
    <div class="container">
      <p>
        See our <a href={parent}>virtual office in Liverpool</a>,
        {' '}<a href="/services/virtual-office/call-answering/">call answering</a>, or
        {' '}<a href="/blog/home-address-companies-house/">how to get your home address off Companies House</a>.
      </p>
    </div>
  </section>
</Base>

<style>
  .benefits { grid-template-columns: repeat(4, minmax(0, 1fr)); list-style: none; padding: 0; margin: 0; }
  .benefit { padding: 28px; display: flex; flex-direction: column; gap: 10px; }
  .benefit p { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  .two-col { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .two-col--media { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .two-col .section-head { margin-bottom: 24px; }
  .prose { display: flex; flex-direction: column; gap: 16px; font-size: var(--text-lead-size); }
  .screens { display: flex; flex-direction: column; gap: 24px; }
  .screen { margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .screen img { width: 100%; height: auto; border-radius: var(--radius-card); box-shadow: var(--moc-shadow-card); }
  .screen figcaption { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  .firm__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 48px); align-items: start; }
  .firm__price { padding: 32px; display: flex; flex-direction: column; gap: 12px; border-top: 4px solid var(--moc-coral-500); }
  .firm__sum { color: var(--moc-slate-text); }
  .firm__sum strong { font: 800 48px/1 var(--font-display); color: var(--moc-purple-900); letter-spacing: -0.02em; margin-right: 6px; }
  .firm__tiers { list-style: none; margin: 4px 0; padding: 0; display: grid; gap: 0; }
  .firm__tiers li { display: flex; justify-content: space-between; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--moc-border); }
  .firm__tiers strong { color: var(--moc-purple-900); }
  .firm__usual, .firm__excl { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  .firm__price h3 { margin-top: 8px; font-size: 19px; }
  .firm__costs { margin-top: clamp(24px, 4vw, 40px); padding: 24px 28px; background: var(--moc-white); border-left: 4px solid var(--moc-purple-700); border-radius: 0 var(--radius-tile) var(--radius-tile) 0; max-width: 900px; display: flex; flex-direction: column; gap: 8px; }
  .firm__costs h3 { font-size: 19px; }
  .firm__examples { display: flex; flex-direction: column; gap: 14px; align-items: flex-start; }
  .firm__table { width: 100%; border-collapse: collapse; background: var(--moc-white); border-radius: var(--radius-card); overflow: hidden; box-shadow: var(--moc-shadow-card); font-size: 17px; }
  .firm__table th, .firm__table td { padding: 14px 16px; text-align: left; border-bottom: 1px solid var(--moc-border); }
  .firm__table tbody tr:last-child > * { border-bottom: 0; }
  .firm__table thead th { font: 700 15px/1.2 var(--font-display); color: var(--moc-purple-900); background: var(--moc-purple-tint); }
  .firm__table tbody th { font: 800 20px/1 var(--font-display); color: var(--moc-purple-900); }
  .firm__table td s { color: var(--moc-slate-text); }
  @media (max-width: 900px) { .firm__grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .firm__table th, .firm__table td { padding: 12px 10px; font-size: 15px; } }
  .prices { grid-template-columns: repeat(3, minmax(0, 1fr)); list-style: none; padding: 0; margin: 0; }
  .price { padding: 26px 24px; display: flex; flex-direction: column; gap: 8px; border-top: 4px solid var(--moc-coral-500); }
  .price--cover { border-top-color: var(--moc-purple-700); }
  .price--addon { border-top-color: var(--moc-slate-2); }
  .price__off { align-self: flex-start; font-size: 12px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; background: var(--moc-coral-tint); color: var(--moc-coral-text); padding: 4px 10px; border-radius: var(--radius-pill); }
  .price h3 { font-size: 19px; }
  .price__now strong { font: 800 44px/1 var(--font-display); color: var(--moc-purple-900); letter-spacing: -0.02em; }
  .price__now { color: var(--moc-slate-text); }
  .price__was { font-size: var(--text-small-size); color: var(--moc-slate-text); }
  .prices__note { margin-top: 28px; max-width: 900px; }
  @media (max-width: 900px) { .prices { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .prices { grid-template-columns: 1fr; } }
  @media (max-width: 1000px) { .benefits { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 900px) { .two-col, .two-col--media { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .benefits { grid-template-columns: 1fr; } }
</style>
