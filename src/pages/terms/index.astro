---
// Terms and conditions: general sections, then the Knowsley Operator Licence service section (src/data/legal.ts).
// General sections drafted Oct 2026 from the site's facts; owner to review before launch.
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import LegalDoc from '../../components/LegalDoc.astro';
import { site } from '../../data/facts';
import { images } from '../../data/images';
import { legalUpdated, termsGeneral, termsOperator } from '../../data/legal';
import { breadcrumbNode } from '../../lib/schema';

const path = '/terms/';
const url = `${site.url}${path}`;
const title = "Terms and Conditions | Maggie O'Neill Centre";
const description = "Terms for services from the Maggie O'Neill Centre in Huyton, including the Knowsley Private Hire Operator satellite office lease.";
const schema = [breadcrumbNode(url, [{ name: 'Home', url: `${site.url}/` }, { name: 'Terms', url }])];
---
<Base title={title} description={description} ogImage={images[6].src} ogImageAlt={images[6].alt} schema={schema}>
  <Breadcrumbs trail={[{ name: 'Home', path: '/' }, { name: 'Terms', path }]} />
  <section class="section section--white">
    <div class="container legal">
      <h1>Terms and conditions</h1>
      <p class="legal__updated">Last updated: {legalUpdated}</p>
      <LegalDoc heading="The Maggie O'Neill Centre" sections={termsGeneral} links={{ 'Room hire': { label: 'Read our booking and cancellation terms', href: '/booking-terms/' } }} questions={false} />
      <LegalDoc heading="Knowsley Operator Licence service" sections={termsOperator} />
    </div>
  </section>
</Base>

<style>
  .legal { max-width: 820px; display: flex; flex-direction: column; gap: 16px; }
  .legal h1 { font-size: clamp(34px, 4.6vw, 52px); }
  .legal__updated { color: var(--moc-slate-text); font-weight: 600; margin-bottom: 12px; }
</style>
