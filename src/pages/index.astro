---
// Homepage. Spec: docs/reference/Website Blueprint.dc.html, page 1 (Template: Home).
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import ProofStrip from '../components/sections/ProofStrip.astro';
import KeyFacts from '../components/sections/KeyFacts.astro';
import ClientLogos from '../components/sections/ClientLogos.astro';
import WhoBooks from '../components/sections/WhoBooks.astro';
import VirtualOfficeBand from '../components/sections/VirtualOfficeBand.astro';
import RoomsServices from '../components/sections/RoomsServices.astro';
import Layouts from '../components/sections/Layouts.astro';
import HostedDay from '../components/sections/HostedDay.astro';
import Comparison from '../components/sections/Comparison.astro';
import Reviews from '../components/sections/Reviews.astro';
import Hosts from '../components/sections/Hosts.astro';
import Faqs from '../components/sections/Faqs.astro';
import MealsBand from '../components/sections/MealsBand.astro';
import FindUs from '../components/sections/FindUs.astro';
import { accessibility, accessibilityFaq, address, contact, formatPrice, hours, layoutTriage, listNames, parking, rateGroups, rooms, site, trainingDayFrom, virtualOffice } from '../data/facts';
import { images } from '../data/images';
import { faqNode } from '../lib/schema';
import { storySummary } from '../data/story';

const title = "Training & Meeting Rooms, Huyton | Maggie O'Neill Centre";
const description =
  "Maggie O'Neill Centre: hosted training and meeting rooms in Huyton, L36 8HT. Hosts on site and the room ready before you arrive. Free parking.";

const pod = rooms.find((r) => r.slug === 'pod')!;
const auditorium = rooms.find((r) => r.slug === 'auditorium')!;
const [voLow, vo40] = virtualOffice.plans;

const the = (names: string[]) => listNames(names.map((n) => `the ${n}`));
const rateLines = rateGroups(['pod']).map(
  (g) => `${the(g.rooms.map((r) => r.name))} cost ${formatPrice(g.hour)} an hour or ${formatPrice(g.day)} a day`,
);
const hourFromLines = rooms
  .filter((r) => r.prices?.hourFrom)
  .map((r) => `the ${r.name} from ${formatPrice(r.prices!.hourFrom!)} an hour`);
const cap = (t: string) => t.charAt(0).toUpperCase() + t.slice(1);

const intro = `The Maggie O'Neill Centre is a charity-run hosted venue at ${address.street}, Huyton, near Liverpool. Care providers, NHS teams, Knowsley Council, schools and fostering and adoption teams hire our training and meeting rooms. Hosts are on site all day, tea and coffee are included and parking is free.`;

const voIntro = `We're also a virtual office provider. A virtual office gives your business a real address in Huyton to use as your registered office and on your website, so your home address stays private and off Companies House. Our team looks after your post, plans start at ${formatPrice(virtualOffice.from)} a month, and there's no lock-in. Businesses across the UK choose us because we're a charity: every month's fee helps fund Maggie's Meals.`;

const keyFacts = [
  { term: 'Where', detail: `${address.street}, Huyton, ${address.postcode}. Near Liverpool, ${parking.motorway}.` },
  { term: 'Rooms', detail: `Training, meeting and event rooms, from the ${pod.name}, a boardroom for ${pod.capacity.boardroom}, to the ${auditorium.name} for up to ${auditorium.capacity.cabaret} cabaret.` },
  { term: 'Included', detail: 'On-site hosts, the room set to your layout, a screen with Mac and PC wireless casting and HDMI, 1Gb fibre WiFi, and tea and coffee all day.' },
  { term: 'Prices', detail: `Training rooms from ${formatPrice(trainingDayFrom)} a day, everything included. ${hourFromLines.map(cap).join('. ')}.`, href: '/whats-included/', linkText: "See what's included" },
  { term: 'Parking', detail: `Free ${parking.spaces}-space car park on site, on a main bus route.` },
  { term: 'Access', detail: accessibility.accessLine },
  { term: 'Hours', detail: `${hours.summary}. ${hours.extra}` },
  { term: 'Virtual office', detail: `From ${formatPrice(virtualOffice.from)} a month for a registered office address.`, href: '/services/virtual-office/', linkText: 'Plans and prices' },
];

// Visible FAQs and FAQPage schema share this list, so they always match word for word.
const faqs = [
  {
    q: "What is the Maggie O'Neill Centre?",
    a: `The Maggie O'Neill Centre is a charity-run training, meeting and event venue at ${address.oneLine}. The Maggie O'Neill Centre also provides virtual offices from ${formatPrice(virtualOffice.from)} a month.`,
  },
  {
    q: "Is parking free at the Maggie O'Neill Centre?",
    a: `Yes. The Maggie O'Neill Centre has a free ${parking.spaces}-space car park on site, ${parking.motorway}, and it is on a main bus route.`,
  },
  {
    q: "What's included when you hire a room at the Maggie O'Neill Centre?",
    a: 'Every room booking includes on-site hosts, the room set to your layout, a screen with Mac and PC wireless casting and HDMI, 1Gb fibre WiFi, a flipchart, free parking, and tea and coffee in the room all day.',
  },
  {
    q: 'How much does it cost to hire a room?',
    a: `Training rooms at the Maggie O'Neill Centre start at ${formatPrice(trainingDayFrom)} a day, with your host, tea and coffee, the screen and parking included. ${rateLines.map(cap).join('. ')}. ${hourFromLines.map((l) => cap(l.replace(' from ', ' costs from '))).join('. ')}. Call ${contact.phone} for an event quote.`,
  },
  {
    q: 'Which room layout should I choose?',
    a: `You don't need to choose a layout yourself. ${layoutTriage.replace("we'll", "your host at the Maggie O'Neill Centre will")}`,
  },
  {
    q: "Is the Maggie O'Neill Centre accessible?",
    a: accessibilityFaq,
  },
  {
    q: "What are the Maggie O'Neill Centre's opening hours?",
    a: `The Maggie O'Neill Centre is open ${hours.summary}. ${hours.extra}`,
  },
  {
    q: "Is the Maggie O'Neill Centre a charity?",
    a: `Yes. The Maggie O'Neill Centre is a registered charity in England and Wales, number ${site.charityNumber}. Every booking funds Maggie's Meals and community support in Knowsley.`,
  },
  {
    q: 'How much is a virtual office in Liverpool?',
    a: `Virtual office plans at the Maggie O'Neill Centre start at ${formatPrice(voLow.price)} a month for a registered office address. The ${formatPrice(vo40.price)} ${vo40.name} plan adds post opened and scanned and 2 free meeting room hours a month. Director's Cover adds ${formatPrice(virtualOffice.directorsCover.price)} a month to either plan and keeps your home off Companies House.`,
  },
  {
    q: 'Who was Maggie O\'Neill?',
    a: storySummary,
  },
  {
    q: "Is the Maggie O'Neill Centre the same as MOBTC?",
    a: `Yes. MOBTC is short for the centre's old name, the Maggie O'Neill Business and Training Centre. It is the same building at ${address.street}, Huyton.`,
  },
];

const url = `${site.url}/`;
const reviews = [
  { quote: 'Someone waiting at the front door to greet you and point you in the right direction.', name: 'Chloe' },
  { quote: 'Patrick went above and beyond to make sure everything was perfect.', name: 'Jane Turner' },
  { quote: 'From booking to the event as easy as possible.', name: 'Anita Johnson' },
];
---
<Base
  title={title}
  description={description}
  ogImage={images[105].src}
  ogImageAlt={images[105].alt}
  preloadImage={images[105].src}
  schema={[faqNode(url, faqs)]}
>
  <Hero
    title={site.brandLine}
    lede={`Training and meeting rooms in Huyton, near Liverpool, where your hosts are on site, the room is ready and the kettle is on. Every booking helps fund Maggie's Meals in Knowsley.`}
    image={105}
    secondary={{ label: 'Book a visit', href: '#enquire' }}
  >
    <ProofStrip />
    {/* Owner, Oct 2026: lead with the registered address specialism, not "we do virtual offices too". */}
    <a class="hero-vo" href="/services/virtual-office/">
      <span class="hero-vo__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
      </span>
      <span class="hero-vo__text"><strong>Knowsley's registered address specialists</strong><span>We specialise in registered addresses and virtual offices, from {formatPrice(virtualOffice.from)} a month <span aria-hidden="true">→</span></span></span>
    </a>
  </Hero>

  <ClientLogos />

  <KeyFacts heading="Who we are, in a few lines" intro={intro} more={[voIntro]} facts={keyFacts} />

  <WhoBooks />

  <VirtualOfficeBand />

  <RoomsServices />

  <Layouts />

  <HostedDay />

  <Comparison />

  <Reviews reviews={reviews} />

  <Hosts />

  <Faqs faqs={faqs} heading="What do people ask before they book?" />

  <MealsBand />

  <FindUs />
</Base>


<style>
  .hero-vo { margin-top: 24px; display: inline-flex; align-items: center; gap: 14px; padding: 14px 24px 14px 14px; border-radius: 20px; background: var(--moc-white); border: 2px solid var(--moc-purple-700); color: var(--moc-purple-900); font-size: clamp(17px, 1.6vw, 20px); text-decoration: none; box-shadow: var(--moc-shadow-card-hover); transition: background var(--duration-base, 200ms) ease, color var(--duration-base, 200ms) ease; }
  .hero-vo__text { display: grid; gap: 2px; line-height: 1.3; }
  .hero-vo strong { font-weight: 800; }
  .hero-vo__text > span { font-size: 0.85em; }
  .hero-vo:hover { background: var(--moc-purple-700); color: var(--moc-white); }
  .hero-vo__icon { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--moc-purple-tint); color: var(--moc-purple-700); }
</style>
