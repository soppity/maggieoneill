---
// Thank-you page for the "operator-lease-details" form. noindex, not in the sitemap (see components/ThankYou.astro).
import Base from '../../../layouts/Base.astro';
import ThankYou from '../../../components/ThankYou.astro';
import { contact } from '../../../data/facts';
import { images } from '../../../data/images';
---
<Base title={"Thank You | Knowsley Operator Licence | Maggie O'Neill Centre"} description="Thanks for getting in touch with the Maggie O'Neill Centre." ogImage={images[6].src} ogImageAlt={images[6].alt} noindex mobileBar="custom" mobileBarHref={contact.phoneHref} mobileBarLabel={`Call ${contact.phone}`}>
  <ThankYou
    form={'operator-lease-details'}
    heading={"Thanks, we've got your lease details."}
    text={"We'll be in touch within one working day. We'll set up your direct debit and send your lease to sign."}
    next={[]}
    links={[
    { label: 'Back to the operator licence page', href: '/operators-licence/' }
    ]}
    showWhatsApp={false}
  />
</Base>
