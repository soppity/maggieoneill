---
// Thank-you page for the "Website Enquiry" form. noindex, not in the sitemap (see components/ThankYou.astro).
import Base from '../../layouts/Base.astro';
import ThankYou from '../../components/ThankYou.astro';
import { booking } from '../../data/facts';
import { images } from '../../data/images';
---
<Base title={"Thank You | Maggie O'Neill Centre"} description="Thanks for getting in touch with the Maggie O'Neill Centre." ogImage={images[6].src} ogImageAlt={images[6].alt} noindex>
  <ThankYou
    form={'Website Enquiry'}
    heading={'Thanks, your message is with us.'}
    text={"A real person will reply the same working day, Monday to Friday. If you asked about dates, we'll check the rooms and come back with what's free."}
    next={[]}
    links={[
    { label: 'Check availability now', href: booking.url },
    { label: 'Plan your visit', href: '/visit/' }
    ]}
    showWhatsApp={true}
  />
</Base>
