---
// Thank-you page for the "Virtual Office Page - Form" form. noindex, not in the sitemap (see components/ThankYou.astro).
import Base from '../../../layouts/Base.astro';
import ThankYou from '../../../components/ThankYou.astro';
import { virtualOffice } from '../../../data/facts';
import { images } from '../../../data/images';
---
<Base title={"Thank You | Virtual Office | Maggie O'Neill Centre"} description="Thanks for getting in touch with the Maggie O'Neill Centre." ogImage={images[6].src} ogImageAlt={images[6].alt} noindex>
  <ThankYou
    form={'Virtual Office Page - Form'}
    heading={"Thanks, we've got your details."}
    text={"We'll reply the same working day with the next steps for your virtual office."}
    next={virtualOffice.signUp.slice(1)}
    links={[
    { label: 'Back to virtual office plans', href: '/services/virtual-office/' }
    ]}
    showWhatsApp={true}
  />
</Base>
