---
// Thank-you page for the "exit-page-optin" form. noindex, not in the sitemap (see components/ThankYou.astro).
import Base from '../../../layouts/Base.astro';
import ThankYou from '../../../components/ThankYou.astro';
import { contact } from '../../../data/facts';
import { images } from '../../../data/images';
---
<Base title={"Thank You | Maggie O'Neill Centre"} description="Thanks for getting in touch with the Maggie O'Neill Centre." ogImage={images[6].src} ogImageAlt={images[6].alt} noindex mobileBar="custom" mobileBarHref={contact.phoneHref} mobileBarLabel={`Call ${contact.phone}`}>
  <ThankYou
    form={'exit-page-optin'}
    heading={"Thanks, you're on the list."}
    text={"We'll only be in touch if there's a genuine fit: meeting rooms, training spaces or business addresses. No spam."}
    next={[]}
    links={[
    { label: 'Browse our main services', href: '/' }
    ]}
    showWhatsApp={false}
  />
</Base>
